# ==============================================================================
# KRONEER UPLOADS DIRECTORY SECURITY (.htaccess)
# Prevent script execution and limit uploads to safe media types
# ==============================================================================

# 1. Ndalo ekzekutimin e skripteve
Options -ExecCGI -Indexes
SetHandler default-handler

# Fik motorin PHP nëse përdoret Apache me mod_php
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# 2. Lejo VETËM skedarët e sigurt të mediave dhe dokumenteve
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|jsp|asp|aspx|sh|bash|exe|bat|cmd|dll|bin|vbs|hta|jar|war)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Forco shkarkimin e sigurt dhe blloko sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</IfModule>
