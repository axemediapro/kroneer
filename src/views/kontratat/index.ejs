<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">KONTRATAT ZYRTARE</h1>
    <p class="text-xs text-slate-400 mt-1">Kontratat e shitjes, montimit dhe mirëmbajtjes së lifteve KRONEER</p>
  </div>
  <a href="/kontratat/krijo" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    <span>Krijo Kontratë të Re</span>
  </a>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/kontratat" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me numër kontrate, klient..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
    </div>
    <div>
      <select name="status" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha statuset</option>
        <option value="Aktive" <%= filters.status === 'Aktive' ? 'selected' : '' %>>Aktive</option>
        <option value="E Nënshkruar" <%= filters.status === 'E Nënshkruar' ? 'selected' : '' %>>E Nënshkruar</option>
        <option value="E Përfunduar" <%= filters.status === 'E Përfunduar' ? 'selected' : '' %>>E Përfunduar</option>
        <option value="Anuluar" <%= filters.status === 'Anuluar' ? 'selected' : '' %>>Anuluar</option>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.status) { %>
        <a href="/kontratat" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Kontratave -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Numri i Kontratës</th>
          <th class="p-4">Klienti</th>
          <th class="p-4">Modeli i Liftit</th>
          <th class="p-4">Vlera Totale</th>
          <th class="p-4">Afati i Dorëzimit</th>
          <th class="p-4">Garancia</th>
          <th class="p-4">Statusi</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (contracts && contracts.length > 0) { %>
          <% contracts.forEach(c => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4">
                <a href="/kontratat/<%= c.id %>" class="font-mono font-bold text-amber-400 hover:text-amber-300 block text-sm">
                  <%= c.number %>
                </a>
                <span class="text-[10px] text-slate-500"><%= c.quotation ? ('Nga ' + c.quotation.number) : 'Direkte' %></span>
              </td>
              <td class="p-4">
                <a href="/klientet/<%= c.customer.id %>" class="font-bold text-slate-200 hover:text-amber-400 block">
                  <%= c.customer.companyName || `${c.customer.firstName || ''} ${c.customer.lastName || ''}` %>
                </a>
                <span class="text-[10px] text-slate-500"><%= c.customer.city || 'Kosovë' %></span>
              </td>
              <td class="p-4 text-slate-300">
                <%= c.elevator ? c.elevator.model : 'Sisteme Lifti KRONEER' %>
              </td>
              <td class="p-4 font-mono font-bold text-slate-100 text-sm">
                <%= formatCurrency(c.value) %>
              </td>
              <td class="p-4 font-mono text-slate-300">
                <%= formatDate(c.deliveryDate) %>
              </td>
              <td class="p-4 font-bold text-emerald-400 font-mono">
                <%= c.warrantyMonths %> Muaj
              </td>
              <td class="p-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                  <%= c.status %>
                </span>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick='openQuickView(<%- JSON.stringify({
                    title: `Kontrata ${c.number}`,
                    subtitle: c.customer.companyName || `${c.customer.firstName || ""} ${c.customer.lastName || ""}`,
                    statusLabel: c.status,
                    statusClass: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30",
                    rows: [
                      { label: "Modeli i Liftit", value: c.elevator ? c.elevator.model : "Sisteme Lifti KRONEER" },
                      { label: "Vlera Totale", value: formatCurrency(c.value) },
                      { label: "Afati i Dorëzimit", value: formatDate(c.deliveryDate) },
                      { label: "Garancia", value: `${c.warrantyMonths} Muaj` }
                    ],
                    viewUrl: `/kontratat/${c.id}`,
                    editUrl: `/kontratat/${c.id}/ndrysho`,
                    printUrl: `/kontratat/${c.id}/print`
                  }).replace(/</g, '\\u003c').replace(/'/g, '&#39;') %>)' class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 border border-slate-700 transition-colors" title="Pamje e Shpejtë">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                  </button>
                  <a href="/kontratat/<%= c.id %>/ndrysho" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 border border-slate-700 transition-colors" title="Ndrysho Tekstet e Kontratës">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </a>
                  <form action="/kontratat/<%= c.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini kontratën <%= c.number %>?');">
                    <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-500/40 transition-colors" title="Fshi Kontratën">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </form>
                  <a href="/kontratat/<%= c.id %>/print" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 transition-colors" title="Printo Kontratën">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="p-8 text-center text-slate-500">Nuk u gjet asnjë kontratë.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
