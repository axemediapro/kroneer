<%
  const clientName = contract.customer.companyName || `${contract.customer.firstName || ''} ${contract.customer.lastName || ''}`.trim() || 'Klienti';
  const elevName = contract.elevator ? contract.elevator.model : (contract.quotation && contract.quotation.items && contract.quotation.items[0] ? contract.quotation.items[0].name : 'Sisteme Lifti KRONEER');
  const bldName = contract.customer.buildingName || 'Objekti i Porositësit';
  const cAddress = contract.customer.address || '-';
  const cCity = contract.customer.city || 'Kosovë';
  const cTax = contract.customer.taxNumber || contract.customer.businessNumber || '-';
  const compName = company.companyName || 'KRONEER';
  const compAddr = company.address || 'Prishtinë';
  const compCity = company.country ? `${company.city}, ${company.country}` : (company.city || 'Kosovë');
  const compTax = company.taxNumber || '330123456';
  
  const defaultPreamble = `Kjo Kontratë lidhet ndërmjet ${compName} me seli në ${compAddr}, ${compCity}, NUI: ${compTax} (në vijim: "Shitësi / Kryesi i Punëve"), dhe ${clientName} me seli në ${cAddress}, ${cCity}, NUI: ${cTax} (në vijim: "Blerësi / Porositësi").`;
  const defaultArt1 = `Shitësi merr përsipër furnizimin me pajisje, transportin, montimin profesional, testimin dinamik dhe dorëzimin e plotë funksional të sistemit të liftit: ${elevName} për objektin "${bldName}".`;
  const defaultArt2 = `Vlera totale e dakorduar kontraktuale është ${contract.value.toLocaleString('de-DE', {minimumFractionDigits: 2})} € (përfshirë TVSH 18%). Kushtet e pagesës janë: ${contract.paymentTerms || '30% Parapagim, 40% Para Instalimit, 20% Gjatë Instalimit, 10% Pas Dorëzimit'}.`;
  const dDate = contract.deliveryDate ? new Date(contract.deliveryDate).toLocaleDateString('de-DE') : 'Sipas marrëveshjes';
  const iDate = contract.installationDate ? new Date(contract.installationDate).toLocaleDateString('de-DE') : 'Sipas marrëveshjes';
  const defaultArt3 = `Afati i dorëzimit të pajisjeve në kantier është deri më ${dDate}. Përfundimi i montimit dhe testimit parashikohet më ${iDate}. Periudha e Garancisë Inxhinierike është ${contract.warrantyMonths || 24} Muaj nga dita e nënshkrimit të Procesverbalit të Dorëzimit Teknik.`;
  const defaultArt4 = contract.maintenanceTerms || `Mirëmbajtje falas gjatë periudhës së garancisë sipas standardit evropian EN 13015 me shërbim emergjence 24/7 dhe kontrolle periodike mujore.`;
  const defaultArt5 = `1. Shitësi obligohet të zbatojë me përpikmëri standardet evropiane të sigurisë EN 81-20 dhe EN 81-50 gjatë të gjitha fazave të punimeve.\n2. Porositësi obligohet të sigurojë hapësirën e pastër të pusit të liftit sipas specifikimeve teknike, furnizim të pandërprerë me energji elektrike 380V/50Hz në vendndodhjen teknike, dhe qasje të papenguar për ekipin montues.`;
  const defaultArt6 = `Çdo ndryshim apo plotësim i kësaj kontrate do të jetë i vlefshëm vetëm me shkrim me pëlqimin e të dyja palëve. Mosmarrëveshjet eventuale do të zgjidhen me mirëkuptim, ose në mungesë marrëveshjeje nga Gjykata kompetente në Prishtinë.`;
  const defaultClosing = `Kjo kontratë hartohet dhe nënshkruhet në 2 (dy) kopje origjinale me fuqi të barabartë juridike, nga 1 (një) për secilën palë kontraktuese.`;
%>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono"><%= contract.number %></h1>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
        <%= contract.status %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Klienti: <strong class="text-slate-200"><%= clientName %></strong> • Objekti: <span class="text-slate-300"><%= bldName %></span></p>
  </div>

  <div class="flex items-center gap-2.5 flex-wrap">
    <a href="<%= publicUrl %>" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5 shadow-sm">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      <span>Linku Publik (QR)</span>
    </a>

    <a href="/kontratat/<%= contract.id %>/ndrysho" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span>Ndrysho Tekstet</span>
    </a>

    <a href="/kontratat/<%= contract.id %>/print" target="_blank" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Printo Kontratën</span>
    </a>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  
  <!-- Kolona Kryesore me Nenet e Kontratës -->
  <div class="lg:col-span-2 space-y-6">
    
    <!-- Përmbledhja Inxhinierike & Financiare -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          Kushtet Inxhinierike & Financiare
        </h3>
        <span class="text-[11px] text-slate-400 font-mono">Data: <%= formatDate(contract.createdAt) %></span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
          <span class="text-slate-500 block text-[11px]">Vlera e Plotë:</span>
          <span class="text-lg font-black text-amber-400 font-mono"><%= formatCurrency(contract.value) %></span>
        </div>
        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
          <span class="text-slate-500 block text-[11px]">Garancia:</span>
          <span class="text-lg font-bold text-emerald-400 font-mono"><%= contract.warrantyMonths %> Muaj</span>
        </div>
        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
          <span class="text-slate-500 block text-[11px]">Dorëzimi i Pajisjeve:</span>
          <span class="font-bold text-slate-200"><%= formatDate(contract.deliveryDate) %></span>
        </div>
        <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
          <span class="text-slate-500 block text-[11px]">Kolaudimi / Montimi:</span>
          <span class="font-bold text-slate-200"><%= formatDate(contract.installationDate) %></span>
        </div>
      </div>
    </div>

    <!-- Përmbajtja Tekstuale e Kontratës -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-6">
      
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider">
            <%= contract.contractTitle || 'KONTRATË PËR FURNIZIMIN, MONTIMIN DHE MIRËMBAJTJEN E SISTEMEVE TË LIFTEVE' %>
          </h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Tekstet e personalizuara të kontratës zyrtare</p>
        </div>
        <a href="/kontratat/<%= contract.id %>/ndrysho" class="px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          Edito Tekstet
        </a>
      </div>

      <!-- Preambula -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Preambula / Palët Kontraktuese:</span>
        <p class="text-slate-300 leading-relaxed"><%= contract.preambleText || defaultPreamble %></p>
      </div>

      <!-- NENI 1 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article1Title || 'NENI 1: OBJEKTI I KONTRATËS' %></h4>
        <p class="text-slate-300 leading-relaxed"><%= contract.article1Text || defaultArt1 %></p>
      </div>

      <!-- NENI 2 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article2Title || 'NENI 2: VLERA E KONTRATËS DHE KUSHTET E PAGESËS' %></h4>
        <p class="text-slate-300 leading-relaxed"><%= contract.article2Text || defaultArt2 %></p>
      </div>

      <!-- NENI 3 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article3Title || 'NENI 3: AFATET E EKZEKUTIMIT DHE GARANCIA' %></h4>
        <p class="text-slate-300 leading-relaxed"><%= contract.article3Text || defaultArt3 %></p>
      </div>

      <!-- NENI 4 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article4Title || 'NENI 4: MIRËMBAJTJA & SHËRBIMI' %></h4>
        <p class="text-slate-300 leading-relaxed"><%= contract.article4Text || defaultArt4 %></p>
      </div>

      <!-- NENI 5 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article5Title || 'NENI 5: DETYRIMET DHE PËRGJEGJËSITË E PALËVE' %></h4>
        <p class="text-slate-300 leading-relaxed whitespace-pre-line font-mono text-[11px]"><%= contract.article5Text || defaultArt5 %></p>
      </div>

      <!-- NENI 6 -->
      <div class="p-4 bg-slate-950/60 border border-slate-800/80 rounded-xl space-y-1">
        <h4 class="font-bold text-amber-400 uppercase text-xs"><%= contract.article6Title || 'NENI 6: KUSHTET E VEÇANTA & DISPOZITAT PËRFUNDIMTARE' %></h4>
        <p class="text-slate-300 leading-relaxed"><%= contract.article6Text || defaultArt6 %></p>
      </div>

      <% if (contract.specialTerms) { %>
        <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-xl space-y-1">
          <h4 class="font-bold text-amber-300 uppercase text-xs">Klauzola Speciale Shtesë</h4>
          <p class="text-slate-200 leading-relaxed"><%= contract.specialTerms %></p>
        </div>
      <% } %>

      <!-- Dispozitat Përfundimtare -->
      <div class="p-4 bg-slate-950/40 border border-slate-800/60 rounded-xl space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Dispozitat Përmbyllëse:</span>
        <p class="text-slate-400 italic text-[11px]"><%= contract.closingTerms || defaultClosing %></p>
      </div>

    </div>
  </div>

  <!-- Kolona Anësore: Klienti, Ashensori, Ndryshimi i Statusit, QR Kodi -->
  <div class="space-y-6">
    
    <!-- Kartela e QR Kodit & Linkut Publik të Enkriptuar -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl text-xs space-y-3">
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider flex items-center gap-1.5">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
          <span>QR Kodi & Linku Publik</span>
        </h3>
        <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">I Enkriptuar</span>
      </div>

      <div class="flex justify-center my-1">
        <div class="p-2 bg-white rounded-xl shadow-md inline-block border border-slate-800">
          <img src="<%= qrCodeDataUrl %>" alt="QR Code <%= contract.number %>" class="w-28 h-28 block">
        </div>
      </div>

      <p class="text-[11px] text-slate-400 text-center">
        Link i mbrojtur dhe i enkriptuar për verifikimin dhe shikimin e kontratës pa pasur nevojë kyçjeje.
      </p>

      <div class="space-y-2 pt-1">
        <button type="button" onclick="navigator.clipboard.writeText('<%= publicUrl %>'); alert('Linku i enkriptuar u kopjua në clipboard!');" class="w-full py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs flex items-center justify-center gap-1.5 border border-slate-700 transition-all">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span>Kopjo Linkun Publik</span>
        </button>

        <a href="<%= publicUrl %>" target="_blank" class="w-full py-2 px-3 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center justify-center gap-1.5 transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          <span>Hap Pamjen Publike</span>
        </a>
      </div>
    </div>

    <!-- Ndryshimi i Shpejtë i Statusit -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2">Statusi i Kontratës</h3>
      <form action="/kontratat/<%= contract.id %>/status" method="POST" class="space-y-3">
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-semibold focus:outline-none focus:border-amber-400">
          <option value="Aktive" <%= contract.status === 'Aktive' ? 'selected' : '' %>>Aktive</option>
          <option value="E Nënshkruar" <%= contract.status === 'E Nënshkruar' ? 'selected' : '' %>>E Nënshkruar</option>
          <option value="E Përfunduar" <%= contract.status === 'E Përfunduar' ? 'selected' : '' %>>E Përfunduar</option>
          <option value="Anuluar" <%= contract.status === 'Anuluar' ? 'selected' : '' %>>Anuluar</option>
        </select>
        <button type="submit" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold text-xs border border-slate-700 transition-all">
          Përditëso Statusin
        </button>
      </form>
    </div>

    <!-- Box Klienti & Objekti -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2">Klienti & Objekti</h3>
      <div>
        <span class="text-slate-500 block text-[11px]">Kompania / Blerësi:</span>
        <a href="/klientet/<%= contract.customer.id %>" class="font-bold text-amber-400 hover:text-amber-300 text-sm"><%= clientName %></a>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">Objekti:</span>
        <span class="font-medium text-slate-200"><%= bldName %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">Vendndodhja:</span>
        <span class="text-slate-300"><%= cAddress %>, <%= cCity %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">NUI / Numri Fiskal:</span>
        <span class="font-mono text-slate-200"><%= cTax %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[11px]">Telefoni:</span>
        <span class="font-mono text-slate-200"><%= contract.customer.phone || '-' %></span>
      </div>
    </div>

    <!-- Modeli i Liftit -->
    <% if (contract.elevator) { %>
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-3">
        <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2">Modeli i Liftit</h3>
        <div class="font-bold text-slate-100 text-sm"><%= contract.elevator.model %></div>
        <div class="grid grid-cols-2 gap-2 text-slate-400">
          <div>Tipi: <strong class="text-slate-200"><%= contract.elevator.type %></strong></div>
          <div>Kapaciteti: <strong class="text-slate-200"><%= contract.elevator.capacityKg %> kg</strong></div>
          <div>Shpejtësia: <strong class="text-slate-200"><%= contract.elevator.speed %> m/s</strong></div>
          <div>Stacionet: <strong class="text-slate-200"><%= contract.elevator.stopsCount %></strong></div>
        </div>
      </div>
    <% } %>

    <!-- Dokumentet & Projektet e Lidhura -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2">Lidhjet e Sistemit</h3>
      
      <% if (contract.quotation) { %>
        <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
          <span class="text-slate-400">Oferta Bazë:</span>
          <a href="/ofertat/<%= contract.quotation.id %>" class="font-mono font-bold text-amber-400 hover:underline"><%= contract.quotation.number %></a>
        </div>
      <% } %>

      <% if (contract.projects && contract.projects.length > 0) { %>
        <% contract.projects.forEach(p => { %>
          <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
            <span class="text-slate-400">Projekti:</span>
            <a href="/projektet/<%= p.id %>" class="font-mono font-bold text-amber-400 hover:underline"><%= p.number %></a>
          </div>
        <% }); %>
      <% } %>

      <% if (contract.notes) { %>
        <div class="pt-2">
          <span class="text-slate-500 block text-[11px] mb-1">Shënime të brendshme:</span>
          <p class="text-slate-400 italic bg-slate-950 p-2.5 rounded-lg border border-slate-800"><%= contract.notes %></p>
        </div>
      <% } %>
    </div>

  </div>

</div>
