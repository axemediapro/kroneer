<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">FATURAT DHE ARTHËTIMET</h1>
    <p class="text-xs text-slate-400 mt-1">Sistemi i faturimit zyrtar me TVSH 18% dhe ndjekjen e borxheve të mbetura</p>
  </div>
  <a href="/faturat/krijo" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    <span>Lësho Faturë të Re</span>
  </a>
</div>

<!-- 3 Kartela Përmbledhëse të Faturave -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
    <span class="text-[11px] font-bold uppercase text-slate-400 tracking-wider block mb-1">TOTALI I FATURUAR</span>
    <div class="text-xl font-black text-slate-100 font-mono"><%= formatCurrency(totalAmount) %></div>
  </div>
  <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
    <span class="text-[11px] font-bold uppercase text-slate-400 tracking-wider block mb-1">TOTALI I ARKËTUAR</span>
    <div class="text-xl font-black text-emerald-400 font-mono"><%= formatCurrency(totalPaid) %></div>
  </div>
  <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
    <span class="text-[11px] font-bold uppercase text-slate-400 tracking-wider block mb-1">BORXHI I MBETUR PËR PAGESË</span>
    <div class="text-xl font-black text-rose-400 font-mono"><%= formatCurrency(totalBalance) %></div>
  </div>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/faturat" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me numër fature, klient..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
    </div>
    <div>
      <select name="status" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha statuset</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.status) { %>
        <a href="/faturat" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Faturave -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Numri i Faturës</th>
          <th class="p-4">Klienti</th>
          <th class="p-4">Data & Afati</th>
          <th class="p-4">Totali</th>
          <th class="p-4">Paguar</th>
          <th class="p-4">Mbetur</th>
          <th class="p-4">Statusi</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (invoices && invoices.length > 0) { %>
          <% invoices.forEach(inv => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4 font-mono font-bold text-amber-400">
                <a href="/faturat/<%= inv.id %>" class="hover:underline"><%= inv.number %></a>
              </td>
              <td class="p-4 font-bold text-slate-200">
                <%= inv.customer.companyName %>
              </td>
              <td class="p-4 text-slate-300">
                <div><%= formatDate(inv.date) %></div>
                <div class="text-[10px] text-slate-500">Afati: <%= formatDate(inv.dueDate) %></div>
              </td>
              <td class="p-4 font-mono font-bold text-slate-100 text-sm">
                <%= formatCurrency(inv.total) %>
              </td>
              <td class="p-4 font-mono font-bold text-emerald-400">
                <%= formatCurrency(inv.paidAmount) %>
              </td>
              <td class="p-4 font-mono font-bold <%= inv.balanceDue > 0 ? 'text-rose-400' : 'text-slate-500' %>">
                <%= formatCurrency(inv.balanceDue) %>
              </td>
              <td class="p-4">
                <% if (inv.status === 'Paguar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Paguar</span>
                <% } else if (inv.status === 'E vonuar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30">E vonuar</span>
                <% } else { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30"><%= inv.status %></span>
                <% } %>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <button type="button" onclick='openQuickView(<%- JSON.stringify({
                    title: `Fatura ${inv.number}`,
                    subtitle: inv.customer.companyName,
                    statusLabel: inv.status,
                    statusClass: "bg-amber-500/20 text-amber-300 border-amber-500/30",
                    rows: [
                      { label: "Data", value: formatDate(inv.date) },
                      { label: "Afati i Pagesës", value: formatDate(inv.dueDate) },
                      { label: "Totali", value: formatCurrency(inv.total) },
                      { label: "Paguar", value: formatCurrency(inv.paidAmount) },
                      { label: "Borxhi", value: formatCurrency(inv.balanceDue) }
                    ],
                    viewUrl: `/faturat/${inv.id}`,
                    editUrl: `/faturat/${inv.id}/ndrysho`,
                    printUrl: `/faturat/${inv.id}/print`
                  }).replace(/</g, '\\u003c').replace(/'/g, '&#39;') %>)' class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 border border-slate-700 transition-colors" title="Pamje e Shpejtë">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                  </button>
                  <a href="/faturat/<%= inv.id %>/ndrysho" class="p-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 transition-colors" title="Ndrysho Faturën">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </a>
                  <form action="/faturat/<%= inv.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini faturën <%= inv.number %>?');">
                    <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-500/40 transition-colors" title="Fshi Faturën">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                  <a href="/faturat/<%= inv.id %>/print" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 transition-colors" title="Printo">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="p-8 text-center text-slate-500">Nuk u gjet asnjë faturë.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
