<div class="space-y-6" x-data="serialCodeModal()" data-live-dashboard data-live-url="/instalimet/live-data?status=<%= encodeURIComponent(filters.status) %>&amp;search=<%= encodeURIComponent(filters.search) %>">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Qendra e Instalimeve</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Menaxhimi dhe monitorimi i hapave teknikë të montimit të lifteve KRONEER</p>
    </div>
    <div class="flex items-center space-x-3">
      <a href="/instalimet/krijo" class="inline-flex items-center px-4 py-2.5 bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 text-white text-sm font-semibold rounded-lg shadow-sm transition">
        <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
        Cakto Instalim të Ri
      </a>
    </div>
  </div>

  <!-- Unified Navigation Tabs -->
  <div class="border-b border-slate-200 dark:border-slate-700 mt-2 mb-6">
    <nav class="-mb-px flex space-x-6 overflow-x-auto">
      <a href="/projektet?line=Instalim" class="border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 dark:text-slate-400 dark:hover:text-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
        <i data-lucide="folder" class="w-4 h-4"></i>
        Projektet
      </a>
      <a href="/instalimet" class="border-amber-500 text-amber-600 dark:text-amber-400 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
        <i data-lucide="settings" class="w-4 h-4"></i>
        Instalimet Live
      </a>
      <a href="/dorezimi" class="border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 dark:text-slate-400 dark:hover:text-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        Dorëzimet
      </a>
    </nav>
  </div>

  <!-- Filters -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
    <form action="/instalimet" method="GET" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Statusi</label>
        <select name="status" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <option value="">Të gjitha statuset</option>
          <% statuses.forEach(st => { %>
            <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Kërko Instalim</label>
        <div class="relative">
          <input type="text" name="search" value="<%= filters.search %>" placeholder="Numri serik, modeli, projekti..." class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
        </div>
      </div>

      <div class="flex items-end space-x-2">
        <button type="submit" class="w-full py-2 px-4 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 text-white text-sm font-semibold rounded-lg transition">
          Filtro
        </button>
        <% if (filters.status || filters.search) { %>
          <a href="/instalimet" class="py-2 px-3 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-lg hover:bg-slate-300 transition">
            Pastro
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <section aria-label="Dashboard i instalimeve" class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Dashboard teknik</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Progresi i montimit dhe problemet aktive të servisit</p>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span id="dashboard-sync-state">Live · rifreskohet çdo 15 sekonda</span>
        <span class="hidden sm:inline">·</span>
        <time id="dashboard-updated-at" class="hidden sm:inline"><%= new Date().toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) %></time>
      </div>
    </div>

    <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
      <article class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4">
        <p class="text-[11px] font-semibold uppercase text-slate-500 dark:text-slate-400">Instalime në filtër</p>
        <p class="mt-2 text-2xl font-bold text-slate-900 dark:text-white" data-stat="total"><%= dashboardSummary.total %></p>
      </article>
      <article class="rounded-xl border border-amber-200 dark:border-amber-900/70 bg-amber-50/60 dark:bg-amber-950/20 p-4">
        <p class="text-[11px] font-semibold uppercase text-amber-700 dark:text-amber-300">Progres mesatar</p>
        <p class="mt-2 text-2xl font-bold text-amber-700 dark:text-amber-300"><span data-stat="averageProgress"><%= dashboardSummary.averageProgress %></span><span class="text-base">%</span></p>
      </article>
      <article class="rounded-xl border border-blue-200 dark:border-blue-900/70 bg-blue-50/60 dark:bg-blue-950/20 p-4">
        <p class="text-[11px] font-semibold uppercase text-blue-700 dark:text-blue-300">Në instalim / testim</p>
        <p class="mt-2 text-2xl font-bold text-blue-700 dark:text-blue-300"><span data-stat="inProgress"><%= dashboardSummary.inProgress %></span><span class="text-sm font-medium text-slate-500"> / </span><span data-stat="testing"><%= dashboardSummary.testing %></span></p>
      </article>
      <article class="rounded-xl border border-rose-200 dark:border-rose-900/70 bg-rose-50/60 dark:bg-rose-950/20 p-4">
        <p class="text-[11px] font-semibold uppercase text-rose-700 dark:text-rose-300">Probleme aktive</p>
        <p class="mt-2 text-2xl font-bold text-rose-700 dark:text-rose-300" data-stat="openProblems"><%= dashboardSummary.openProblems %></p>
      </article>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
      <article class="lg:col-span-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4 sm:p-5">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Progresi teknik</h3>
          <span class="text-[11px] text-slate-500">8 instalimet e përditësuara së fundmi</span>
        </div>
        <div id="dashboard-progress-list" class="divide-y divide-slate-100 dark:divide-slate-700">
          <% installations.slice(0, 8).forEach(inst => { %>
            <a href="/instalimet/<%= inst.id %>" class="block py-3 hover:bg-slate-50 dark:hover:bg-slate-900/40" data-progress-row>
              <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-xs font-semibold text-slate-800 dark:text-slate-200"><%= inst.elevatorModel %> <span class="font-mono text-slate-500">· <%= inst.serialNumber %></span></p>
                  <p class="truncate text-[11px] text-slate-500"><%= inst.project.name %> · <%= inst.status %></p>
                </div>
                <span class="shrink-0 text-xs font-bold <%= inst.progressPercent === 100 ? 'text-emerald-500' : 'text-amber-500' %>" data-progress-value><%= inst.progressPercent %>%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                <div class="h-full rounded-full <%= inst.progressPercent === 100 ? 'bg-emerald-500' : 'bg-amber-500' %>" data-progress-bar style="width:<%= Math.min(100, Math.max(0, inst.progressPercent || 0)) %>%"></div>
              </div>
            </a>
          <% }) %>
          <% if (installations.length === 0) { %>
            <p class="py-6 text-center text-xs text-slate-500" data-empty-progress>Nuk ka instalime për filtrat e zgjedhur.</p>
          <% } %>
        </div>
      </article>

      <article class="lg:col-span-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4 sm:p-5">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Problemet live</h3>
            <p class="text-[11px] text-slate-500">Tiketa të hapura për këto instalime</p>
          </div>
          <a href="/servisi" class="text-xs font-semibold text-amber-600 hover:text-amber-500">Shiko servisin</a>
        </div>
        <div id="dashboard-issues-list" class="divide-y divide-slate-100 dark:divide-slate-700">
          <% activeTickets.forEach(ticket => { %>
            <a href="/servisi/<%= ticket.id %>" class="block py-3 hover:bg-slate-50 dark:hover:bg-slate-900/40" data-issue-row>
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-bold text-slate-700 dark:text-slate-200"><%= ticket.number %> · <%= ticket.serialNumber %></span>
                <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-bold <%= ticket.priority === 'Kritik' ? 'bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300' : ticket.priority === 'I lartë' ? 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300' %>"><%= ticket.priority %></span>
              </div>
              <p class="mt-1 line-clamp-2 text-xs text-slate-600 dark:text-slate-300"><%= ticket.problemDescription.length > 120 ? `${ticket.problemDescription.slice(0, 120)}…` : ticket.problemDescription %></p>
              <p class="mt-1 text-[10px] text-slate-500"><%= ticket.status %> · <%= ticket.technician ? ticket.technician.fullName : 'Pa teknik të caktuar' %></p>
            </a>
          <% }) %>
          <% if (activeTickets.length === 0) { %>
            <p class="py-6 text-center text-xs text-slate-500" data-empty-issues>Nuk ka probleme aktive për këto instalime.</p>
          <% } %>
        </div>
      </article>
    </div>
  </section>

  <!-- Installation Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (installations.length === 0) { %>
      <div class="col-span-full bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-12 text-center">
        <i data-lucide="wrench" class="w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Nuk u gjet asnjë instalim</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Nuk ka instalime që përputhen me kriteret e kërkimit.</p>
      </div>
    <% } else { %>
      <% installations.forEach(inst => { 
        const completedChecklist = inst.checklistItems ? inst.checklistItems.filter(i => i.isCompleted).length : 0;
        const totalChecklist = inst.checklistItems ? inst.checklistItems.length : 13;
      %>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm hover:border-amber-400 transition flex flex-col justify-between">
          <div>
            <!-- Top Status & Serial -->
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex items-center gap-1.5">
                <span class="px-2.5 py-1 text-xs font-mono font-bold rounded bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50">
                  <%= inst.serialNumber %>
                </span>
                <button type="button" @click="open('<%= inst.serialNumber %>', '/instalimet/<%= inst.id %>/qr')" title="Shfaq QR Code / Barkod" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors">
                  <i data-lucide="qr-code" class="w-3.5 h-3.5"></i>
                </button>
              </div>
              <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full <%= 
                inst.status === 'Përfunduar' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400' :
                inst.status === 'Në Testim' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-400' :
                inst.status === 'Në Instalim' ? 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-400' :
                'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-300'
              %>">
                <%= inst.status %>
              </span>
            </div>

            <!-- Model & Project -->
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              <a href="/instalimet/<%= inst.id %>" class="hover:text-amber-600 dark:hover:text-amber-400">
                <%= inst.elevatorModel %>
              </a>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              Projekti: <a href="/projektet/<%= inst.projectId %>" class="font-medium text-slate-700 dark:text-slate-300 hover:text-amber-600"><%= inst.project.name %></a>
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Klienti: <%= inst.project.customer ? inst.project.customer.companyName : '-' %>
            </p>

            <!-- Progress Bar -->
            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60">
              <div class="flex justify-between items-center text-xs mb-1.5">
                <span class="font-semibold text-slate-700 dark:text-slate-300">Progresi Teknik</span>
                <span class="font-bold <%= inst.progressPercent === 100 ? 'text-emerald-600' : 'text-amber-600' %>">
                  <%= inst.progressPercent %>% (<%= completedChecklist %>/<%= totalChecklist %>)
                </span>
              </div>
              <div class="w-full bg-slate-100 dark:bg-slate-700/80 h-2.5 rounded-full overflow-hidden">
                <div class="h-full rounded-full transition-all duration-300 <%= inst.progressPercent === 100 ? 'bg-emerald-500' : 'bg-gradient-to-r from-amber-500 to-amber-600' %>" style="width: <%= inst.progressPercent %>%"></div>
              </div>
            </div>

            <div class="mt-3 text-xs text-slate-500 space-y-1">
              <div class="flex items-center">
                <i data-lucide="user-check" class="w-3.5 h-3.5 mr-1.5 text-slate-400"></i>
                Ekipi: <%= inst.teamLead || (inst.technician ? inst.technician.fullName : 'Ekipi KRONEER') %>
              </div>
              <div class="flex items-center">
                <i data-lucide="calendar" class="w-3.5 h-3.5 mr-1.5 text-slate-400"></i>
                Filluar: <%= new Date(inst.startDate).toLocaleDateString('sq-AL') %>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
            <a href="/instalimet/<%= inst.id %>" class="text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center">
              Lista e Kontrollit (13 Hapa) <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1"></i>
            </a>
            <% if (inst.progressPercent === 100) { %>
              <a href="/dorezimi/krijo?projectId=<%= inst.projectId %>&installationId=<%= inst.id %>" class="px-2.5 py-1 text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 rounded hover:bg-emerald-100">
                Dorëzo →
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Modal: QR Code / Barkod i Numërit Serik -->
  <%- include('../partials/serial-code-modal') %>
</div>

<script defer src="/js/installation-dashboard.js?v=1"></script>
