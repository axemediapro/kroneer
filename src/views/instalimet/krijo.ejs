<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-1">
        <a href="/instalimet" class="hover:text-amber-600 dark:hover:text-amber-400">Instalimet</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-slate-200">Cakto Instalim të Ri</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Cakto Instalim të Ri Lifti</h1>
    </div>
    <a href="/instalimet" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition">
      Kthehu
    </a>
  </div>

  <form action="/instalimet/krijo" method="POST" class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Numri Serik i Liftit *</label>
        <input type="text" name="serialNumber" value="<%= nextSerial %>" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
        <p class="text-xs text-slate-500 mt-1">Gjenerohet automatikisht ose mund të vendoset pllaka serike prodhuese</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Projekti Inxhinierik *</label>
        <select name="projectId" required class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <option value="">-- Zgjidh Projektin --</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.number %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Modeli i Liftit *</label>
        <input type="text" name="elevatorModel" required placeholder="p.sh. KRONEER ProPassenger 630 MRL" list="elevatorList" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
        <datalist id="elevatorList">
          <% elevators.forEach(e => { %>
            <option value="<%= e.model %>"><%= e.name %> (<%= e.capacityKg %> KG)</option>
          <% }) %>
        </datalist>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Tekniku Kryesor / Përgjegjës</label>
        <select name="technicianId" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <option value="">-- Zgjidh Teknikun --</option>
          <% technicians.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.fullName %> (<%= t.role %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Ekipi Montues</label>
        <input type="text" name="teamLead" value="Ekipi Inxhinierik KRONEER 1" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Data e Fillimit të Punimeve</label>
        <input type="date" name="startDate" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Afati i Synuar i Përfundimit</label>
        <input type="date" name="targetDate" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Shënime Teknike mbi Instalimin</label>
        <textarea name="notes" rows="3" placeholder="Përgatitjet në bosht, furnizimi me rrymë tre-fazore, pajisjet speciale të ngritjes..." class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></textarea>
      </div>
    </div>

    <!-- Info Box -->
    <div class="p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 rounded-xl flex items-start space-x-3">
      <i data-lucide="info" class="w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"></i>
      <div class="text-xs text-amber-900 dark:text-amber-300 leading-relaxed">
        <strong>Lista e Kontrollit me 13 Hapa:</strong> Pas krijimit të këtij instalimi, sistemi KRONEER automatikisht do të gjenerojë 13 pikat standarde të kontrollit inxhinierik (Kontrolli i boshtit, gropës, montimi i shinave, motorit, dyerve, kabinës, instalimeve elektrike, kalibrimi i sigurisë, testimi dinamik dhe dorëzimi).
      </div>
    </div>

    <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex justify-end space-x-3">
      <a href="/instalimet" class="px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-600 transition">
        Anulo
      </a>
      <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 rounded-lg transition shadow-sm flex items-center">
        <i data-lucide="check" class="w-4 h-4 mr-2"></i>
        Cakto Instalimin
      </button>
    </div>
  </form>
</div>
