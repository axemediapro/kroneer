<div class="mb-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight">
          PANELI I PUNËTORIT
        </h1>
        <span class="font-mono text-xs font-bold text-cyan-300 bg-cyan-500/15 border border-cyan-500/30 px-3 py-1 rounded-lg">
          Vetëm projektet e mia
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Përshëndetje, <span class="text-slate-200 font-semibold"><%= currentUser ? currentUser.fullName : '' %></span>
        <% if (employee) { %> • <%= employee.position %> • <%= employee.code %><% } %>
      </p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/prezenca" class="px-3.5 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/40 font-bold text-xs transition-all flex items-center gap-1.5">
        <i data-lucide="clock" class="w-4 h-4"></i>
        Orari & Prezenca
      </a>
      <a href="/intervenimet" class="px-3.5 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs shadow-md shadow-cyan-600/20 transition-all flex items-center gap-1.5">
        <i data-lucide="wrench" class="w-4 h-4"></i>
        Intervenimet
      </a>
    </div>
  </div>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
    <span class="text-slate-400 text-xs font-semibold">Projektet e mia</span>
    <div class="text-2xl font-black text-amber-400 font-mono mt-1"><%= stats.assignedCount %></div>
    <span class="text-[10px] text-slate-500">Të caktuara për ju</span>
  </div>
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
    <span class="text-slate-400 text-xs font-semibold">Aktive</span>
    <div class="text-2xl font-black text-cyan-300 font-mono mt-1"><%= stats.activeCount %></div>
    <span class="text-[10px] text-slate-500">Në ekzekutim</span>
  </div>
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
    <span class="text-slate-400 text-xs font-semibold">Instalime</span>
    <div class="text-2xl font-black text-slate-100 font-mono mt-1"><%= stats.installingCount %></div>
    <span class="text-[10px] text-slate-500">Në kantier</span>
  </div>
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
    <span class="text-slate-400 text-xs font-semibold">Prezenca sot</span>
    <div class="text-lg font-black font-mono mt-1 <%= todayAttendance && todayAttendance.status === 'Në Punë' ? 'text-emerald-400' : 'text-slate-300' %>">
      <%= todayAttendance ? todayAttendance.status : 'Pa regjistrim' %>
    </div>
    <span class="text-[10px] text-slate-500"><%= todayAttendance && todayAttendance.location ? todayAttendance.location : 'Regjistrohuni te Orari' %></span>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h2 class="text-base font-bold text-slate-100 font-mono">Projektet e mia (<%= myProjects.length %>)</h2>
      <a href="/projektet" class="text-[11px] text-amber-400 hover:underline">Lista e plotë →</a>
    </div>

    <% if (myProjects && myProjects.length > 0) { %>
      <div class="space-y-3">
        <% myProjects.forEach(prj => { %>
          <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-amber-500/40 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <div>
                <a href="/projektet/<%= prj.id %>" class="font-bold text-sm text-slate-100 hover:text-amber-400 block"><%= prj.name %></a>
                <span class="text-[10px] text-amber-400 font-mono">
                  <%= prj.number %> • <%= prj.customer ? (prj.customer.companyName || ((prj.customer.firstName || '') + ' ' + (prj.customer.lastName || '')).trim()) : '-' %>
                </span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30 self-start">
                <%= prj.stage %>
              </span>
            </div>
            <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
              <span>
                Menaxher: <%= prj.projectManager ? prj.projectManager.fullName : '—' %>
                • <%= prj.elevatorCount %> lifta
              </span>
              <a href="/projektet/<%= prj.id %>" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700">Hap →</a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="p-8 text-center text-slate-500 text-xs bg-slate-950/40 rounded-xl border border-slate-800/60">
        Nuk jeni caktuar ende në asnjë projekt. Kur menaxheri ju shton në ekip, projektet shfaqen këtu.
      </div>
    <% } %>
  </div>

  <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-3">
    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
      <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider font-mono">Intervenimet e mia</h3>
      <a href="/intervenimet" class="text-[11px] text-cyan-400 hover:underline">Të gjitha →</a>
    </div>
    <% if (myInterventions && myInterventions.length > 0) { %>
      <div class="space-y-2.5 max-h-[28rem] overflow-y-auto pr-1">
        <% myInterventions.forEach(inv => { %>
          <a href="/intervenimet/<%= inv.id %>" class="block p-3 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/30">
            <span class="font-bold text-slate-200 text-xs block truncate"><%= inv.title %></span>
            <span class="text-[10px] text-amber-400 font-mono block"><%= inv.number %><% if (inv.project) { %> • <%= inv.project.name %><% } %></span>
            <span class="mt-1 inline-block px-2 py-0.5 rounded text-[10px] font-bold <%= inv.status === 'Përfunduar' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300' %>"><%= inv.status %></span>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-xs text-slate-500 text-center py-4">Nuk keni intervenime të caktuara.</p>
    <% } %>
  </div>
</div>
