<div x-data="{
  isLogoModalOpen: false,
  modalVariant: 'dark_bg', // 'dark_bg' ose 'standard'
  standardPreviewUrl: '<%= company && company.logoUrl ? company.logoUrl : "" %>',
  darkBgPreviewUrl: '<%= company && company.logoDarkBgUrl ? company.logoDarkBgUrl : "" %>',
  fileName: '',
  fileSize: '',
  previewMode: 'dark', // 'dark' ose 'light'
  
  get currentPreview() {
    return this.modalVariant === 'dark_bg' ? this.darkBgPreviewUrl : this.standardPreviewUrl;
  },

  handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;
    this.fileName = file.name;
    this.fileSize = (file.size / 1024).toFixed(1) + ' KB';
    
    const reader = new FileReader();
    reader.onload = (e) => {
      if (this.modalVariant === 'dark_bg') {
        this.darkBgPreviewUrl = e.target.result;
      } else {
        this.standardPreviewUrl = e.target.result;
      }
    };
    reader.readAsDataURL(file);
  }
}">

<!-- Header & Welcome me Integrim të Logos Zyrtare -->
<div class="mb-8 bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-950 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl relative overflow-hidden">
  <!-- Sfondi Dekorativ Inxhinierik -->
  <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-gradient-to-l from-amber-500/5 to-transparent pointer-events-none"></div>

  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 relative z-10">
    <div class="flex items-start sm:items-center gap-3.5">
      <!-- Logo Thumbnail / Emblem me Buton të Shpejtë të Ngarkimit -->
      <div class="relative group flex-shrink-0">
        <div class="w-12 h-12 rounded-xl bg-slate-950 border border-slate-700/80 p-1.5 flex items-center justify-center shadow-lg group-hover:border-amber-400 transition-all overflow-hidden bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:6px_6px]">
          <% const hasDarkLogo = company && company.logoDarkBgUrl; %>
          <% const hasLightLogo = company && company.logoUrl; %>
          <% const hasBothLogos = hasDarkLogo && hasLightLogo; %>
          <% if (hasDarkLogo || hasLightLogo) { %>
            <% if (hasDarkLogo) { %>
              <img src="<%= company.logoDarkBgUrl %>" alt="<%= company.companyName %>" class="<%= hasBothLogos ? 'logo-dark-only' : '' %> max-h-8 max-w-full w-auto object-contain filter drop-shadow">
            <% } %>
            <% if (hasLightLogo) { %>
              <img src="<%= company.logoUrl %>" alt="<%= company.companyName %>" class="<%= hasBothLogos ? 'logo-light-only' : '' %> max-h-8 max-w-full w-auto object-contain filter drop-shadow">
            <% } %>
          <% } else { %>
            <div class="w-full h-full rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 font-black text-xl font-mono shadow-md">
              K
            </div>
          <% } %>
        </div>
        <button type="button" @click="isLogoModalOpen = true" title="Kliko për të menaxhuar logot" class="absolute -bottom-1 -right-1 p-1 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-full shadow-md transition-transform hover:scale-110">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </button>
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-[11px] font-mono font-bold tracking-wider text-emerald-400 uppercase">Sistemi Aktiv</span>
          <% if (company && company.logoDarkBgUrl) { %>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 flex items-center gap-1">
              <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Logo Dark UI Aktive
            </span>
          <% } else if (company && company.logoUrl) { %>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700 flex items-center gap-1">
              <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Logo Standarde
            </span>
          <% } else { %>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-800 text-slate-400 border border-slate-700">
              Logo KRONEER
            </span>
          <% } %>
        </div>
        <h1 class="text-lg sm:text-xl font-black text-slate-100 tracking-tight font-mono mt-0.5">
          PËRSHËNDETJE, <%= currentUser ? currentUser.fullName.toUpperCase() : 'ADMIN' %>
        </h1>
        <p class="text-xs text-slate-400">
          <%= company ? company.companyName : 'KRONEER' %> • <%= company ? (company.tagline || 'Professional Elevator Solutions') : 'Professional Elevator Solutions' %> • Të dhëna financiare dhe inxhinierike në kohë reale
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a href="/prezenca" class="px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/20 to-emerald-600/10 hover:from-emerald-500/30 hover:to-emerald-600/20 text-emerald-300 border border-emerald-500/40 hover:border-emerald-400 font-bold text-xs shadow-sm transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Orari & Prezenca</span>
      </a>

      <!-- Butoni i Ngarkimit të Logos direkt nga Dashboardi -->
      <button type="button" @click="isLogoModalOpen = true" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 hover:text-amber-200 border border-amber-500/40 hover:border-amber-400 font-bold text-xs shadow-md shadow-amber-500/10 transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        <span>Menaxho Logot</span>
      </button>

      <a href="/lifts/konfiguruesi" class="px-3 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        <span>Konfiguruesi</span>
      </a>
      <a href="/ofertat/krijo" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-xs transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Krijo Ofertë</span>
      </a>
    </div>
  </div>
</div>

<!-- 6 Kartela Statistikore Kryesore -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
  
  <!-- 1. Të Ardhurat Totale -->
