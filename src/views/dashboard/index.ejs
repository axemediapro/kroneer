<!-- Seksioni i Poshtëm: Aktivitetet më të Fundit & Tiketat Emergjente -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  
  <!-- Aktivitetet e Fundit të Auditimit -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        HISTORIKU I AKTIVITETEVE
      </h3>
      <span class="text-xs text-slate-500">Ndryshimet e fundit</span>
    </div>

    <div class="space-y-3.5">
      <% if (recentActivities && recentActivities.length > 0) { %>
        <% recentActivities.forEach(act => { %>
          <div class="flex items-start gap-3 p-2.5 rounded-lg bg-slate-950/60 border border-slate-800/80">
            <div class="w-7 h-7 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">
              <%= act.actionType ? act.actionType.charAt(0) : 'A' %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-200"><%= act.userName %></span>
                <span class="text-[10px] text-slate-500"><%= timeAgo(act.createdAt) %></span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5 leading-snug"><%= act.description %></p>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="p-6 text-center text-xs text-slate-500">Nuk ka aktivitete të regjistruara.</p>
      <% } %>
    </div>
  </div>

  <!-- Tiketat Emergjente të Servisit -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        KËRKESAT PËR SERVIS
      </h3>
      <a href="/servisi" class="text-xs text-amber-400 hover:text-amber-300 font-medium">Shiko të gjitha &rarr;</a>
    </div>

    <div class="space-y-3">
      <% if (recentTickets && recentTickets.length > 0) { %>
        <% recentTickets.forEach(t => { %>
          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <a href="/servisi/<%= t.id %>" class="font-mono text-xs font-bold text-amber-400 hover:underline"><%= t.number %></a>
                <% if (t.priority === 'Kritik') { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30">Kritik</span>
                <% } else if (t.priority === 'I lartë') { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30">I lartë</span>
                <% } else { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30">Normal</span>
                <% } %>
                <span class="text-[10px] text-slate-500"><%= timeAgo(t.reportedDate) %></span>
              </div>
              <p class="text-xs text-slate-300 font-medium"><%= t.customer ? t.customer.companyName : 'Klient' %></p>
              <p class="text-xs text-slate-400 line-clamp-1 mt-0.5"><%= t.problemDescription %></p>
            </div>
            <a href="/servisi/<%= t.id %>" class="px-3 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 text-xs font-semibold border border-amber-500/30 transition">
              Hap Faqen
            </a>
          </div>
        <% }); %>
      <% } else { %>
        <p class="p-6 text-center text-xs text-slate-500">Nuk ka tiketa të hapura për servis.</p>
      <% } %>
    </div>
  </div>

</div>

<!-- MODAL: Ngarkimi i Logove të Kompanisë nga Dashboardi -->
<div x-show="isLogoModalOpen" x-cloak class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
  <div @click.away="isLogoModalOpen = false" class="w-full max-w-xl bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150 my-8">
    
    <!-- Koka e Modalit -->
    <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center font-bold text-lg">
          🎨
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
            Menaxhimi i Logove të Kompanisë
          </h3>
          <p class="text-xs text-slate-400">Përzgjidhni variantin e logos që dëshironi të ngarkoni ose përditësoni</p>
        </div>
      </div>
      <button type="button" @click="isLogoModalOpen = false" class="text-slate-400 hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-800 transition-colors">✕</button>
    </div>

    <!-- Trupi i Modalit -->
    <div class="p-6 space-y-5 text-xs">

      <!-- Përzgjedhësi i Variantit të Logos (Dark UI vs Dokumente) -->
      <div class="grid grid-cols-2 gap-2 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
        <button type="button" @click="modalVariant = 'dark_bg'; previewMode = 'dark'; fileName = ''" :class="modalVariant === 'dark_bg' ? 'bg-amber-500/20 text-amber-300 border-amber-500/40 shadow-sm' : 'text-slate-400 hover:text-slate-200 border-transparent'" class="py-2 px-3 rounded-lg border text-xs font-bold transition-all flex items-center justify-center gap-2">
          <span>🌙 Logo e Bardhë (Dark UI)</span>
        </button>
        <button type="button" @click="modalVariant = 'standard'; previewMode = 'light'; fileName = ''" :class="modalVariant === 'standard' ? 'bg-amber-500/20 text-amber-300 border-amber-500/40 shadow-sm' : 'text-slate-400 hover:text-slate-200 border-transparent'" class="py-2 px-3 rounded-lg border text-xs font-bold transition-all flex items-center justify-center gap-2">
          <span>☀️ Logo Dokumentesh (A4)</span>
        </button>
      </div>

      <!-- Zona e Pamjes Paraprake (Live Preview Box) -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="font-bold text-slate-200 flex items-center gap-1.5">
            <span>Pamja Paraprake:</span>
            <span class="text-amber-400" x-text="modalVariant === 'dark_bg' ? 'Për Sidebar, Kyçje & Dark UI' : 'Për Fatura, Oferta & Printim A4'"></span>
          </label>
          <!-- Toggle Sfondi Dark / Light Paper -->
          <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800 text-[11px]">
            <button type="button" @click="previewMode = 'dark'" :class="previewMode === 'dark' ? 'bg-slate-800 text-amber-300 font-bold' : 'text-slate-400 hover:text-slate-200'" class="px-2.5 py-1 rounded transition-all">
              🌙 Dark UI
            </button>
            <button type="button" @click="previewMode = 'light'" :class="previewMode === 'light' ? 'bg-white text-slate-900 font-bold' : 'text-slate-400 hover:text-slate-200'" class="px-2.5 py-1 rounded transition-all">
              📄 A4 Print
            </button>
          </div>
        </div>

        <div :class="previewMode === 'dark' ? 'bg-slate-950 border-slate-800' : 'bg-white border-slate-300'" class="h-36 rounded-xl border-2 border-dashed flex flex-col items-center justify-center p-4 relative transition-colors duration-200">
          <template x-if="currentPreview">
            <div class="flex flex-col items-center justify-center h-full w-full">
              <!-- Imazhi me ruajtje proporcionale të plotë dhe madhësi diskrete -->
              <img :src="currentPreview" alt="Logo Preview" class="max-h-16 max-w-[70%] w-auto object-contain filter drop-shadow transition-all">
              <span class="mt-2 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold" :class="previewMode === 'dark' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-emerald-100 text-emerald-800 border border-emerald-300'">
                ✓ Madhësi & proporcion i ruajtur
              </span>
            </div>
          </template>
          <template x-if="!currentPreview">
            <div class="text-center space-y-1 text-slate-400">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto text-lg font-bold font-mono">
                K
              </div>
              <p class="font-bold text-slate-300 text-xs" x-text="modalVariant === 'dark_bg' ? 'Nuk është ngarkuar logo e bardhë' : 'Nuk është ngarkuar logo standarde'"></p>
              <p class="text-[10px] text-slate-500">Zgjidhni një skedar (.SVG, .PNG, .WEBP) më poshtë</p>
            </div>
          </template>
        </div>
      </div>

      <!-- Formular Ngarkimi me Drag & Drop -->
      <form action="/paneli/logo" method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="returnUrl" value="/paneli">
        <input type="hidden" name="variant" :value="modalVariant">

        <div>
          <label class="block font-semibold text-slate-300 mb-1.5">
            <span x-text="modalVariant === 'dark_bg' ? 'Ngarko Logon e Bardhë (për sfond të errët):' : 'Ngarko Logon Kryesore (për dokumente & printim):'"></span>
          </label>
          
          <label class="relative flex flex-col items-center justify-center p-5 border-2 border-dashed border-slate-700 hover:border-amber-400 rounded-xl bg-slate-950/80 cursor-pointer transition-all group">
            <input type="file" name="logo" accept=".svg,.png,.jpg,.jpeg,.webp,image/svg+xml,image/*" required @change="handleFileSelect" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
            <div class="text-center space-y-1 pointer-events-none">
              <div class="w-9 h-9 rounded-full bg-slate-800 group-hover:bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              </div>
              <p class="text-xs font-bold text-slate-200 group-hover:text-amber-300 transition-colors">
                Kliko për të zgjedhur ose tërhiq skedarin këtu
              </p>
              <p class="text-[10px] text-slate-400 font-mono">
                Formatet: .SVG, .PNG, .JPG, .WEBP (Maksimumi 5MB)
              </p>
            </div>
          </label>

          <!-- Detajet e skedarit të zgjedhur -->
          <div x-show="fileName" x-cloak class="mt-2.5 p-2 rounded-lg bg-slate-950 border border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2 truncate">
              <span class="text-amber-400 font-mono text-xs">📄</span>
              <span class="font-mono text-slate-200 font-medium truncate text-xs" x-text="fileName"></span>
              <span class="text-slate-500 text-[10px]" x-text="'(' + fileSize + ')'"></span>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">Gati</span>
          </div>
        </div>

        <!-- Veprimet e Modalit -->
        <div class="pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-2.5">
          <!-- Butoni Fshi Logo përkatëse -->
          <div>
            <button type="submit" formaction="/paneli/logo/fshi" formmethod="POST" x-show="currentPreview" onclick="return confirm('A jeni të sigurt që dëshironi ta fshini këtë logo?');" class="w-full sm:w-auto px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 font-semibold border border-rose-500/30 transition-colors text-xs flex items-center justify-center gap-1.5">
