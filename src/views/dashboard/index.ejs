      </div>
    </div>
    <div class="text-xl font-black text-slate-100 font-mono"><%= stats.installingCount %></div>
    <span class="text-[10px] text-cyan-400 font-medium">Në kantier me ekip</span>
  </div>

  <!-- 5. Pagesa të Papaguara -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-lg hover:border-amber-500/40 transition-all">
    <div class="flex items-center justify-between text-slate-400 mb-2">
      <span class="text-[11px] font-bold uppercase tracking-wider">BORXHE NË PRITJE</span>
      <div class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
    </div>
    <div class="text-xl font-black text-rose-400 font-mono"><%= formatCurrency(stats.unpaidBalance) %></div>
    <span class="text-[10px] text-rose-400 font-medium">Fatura të papaguara</span>
  </div>

  <!-- 6. Kontrata Mirëmbajtjeje -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-lg hover:border-amber-500/40 transition-all">
    <div class="flex items-center justify-between text-slate-400 mb-2">
      <span class="text-[11px] font-bold uppercase tracking-wider">MIRËMBAJTJE</span>
      <div class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
