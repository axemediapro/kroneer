<!-- Koka Zyrtare e Pasqyrës Financiare të Klientit -->
<div class="flex justify-between items-start border-b-2 border-slate-900 pb-5 mb-6">
  <div>
    <% const printLogo = (company && company.logoUrl) ? company.logoUrl : (company && company.logoDarkBgUrl ? company.logoDarkBgUrl : null); %>
    <% if (printLogo) { %>
      <div class="h-11 max-w-[220px] flex items-center justify-start mb-2">
        <img src="<%= printLogo %>" alt="<%= company.companyName %>" class="max-h-11 w-auto max-w-full object-contain">
      </div>
    <% } else { %>
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-slate-950 text-amber-400 font-black flex items-center justify-center text-lg font-mono">
          K
        </div>
        <div>
          <h1 class="text-xl font-black tracking-widest text-slate-950 font-mono"><%= company.companyName %></h1>
          <p class="text-[10px] font-bold text-amber-600"><%= company.tagline %></p>
        </div>
      </div>
    <% } %>
    <div class="text-[11px] text-slate-600 space-y-0.5">
      <div><%= company.address %>, <%= company.city %> • NUI: <%= company.taxNumber %></div>
      <div>Tel: <%= company.phone %> • Email: <%= company.email %></div>
    </div>
  </div>

  <div class="text-right">
    <span class="inline-block px-3 py-1 bg-slate-950 text-amber-400 text-xs font-mono font-black rounded uppercase tracking-wider mb-2">
      PASQYRA FINANCIARE E LLOGARISË
    </span>
    <div class="text-xs text-slate-600 mt-1">Data e Lëshimit: <strong class="text-slate-900"><%= formatDate(new Date()) %></strong></div>
    <div class="text-xs text-slate-600">Kodi i Klientit: <strong class="text-slate-900 font-mono"><%= customer.code %></strong></div>
  </div>
</div>

<!-- Të Dhënat e Klientit -->
<div class="bg-slate-50 p-4 rounded-lg border border-slate-200 mb-6 text-xs flex justify-between items-start">
  <div>
    <span class="text-[10px] font-bold uppercase text-slate-500 tracking-wider block mb-1">SUBJEKTI / KLIENTI:</span>
    <h3 class="text-base font-black text-slate-950"><%= customer.companyName %></h3>
    <div class="text-slate-700 mt-1">Përfaqësuesi: <strong><%= customer.contactPerson || '-' %></strong></div>
    <div class="text-slate-700">Adresa: <%= customer.address || '-' %>, <%= customer.city || '-' %>, <%= customer.country || 'Kosovë' %></div>
    <div class="text-slate-700">NUI: <%= customer.taxNumber || '-' %> • Tel: <%= customer.phone || '-' %></div>
  </div>
  <div class="text-right text-xs">
    <span class="text-[10px] font-bold uppercase text-slate-500 tracking-wider block mb-1">PROFILI:</span>
    <span class="px-2.5 py-0.5 rounded bg-slate-200 font-semibold text-slate-800"><%= customer.type %></span>
    <% if (customer.buildingName) { %>
      <div class="text-slate-600 text-[11px] mt-2">Objekti: <strong><%= customer.buildingName %></strong></div>
    <% } %>
  </div>
</div>

<!-- 3 Kartela Përmbledhëse -->
<div class="grid grid-cols-3 gap-4 mb-8 text-center">
  <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg">
    <span class="text-[10px] font-bold uppercase text-slate-500 tracking-wider block mb-1">GJITHSEJ FATURUAR</span>
    <div class="text-lg font-black font-mono text-slate-950"><%= formatCurrency(totalInvoiced) %></div>
    <span class="text-[10px] text-slate-500"><%= customer.invoices.length %> fatura</span>
  </div>
  <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg">
    <span class="text-[10px] font-bold uppercase text-emerald-700 tracking-wider block mb-1">GJITHSEJ PAGUAR</span>
    <div class="text-lg font-black font-mono text-emerald-700"><%= formatCurrency(totalPaid) %></div>
    <span class="text-[10px] text-emerald-600"><%= customer.payments.length %> pagesa</span>
  </div>
  <div class="p-3 <%= balanceDue > 0 ? 'bg-rose-50 border border-rose-200' : 'bg-slate-50 border border-slate-200' %> rounded-lg">
    <span class="text-[10px] font-bold uppercase <%= balanceDue > 0 ? 'text-rose-700' : 'text-slate-500' %> tracking-wider block mb-1">BORXHI I MBETUR (SALDO)</span>
    <div class="text-lg font-black font-mono <%= balanceDue > 0 ? 'text-rose-700' : 'text-slate-950' %>"><%= formatCurrency(balanceDue) %></div>
    <span class="text-[10px] <%= balanceDue > 0 ? 'text-rose-600' : 'text-slate-500' %>"><%= balanceDue > 0 ? 'Për likuidim' : 'Llogari e shlyer' %></span>
  </div>
</div>

<!-- Tabela e Faturave -->
<div class="mb-8">
  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2 border-b border-slate-300 pb-1">
    1. Faturat e Lëshuara
  </h4>
  <table class="w-full text-left text-xs border border-slate-300">
    <thead class="bg-slate-100 text-slate-800 font-bold uppercase text-[10px] border-b border-slate-300">
      <tr>
        <th class="p-2 border-r border-slate-300 w-28">Nr. Faturës</th>
        <th class="p-2 border-r border-slate-300 text-center w-24">Data</th>
        <th class="p-2 border-r border-slate-300 text-center w-24">Afati</th>
        <th class="p-2 border-r border-slate-300 text-right w-28">Totali (€)</th>
        <th class="p-2 border-r border-slate-300 text-right w-28">Paguar (€)</th>
        <th class="p-2 border-r border-slate-300 text-right w-28">Mbetja (€)</th>
        <th class="p-2 text-center w-20">Statusi</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% if (customer.invoices && customer.invoices.length > 0) { %>
        <% customer.invoices.forEach(inv => { %>
          <tr>
            <td class="p-2 font-mono font-bold text-slate-900 border-r border-slate-200"><%= inv.number %></td>
            <td class="p-2 text-center border-r border-slate-200 font-mono text-slate-700"><%= formatDate(inv.date) %></td>
            <td class="p-2 text-center border-r border-slate-200 font-mono text-slate-700"><%= formatDate(inv.dueDate) %></td>
            <td class="p-2 text-right font-mono font-bold text-slate-900 border-r border-slate-200"><%= formatCurrency(inv.total) %></td>
            <td class="p-2 text-right font-mono text-emerald-600 border-r border-slate-200"><%= formatCurrency(inv.paidAmount) %></td>
            <td class="p-2 text-right font-mono border-r border-slate-200 <%= inv.balanceDue > 0 ? 'text-rose-600 font-bold' : 'text-slate-500' %>">
              <%= formatCurrency(inv.balanceDue) %>
            </td>
            <td class="p-2 text-center text-[10px] font-bold"><%= inv.status %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="7" class="p-4 text-center text-slate-500">Nuk ka fatura.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Tabela e Pagesave të Pranuara -->
<div class="mb-8">
  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2 border-b border-slate-300 pb-1">
    2. Pagesat e Pranuara / Regjistruara
  </h4>
  <table class="w-full text-left text-xs border border-slate-300">
    <thead class="bg-slate-100 text-slate-800 font-bold uppercase text-[10px] border-b border-slate-300">
      <tr>
        <th class="p-2 border-r border-slate-300 w-28">Nr. Dëftesës</th>
        <th class="p-2 border-r border-slate-300 text-center w-24">Data</th>
        <th class="p-2 border-r border-slate-300 w-32">Mënyra</th>
        <th class="p-2 border-r border-slate-300">Numri Referues</th>
        <th class="p-2 text-right w-32">Shuma e Paguar (€)</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      <% if (customer.payments && customer.payments.length > 0) { %>
        <% customer.payments.forEach(p => { %>
          <tr>
            <td class="p-2 font-mono font-bold text-slate-900 border-r border-slate-200"><%= p.number %></td>
            <td class="p-2 text-center border-r border-slate-200 font-mono text-slate-700"><%= formatDate(p.date) %></td>
            <td class="p-2 border-r border-slate-200 text-slate-700"><%= p.paymentMethod %></td>
            <td class="p-2 border-r border-slate-200 font-mono text-slate-600"><%= p.referenceNumber || '-' %></td>
            <td class="p-2 text-right font-mono font-bold text-emerald-600"><%= formatCurrency(p.amount) %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="5" class="p-4 text-center text-slate-500">Nuk ka pagesa të regjistruara.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Nënshkrimet & Vula -->
<div class="grid grid-cols-2 gap-12 pt-8 text-xs text-center border-t border-slate-200">
  <div>
    <div class="font-bold text-slate-900 mb-14">Lëshuar nga KRONEER Sh.p.k. (Zyra e Financave)</div>
    <div class="border-t border-slate-400 pt-2 font-mono text-[11px] text-slate-600">Nënshkrimi & Vula e Autorizuar</div>
  </div>
  <div>
    <div class="font-bold text-slate-900 mb-14">Konfirmuar nga Klienti / Përfaqësuesi</div>
    <div class="border-t border-slate-400 pt-2 font-mono text-[11px] text-slate-600">Emri, Mbiemri & Nënshkrimi</div>
  </div>
</div>
