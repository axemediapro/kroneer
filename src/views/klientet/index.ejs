<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">MENAXHIMI I KLIENTËVE (CRM)</h1>
    <p class="text-xs text-slate-400 mt-1">Regjistri i përgjithshëm i klientëve, kompanive ndërtuese dhe objekteve</p>
  </div>
  <a href="/klientet/krijo" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
    <span>Shto Klient të Ri</span>
  </a>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/klientet" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me emër, kompani, kontakt, telefon..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
    </div>
    <div>
      <select name="type" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha llojet e klientëve</option>
        <% typesList.forEach(t => { %>
          <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex gap-2">
      <input type="text" name="city" value="<%= filters.city %>" placeholder="Qyteti (p.sh. Prishtinë, Tiranë)" class="flex-1 px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.type || filters.city) { %>
        <a href="/klientet" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Klientëve -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Kodi & Kompania</th>
          <th class="p-4">Lloji</th>
          <th class="p-4">Personi Kontaktues</th>
          <th class="p-4">Telefoni & Email</th>
          <th class="p-4">Objekti / Vendndodhja</th>
          <th class="p-4">Lifta</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (customers && customers.length > 0) { %>
          <% customers.forEach(c => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4">
                <a href="/klientet/<%= c.id %>" class="font-bold text-amber-400 hover:text-amber-300 block text-sm">
                  <%= c.companyName || (c.firstName + ' ' + (c.lastName || '')) %>
                </a>
                <span class="font-mono text-[10px] text-slate-500"><%= c.code %></span>
              </td>
              <td class="p-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                  <%= c.type %>
                </span>
              </td>
              <td class="p-4 font-medium text-slate-300">
                <%= c.contactPerson || '-' %>
              </td>
              <td class="p-4">
                <div class="text-slate-300 font-mono text-[11px]"><%= c.phone || '-' %></div>
                <div class="text-slate-500 text-[10px]"><%= c.email || '-' %></div>
              </td>
              <td class="p-4">
                <div class="text-slate-200 font-medium"><%= c.buildingName || '-' %></div>
                <div class="text-slate-500 text-[11px]"><%= c.city || '-' %>, <%= c.country || 'Kosovë' %></div>
              </td>
              <td class="p-4 font-mono font-bold text-amber-400">
                <%= c.elevatorsCount || 0 %>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick='openQuickView(<%- JSON.stringify({
                    title: c.companyName || `${c.firstName || ""} ${c.lastName || ""}`,
                    subtitle: `${c.code} • ${c.type}`,
                    statusLabel: c.city || "Kosovë",
                    statusClass: "bg-slate-800 text-slate-300 border-slate-700",
                    rows: [
                      { label: "Personi Kontaktues", value: c.contactPerson || "-" },
                      { label: "Telefoni", value: c.phone || "-" },
                      { label: "Email", value: c.email || "-" },
                      { label: "Objekti", value: c.buildingName || "-" },
                      { label: "Lifta", value: String(c.elevatorsCount || 0) }
                    ],
                    viewUrl: `/klientet/${c.id}`,
                    editUrl: `/klientet/${c.id}/ndrysho`,
                    printUrl: `/klientet/${c.id}/pasqyra-pdf`
                  }).replace(/</g, '\\u003c').replace(/'/g, '&#39;') %>)' class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 transition-colors" title="Pamje e Shpejtë">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                  </button>
                  <a href="/klientet/<%= c.id %>/ndrysho" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-blue-400 transition-colors" title="Ndrysho">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </a>
                  <a href="/klientet/<%= c.id %>/pasqyra-pdf" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 transition-colors" title="Printo Pasqyrën">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                  </a>
                  <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
                    <form action="/klientet/<%= c.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini klientin <%= c.companyName %>?');">
                      <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 transition-colors" title="Fshi Klientin">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="p-8 text-center text-slate-500">
              Nuk u gjet asnjë klient me këto kritere.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
