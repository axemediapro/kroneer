<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">NDRYSHO TË DHËNAT E KLIENTIT</h1>
    <p class="text-xs text-slate-400 mt-1"><%= customer.companyName %> (<%= customer.code %>)</p>
  </div>
  <a href="/klientet/<%= customer.id %>" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Kthehu te Profili
  </a>
</div>

<form action="/klientet/<%= customer.id %>/ndrysho" method="POST" class="space-y-6">
  
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Informacioni i Përgjithshëm
    </h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Lloji i Klientit *</label>
        <select name="type" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% typesList.forEach(t => { %>
            <option value="<%= t %>" <%= customer.type === t ? 'selected' : '' %>><%= t %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Grupi i Zbritjes *</label>
        <select name="discountGroup" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Standard" <%= customer.discountGroup === 'Standard' ? 'selected' : '' %>>Standard</option>
          <option value="Bronz" <%= customer.discountGroup === 'Bronz' ? 'selected' : '' %>>Bronz</option>
          <option value="Argjend" <%= customer.discountGroup === 'Argjend' ? 'selected' : '' %>>Argjend</option>
          <option value="Ar" <%= customer.discountGroup === 'Ar' ? 'selected' : '' %>>Ar</option>
          <option value="VIP/Partner" <%= customer.discountGroup === 'VIP/Partner' ? 'selected' : '' %>>VIP/Partner</option>
        </select>
      </div>

      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Kompanisë / Subjektit *</label>
        <input type="text" name="companyName" value="<%= customer.companyName || '' %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Përfaqësuesit</label>
        <input type="text" name="firstName" value="<%= customer.firstName || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Mbiemri i Përfaqësuesit</label>
        <input type="text" name="lastName" value="<%= customer.lastName || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Personi Kontaktues</label>
        <input type="text" name="contactPerson" value="<%= customer.contactPerson || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri Fiskal (NUI)</label>
        <input type="text" name="taxNumber" value="<%= customer.taxNumber || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Biznesit</label>
        <input type="text" name="businessNumber" value="<%= customer.businessNumber || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Telefoni</label>
        <input type="text" name="phone" value="<%= customer.phone || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Email</label>
        <input type="email" name="email" value="<%= customer.email || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Uebfaqja</label>
        <input type="text" name="website" value="<%= customer.website || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Shteti</label>
        <input type="text" name="country" value="<%= customer.country || 'Kosovë' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Qyteti</label>
        <input type="text" name="city" value="<%= customer.city || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Adresa e Selisë</label>
        <input type="text" name="address" value="<%= customer.address || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kodi Postar</label>
        <input type="text" name="postalCode" value="<%= customer.postalCode || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
    </div>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      2. Informacione mbi Objektin
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Objektit</label>
        <input type="text" name="buildingName" value="<%= customer.buildingName || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Adresa e Objektit</label>
        <input type="text" name="buildingAddress" value="<%= customer.buildingAddress || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Kateve</label>
        <input type="number" name="floorsCount" value="<%= customer.floorsCount || 0 %>" min="1" max="100" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Lifteve</label>
        <input type="number" name="elevatorsCount" value="<%= customer.elevatorsCount || 0 %>" min="1" max="50" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Arkitekti</label>
        <input type="text" name="architect" value="<%= customer.architect || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kompania Ndërtuese</label>
        <input type="text" name="builderCompany" value="<%= customer.builderCompany || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kontraktori Kryesor</label>
        <input type="text" name="mainContractor" value="<%= customer.mainContractor || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
    </div>

    <div class="mt-4">
      <label class="block text-xs font-semibold text-slate-300 mb-1">Shënime</label>
      <textarea name="notes" rows="3" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"><%= customer.notes || '' %></textarea>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <button type="button" onclick="if(confirm('A jeni i sigurt që dëshironi ta fshini këtë klient?')) document.getElementById('delete-cust-form').submit();" class="px-4 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-bold transition-all">
      Fshi Klientin
    </button>
    <div class="flex items-center gap-3">
      <a href="/klientet/<%= customer.id %>" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
        Anulo
      </a>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
        RUAJ NDRYSHIMET
      </button>
    </div>
  </div>

</form>

<form id="delete-cust-form" action="/klientet/<%= customer.id %>/fshi" method="POST" class="hidden"></form>
