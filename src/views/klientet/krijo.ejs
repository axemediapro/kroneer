<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">REGJISTRO KLIENT TË RI</h1>
    <p class="text-xs text-slate-400 mt-1">Plotësoni të dhënat e kompanisë, kontaktit dhe specifikave të objektit</p>
  </div>
  <a href="/klientet" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo dhe Kthehu
  </a>
</div>

<form action="/klientet/krijo" method="POST" class="space-y-6">
  
  <!-- 1. Të Dhënat e Kompanisë / Klientit -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      1. Informacioni i Përgjithshëm
    </h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Lloji i Klientit *</label>
        <select name="type" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% typesList.forEach(t => { %>
            <option value="<%= t %>"><%= t %></option>
          <% }); %>
        </select>
      </div>

      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Kompanisë / Subjektit *</label>
        <input type="text" name="companyName" required placeholder="p.sh. Albi Group Sh.p.k." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Përfaqësuesit</label>
        <input type="text" name="firstName" placeholder="Emri" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Mbiemri i Përfaqësuesit</label>
        <input type="text" name="lastName" placeholder="Mbiemri" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Personi Kontaktues</label>
        <input type="text" name="contactPerson" placeholder="p.sh. Ing. Sutki Aliu" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri Fiskal (NUI)</label>
        <input type="text" name="taxNumber" placeholder="p.sh. 330198234" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Biznesit</label>
        <input type="text" name="businessNumber" placeholder="p.sh. 81029384" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Telefoni</label>
        <input type="text" name="phone" placeholder="+383 44 123 456" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Email</label>
        <input type="email" name="email" placeholder="info@kompania.com" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Uebfaqja</label>
        <input type="text" name="website" placeholder="www.kompania.com" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Shteti</label>
        <input type="text" name="country" value="Kosovë" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Qyteti</label>
        <input type="text" name="city" placeholder="p.sh. Prishtinë" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Adresa e Selisë</label>
        <input type="text" name="address" placeholder="Rruga, Numri, Ndërtesa" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kodi Postar</label>
        <input type="text" name="postalCode" placeholder="10000" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
    </div>
  </div>

  <!-- 2. Informacione për Objektin (Building Details) -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>
      2. Informacione mbi Objektin & Projektin Ndërtimor
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i Objektit / Kompleksit</label>
        <input type="text" name="buildingName" placeholder="p.sh. Kompleksi Rezidencial Panorama Tower" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Adresa e Objektit</label>
        <input type="text" name="buildingAddress" placeholder="Vendndodhja e kantierit" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Kateve</label>
        <input type="number" name="floorsCount" value="6" min="1" max="100" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Numri i Lifteve të Kërkuar</label>
        <input type="number" name="elevatorsCount" value="1" min="1" max="50" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Arkitekti / Studio</label>
        <input type="text" name="architect" placeholder="p.sh. Studio Moderna Arch" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kompania Ndërtuese</label>
        <input type="text" name="builderCompany" placeholder="p.sh. Grand Bau" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kontraktori Kryesor</label>
        <input type="text" name="mainContractor" placeholder="p.sh. Albi Group" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
    </div>

    <div class="mt-4">
      <label class="block text-xs font-semibold text-slate-300 mb-1">Shënime & Kërkesa Speciale</label>
      <textarea name="notes" rows="3" placeholder="Shënime shtesë mbi objektin, specifikacionet e boshtit ose kërkesat e veçanta teknike..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"></textarea>
    </div>
  </div>

  <!-- Butonat e Veprimit -->
  <div class="flex items-center justify-end gap-3">
    <a href="/klientet" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
      RUAJ KLIENTIN
    </button>
  </div>

</form>
