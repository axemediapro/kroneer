<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">PROFATURAT ME ETAPA</h1>
    <p class="text-xs text-slate-400 mt-1">Struktura e kësteve dhe pagesave sipas ecurisë së projektit (30% / 40% / 20% / 10%)</p>
  </div>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/profaturat" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me numër profature, klient..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
    </div>
    <div>
      <select name="status" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha statuset</option>
        <option value="Në Pritje" <%= filters.status === 'Në Pritje' ? 'selected' : '' %>>Në Pritje</option>
        <option value="Pjesërisht e paguar" <%= filters.status === 'Pjesërisht e paguar' ? 'selected' : '' %>>Pjesërisht e paguar</option>
        <option value="Paguar" <%= filters.status === 'Paguar' ? 'selected' : '' %>>Paguar</option>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.status) { %>
        <a href="/profaturat" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Profaturave -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Numri i Profaturës</th>
          <th class="p-4">Klienti</th>
          <th class="p-4">Data & Afati</th>
          <th class="p-4">Totali</th>
          <th class="p-4">Paguar Aktualisht</th>
          <th class="p-4">Etapat e Pagesës</th>
          <th class="p-4">Statusi</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (proformas && proformas.length > 0) { %>
          <% proformas.forEach(pf => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4 font-mono font-bold text-amber-400">
                <a href="/profaturat/<%= pf.id %>" class="hover:underline"><%= pf.number %></a>
              </td>
              <td class="p-4 font-bold text-slate-200">
                <%= pf.customer.companyName %>
              </td>
              <td class="p-4 text-slate-300">
                <div><%= formatDate(pf.date) %></div>
                <div class="text-[10px] text-slate-500">Afati: <%= formatDate(pf.dueDate) %></div>
              </td>
              <td class="p-4 font-mono font-bold text-slate-100 text-sm">
                <%= formatCurrency(pf.totalAmount) %>
              </td>
              <td class="p-4 font-mono font-bold text-emerald-400">
                <%= formatCurrency(pf.paidAmount) %>
              </td>
              <td class="p-4">
                <div class="flex items-center gap-1">
                  <% pf.items.forEach(it => { %>
                    <span title="<%= it.description %>: <%= it.isPaid ? 'PAGUAR' : 'NË PRITJE' %>" class="w-3 h-3 rounded-full <%= it.isPaid ? 'bg-emerald-400' : 'bg-slate-700' %>"></span>
                  <% }); %>
                  <span class="text-[10px] text-slate-400 ml-1.5"><%= pf.items.filter(i => i.isPaid).length %>/<%= pf.items.length %> Etapa</span>
                </div>
              </td>
              <td class="p-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold <%= pf.status === 'Paguar' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30' %>">
                  <%= pf.status %>
                </span>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <a href="/profaturat/<%= pf.id %>" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors" title="Shiko Detajet dhe Etapat">
                    Shiko
                  </a>
                  <a href="/profaturat/<%= pf.id %>/ndrysho" class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-semibold border border-amber-500/30 transition-colors" title="Ndrysho Profaturën">
                    Ndrysho
                  </a>
                  <form action="/profaturat/<%= pf.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini profaturën <%= pf.number %>?');">
                    <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-500/40 transition-colors" title="Fshi Profaturën">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                  <a href="/profaturat/<%= pf.id %>/print" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 transition-colors" title="Printo Profaturën">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="p-8 text-center text-slate-500">Nuk u gjet asnjë profaturë.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
