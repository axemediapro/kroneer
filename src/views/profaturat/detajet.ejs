<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono"><%= proforma.number %></h1>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30">
        <%= proforma.status %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Klienti: <strong class="text-slate-200"><%= proforma.customer.companyName %></strong> • Data: <%= formatDate(proforma.date) %></p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <a href="/profaturat/<%= proforma.id %>/ndrysho" class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span>Ndrysho</span>
    </a>
    <a href="/profaturat/<%= proforma.id %>/print" target="_blank" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Printo</span>
    </a>
    <form action="/profaturat/<%= proforma.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini profaturën <%= proforma.number %>? Ky veprim nuk mund të kthehet.');">
      <button type="submit" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Fshi</span>
      </button>
    </form>
  </div>
</div>

<!-- Progresi i Pagesave të Etapave -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
  <div class="flex items-center justify-between mb-2">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-300">PROGRESI I PAGESAVE TË ETAPAVE</span>
    <span class="text-sm font-mono font-black text-amber-400"><%= progressPercent %>% (<%= formatCurrency(totalPaidMilestones) %> / <%= formatCurrency(proforma.totalAmount) %>)</span>
  </div>
  <div class="w-full h-3 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
    <div class="h-full bg-gradient-to-r from-amber-500 to-emerald-500 rounded-full transition-all duration-500" style="width: <%= progressPercent %>%;"></div>
  </div>
</div>

<!-- Karta e Etapave të Pagesës -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl mb-6">
  <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
    Etapat e Strukturuara të Financimit të Projektit
  </h3>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% proforma.items.forEach(item => { %>
      <div class="p-5 rounded-xl border <%= item.isPaid ? 'border-emerald-500/40 bg-emerald-500/5' : 'border-slate-800 bg-slate-950' %> flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold px-2.5 py-0.5 rounded <%= item.isPaid ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-800 text-amber-400' %>">
              <%= item.percentage %>% E VLERËS
            </span>
            <span class="text-xs font-bold uppercase <%= item.isPaid ? 'text-emerald-400' : 'text-amber-400' %>">
              <%= item.isPaid ? '✓ PAGUAR' : '⏳ NË PRITJE' %>
            </span>
          </div>

          <h4 class="text-sm font-bold text-slate-100 mb-1"><%= item.description %></h4>
          <div class="text-xl font-black font-mono text-slate-100 mt-2"><%= formatCurrency(item.amount) %></div>
          <% if (item.isPaid && item.paidAt) { %>
            <div class="text-[10px] text-emerald-500 mt-1">Likuiduar më: <%= formatDate(item.paidAt) %></div>
          <% } %>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
          <form action="/profaturat/<%= proforma.id %>/milestone" method="POST">
            <input type="hidden" name="itemId" value="<%= item.id %>">
            <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all <%= item.isPaid ? 'bg-slate-800 hover:bg-slate-700 text-slate-300' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-md' %>">
              <%= item.isPaid ? 'Shëno si të Papaguar' : 'Shëno si të Paguar (Likuiduar)' %>
            </button>
          </form>

          <% if (!item.isPaid) { %>
            <a href="/pagesat/krijo?customerId=<%= proforma.customerId %>&amount=<%= item.amount %>" class="text-xs text-amber-400 hover:text-amber-300 font-semibold">
              Regjistro Pagesë &rarr;
            </a>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>

  <% if (proforma.notes) { %>
    <div class="mt-6 p-4 rounded-xl bg-slate-950/60 border border-slate-800 text-xs text-slate-300">
      <span class="text-amber-400 font-bold block mb-1">Shënime:</span>
      <p class="leading-relaxed"><%= proforma.notes %></p>
    </div>
  <% } %>
</div>
