<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">MENAXHIMI I PROJEKTEVE</h1>
    <p class="text-xs text-slate-400 mt-1">Ndjekja e fazave nga planifikimi deri te dorëzimi teknik dhe kolaudimi</p>
  </div>
  <a href="/projektet/krijo" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    <span>Hap Projekt të Ri</span>
  </a>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/projektet" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me emër projekti, klient..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
    </div>
    <div>
      <select name="stage" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha fazat</option>
        <% stages.forEach(st => { %>
          <option value="<%= st %>" <%= filters.stage === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.stage) { %>
        <a href="/projektet" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Projekteve -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Numri & Emri i Projektit</th>
          <th class="p-4">Klienti</th>
          <th class="p-4">Lifta / Kate</th>
          <th class="p-4">Vlera Totale</th>
          <th class="p-4">Faza Aktuale</th>
          <th class="p-4">Afati i Përfundimit</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (projects && projects.length > 0) { %>
          <% projects.forEach(prj => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4">
                <a href="/projektet/<%= prj.id %>" class="font-bold text-slate-100 hover:text-amber-400 block text-sm">
                  <%= prj.name %>
                </a>
                <span class="font-mono text-[10px] text-amber-400"><%= prj.number %></span>
              </td>
              <td class="p-4">
                <a href="/klientet/<%= prj.customer.id %>" class="font-medium text-slate-300 hover:text-amber-400 block">
                  <%= prj.customer.companyName %>
                </a>
                <span class="text-[10px] text-slate-500"><%= prj.customer.city || 'Kosovë' %></span>
              </td>
              <td class="p-4 font-mono text-slate-300">
                <span class="font-bold text-amber-400"><%= prj.elevatorCount %> Lifta</span> • <%= prj.floorsCount %> Kate
              </td>
              <td class="p-4 font-mono font-bold text-slate-100 text-sm">
                <%= formatCurrency(prj.value) %>
              </td>
              <td class="p-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                  <%= prj.stage %>
                </span>
              </td>
              <td class="p-4 font-mono text-slate-300">
                <%= formatDate(prj.targetCompletionDate) %>
              </td>
              <td class="p-4 text-right">
                <a href="/projektet/<%= prj.id %>" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700">
                  Hap Projektin
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="p-8 text-center text-slate-500">Nuk u gjet asnjë projekt.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
