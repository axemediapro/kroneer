<div class="space-y-6">
  <!-- Header & Stage Bar -->
  <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3 mb-2 flex-wrap">
          <span class="px-3 py-1 text-xs font-bold rounded-lg bg-amber-500/15 text-amber-400 border border-amber-500/30 font-mono">
            <%= project.number %>
          </span>
          <span class="px-3 py-1 text-xs font-bold uppercase rounded-full bg-slate-800 text-slate-200 border border-slate-700">
            Faza: <%= project.stage %>
          </span>
          <% if (project.projectManager) { %>
            <span class="px-3 py-1 text-xs font-bold rounded-lg bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              Menaxher: <%= project.projectManager.fullName %>
            </span>
          <% } %>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight"><%= project.name %></h1>
        <p class="text-xs text-slate-400 mt-1">
          Klienti: <a href="/klientet/<%= project.customerId %>" class="font-bold text-amber-400 hover:underline"><%= project.customer.companyName || project.customer.firstName %></a> 
          • Filluar më: <%= formatDate(project.startDate) %>
        </p>
      </div>

      <!-- Change Stage & Actions -->
      <div class="flex items-center gap-2 flex-wrap">
        <form action="/projektet/<%= project.id %>/faza" method="POST" class="flex items-center space-x-2 bg-slate-950/80 p-2 rounded-xl border border-slate-800">
          <label class="text-xs font-bold text-slate-300 whitespace-nowrap pl-2">Faza:</label>
          <select name="stage" class="text-xs px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-100 font-medium focus:outline-none focus:border-amber-400">
            <% stages.forEach(st => { %>
              <option value="<%= st %>" <%= project.stage === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
          <button type="submit" class="px-3 py-1.5 text-xs font-bold text-slate-950 bg-amber-500 hover:bg-amber-400 rounded-lg transition shadow-md">
            Ruaj
          </button>
        </form>

        <a href="/intervenimet/krijo?projectId=<%= project.id %>" class="px-3.5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs shadow-md shadow-cyan-600/20 transition-all flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>+ Regjistro Intervenim</span>
        </a>
      </div>
    </div>

    <!-- 9-Stage Progress Pipeline -->
    <div class="mt-8 pt-6 border-t border-slate-800">
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-2">
        <% 
          const stageOrder = ['Planifikim', 'Inxhinieri', 'Prodhim', 'Transport', 'Instalim', 'Testim', 'Inspektim', 'Dorëzim', 'Përfunduar'];
          const currentIdx = stageOrder.indexOf(project.stage);
        %>
        <% stageOrder.forEach((st, idx) => { 
          const isPassed = idx < currentIdx;
          const isCurrent = idx === currentIdx;
        %>
          <div class="text-center">
            <div class="h-2 rounded-full mb-2 <%= isCurrent ? 'bg-amber-500 shadow-md shadow-amber-500/20' : (isPassed ? 'bg-emerald-500' : 'bg-slate-800') %>"></div>
            <span class="text-[10px] font-mono <%= isCurrent ? 'text-amber-400 font-black' : (isPassed ? 'text-emerald-400' : 'text-slate-500') %>">
              <%= st %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Key Metrics & Overview -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 shadow-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Vlera e Projektit</span>
      <div class="text-2xl font-black text-amber-400 font-mono"><%= formatCurrency(project.value) %></div>
    </div>
    <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 shadow-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Numri i Lifteve</span>
      <div class="text-2xl font-black text-slate-100 font-mono"><%= project.elevatorCount %> Lifta</div>
    </div>
    <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 shadow-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Kate / Ndalesa</span>
      <div class="text-2xl font-black text-slate-100 font-mono"><%= project.floorsCount %> Kate</div>
    </div>
    <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 shadow-xl">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Ekipi i Monterëve</span>
      <div class="text-2xl font-black text-cyan-400 font-mono"><%= project.teamMembers ? project.teamMembers.length : 0 %> Monterë</div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left 2 Columns: EKIPET, INTERVENIMET & INSTALIMET -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- 1. EKIPET E MONTERËVE / PUNËTORËVE TË KËTIJ PROJEKTI -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <h2 class="text-base font-bold text-slate-100 font-mono">Ekipi i Punëtorëve & Monterëve të Projektit (<%= project.teamMembers.length %>)</h2>
          </div>
          
          <button type="button" onclick="document.getElementById('modal-shto-antar').classList.remove('hidden')" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            <span>+ Shto Monter në Ekip</span>
          </button>
        </div>

        <% if (project.teamMembers && project.teamMembers.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% project.teamMembers.forEach(tm => { %>
              <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 flex items-center justify-between">
                <div>
                  <a href="/puntoret/<%= tm.employee.id %>" class="font-bold text-sm text-slate-100 hover:text-amber-400 block">
                    <%= tm.employee.firstName %> <%= tm.employee.lastName %>
                  </a>
                  <span class="text-[11px] text-slate-400 font-mono"><%= tm.employee.code %> • <%= tm.employee.position %></span>
                  <div class="mt-1">
                    <span class="px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-300 font-mono text-[10px] font-bold border border-amber-500/30">
                      <%= tm.roleInProject || 'Monter' %>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <a href="/puntoret/<%= tm.employee.id %>" title="Profili & Financat" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs">
                    Profili →
                  </a>
                  <form action="/projektet/<%= project.id %>/ekipi/<%= tm.id %>/fshi" method="POST" onsubmit="return confirm('A jeni të sigurt që dëshironi ta hiqni këtë punëtor nga ekipi i projektit?');">
                    <button type="submit" title="Hiq nga Ekipi" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 transition-colors">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-6 text-center text-slate-500 text-xs bg-slate-950/40 rounded-xl border border-slate-800/60">
            Nuk ka ende monterë të caktuar në ekipin e këtij projekti. Klikoni "Shto Monter në Ekip" për të caktuar stafin.
          </div>
        <% } %>
      </div>

      <!-- 2. INTERVENIMET NË TERREN (Me Ekipin e Saktë) -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
            <h2 class="text-base font-bold text-slate-100 font-mono">Intervenimet & Punimet në Terren (<%= project.interventions ? project.interventions.length : 0 %>)</h2>
          </div>
          
          <a href="/intervenimet/krijo?projectId=<%= project.id %>" class="px-3 py-1.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            <span>+ Regjistro Intervenim</span>
          </a>
        </div>

        <% if (project.interventions && project.interventions.length > 0) { %>
          <div class="space-y-3">
            <% project.interventions.forEach(inv => { %>
              <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 hover:border-cyan-500/40 transition-colors">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <div>
                    <a href="/intervenimet/<%= inv.id %>" class="font-bold text-sm text-slate-100 hover:text-cyan-400 block">
                      <%= inv.title %>
                    </a>
                    <span class="text-[10px] text-amber-400 font-mono"><%= inv.number %> • <%= inv.type %> • Data: <%= formatDate(inv.date) %></span>
                  </div>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= inv.status === 'Përfunduar' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30' %>">
                    <%= inv.status %>
                  </span>
                </div>

                <!-- Cila ekipë ishte në këtë intervenim -->
                <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-slate-500 text-[11px] font-semibold">Ekipi që ishte prezent:</span>
                    <% if (inv.teamWorkers && inv.teamWorkers.length > 0) { %>
                      <% inv.teamWorkers.forEach(tw => { %>
                        <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-200 font-mono text-[10px] border border-slate-700">
                          <%= tw.employee.firstName %> <%= tw.employee.lastName %> (<%= tw.roleInTeam %>)
                        </span>
                      <% }); %>
                    <% } else { %>
                      <span class="text-slate-500 text-[10px] italic">I pa regjistruar</span>
                    <% } %>
                  </div>

                  <a href="/intervenimet/<%= inv.id %>" class="text-cyan-400 hover:underline font-bold text-xs ml-2 shrink-0">
                    Detajet e Intervenimit →
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-6 text-center text-slate-500 text-xs bg-slate-950/40 rounded-xl border border-slate-800/60">
            Nuk ka ende intervenime të regjistruara për këtë projekt.
          </div>
        <% } %>
      </div>

      <!-- 3. Instalimet e Lifteve -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            <h2 class="text-base font-bold text-slate-100 font-mono">Instalimet e Lifteve (<%= project.installations.length %>)</h2>
          </div>
          <a href="/instalimet/krijo?projectId=<%= project.id %>" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            <span>+ Shto Instalim</span>
          </a>
        </div>

        <% if (project.installations.length === 0) { %>
          <div class="text-center py-6 text-slate-500 text-xs">
            Nuk ka ende instalime të regjistruara për këtë projekt.
          </div>
        <% } else { %>
          <div class="space-y-3">
            <% project.installations.forEach(inst => { %>
              <div class="border border-slate-800 rounded-xl p-4 bg-slate-950/60">
                <div class="flex items-center justify-between mb-2">
                  <div>
                    <a href="/instalimet/<%= inst.id %>" class="text-sm font-bold text-slate-100 hover:text-amber-400">
                      <%= inst.elevatorModel %>
                    </a>
                    <span class="text-xs font-mono text-slate-400 ml-2">SN: <%= inst.serialNumber %></span>
                  </div>
                  <span class="px-2.5 py-0.5 text-[10px] font-bold rounded-full <%= inst.status === 'Përfunduar' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-cyan-500/20 text-cyan-300' %>">
                    <%= inst.status %>
                  </span>
                </div>
                <div class="space-y-1.5">
                  <div class="flex justify-between text-xs text-slate-400">
                    <span>Progresi i instalimit</span>
                    <span class="font-bold text-slate-200"><%= inst.progressPercent %>%</span>
                  </div>
                  <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                    <div class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: <%= inst.progressPercent %>%"></div>
                  </div>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
                  <span>Përgjegjës: <%= inst.teamLead || 'Ekipi KRONEER' %></span>
                  <a href="/instalimet/<%= inst.id %>" class="text-amber-400 font-bold hover:underline">
                    Hap Listën e Kontrollit (13 Pika) →
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Right 1 Column: MENAXHERI, KLIENTI, FINANCAT & SHËNIME -->
    <div class="space-y-6">
      
      <!-- Menaxheri i Projektit -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-3 text-xs">
        <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Menaxheri i Projektit</span>
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        </h3>

        <form action="/projektet/<%= project.id %>/menaxheri" method="POST" class="space-y-2">
          <select name="projectManagerId" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-medium focus:outline-none focus:border-cyan-400">
            <option value="">-- Pa Menaxher të Caktuar --</option>
            <% if (typeof managers !== 'undefined' && managers) { %>
              <% managers.forEach(m => { %>
                <option value="<%= m.id %>" <%= project.projectManagerId === m.id ? 'selected' : '' %>><%= m.fullName %> (<%= m.role %>)</option>
              <% }); %>
            <% } %>
          </select>
          <button type="submit" class="w-full py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-lg text-xs transition">
            Përditëso Menaxherin
          </button>
        </form>
      </div>

      <!-- Informacione për Objektin -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-3 text-xs">
        <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2">Informacione për Objektin</h3>
        <div class="space-y-2 text-xs">
          <div>
            <span class="text-[10px] text-slate-500 block uppercase">Objekti:</span>
            <span class="font-bold text-slate-200"><%= project.customer.buildingName || project.name %></span>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 block uppercase">Adresa e Objektit:</span>
            <span class="text-slate-300"><%= project.customer.buildingAddress || project.customer.address || '-' %></span>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 block uppercase">Personi Kontaktues:</span>
            <span class="text-slate-300 font-mono"><%= project.customer.contactPerson || '-' %> (<%= project.customer.phone || '-' %>)</span>
          </div>
        </div>
      </div>

      <!-- Linked Contract -->
      <% if (project.contract) { %>
        <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl">
          <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider mb-2">Kontrata e Ndërlidhur</h3>
          <div class="p-3 bg-slate-950/80 border border-slate-800 rounded-xl">
            <div class="flex items-center justify-between">
              <span class="font-bold font-mono text-amber-400"><%= project.contract.number %></span>
              <span class="font-bold text-slate-200"><%= formatCurrency(project.contract.value) %></span>
            </div>
            <a href="/kontratat/<%= project.contract.id %>" class="mt-2 block text-xs font-bold text-amber-400 hover:underline">
              Shiko Kontratën →
            </a>
          </div>
        </div>
      <% } %>

      <!-- Shënime -->
      <% if (project.notes) { %>
        <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl">
          <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider mb-2">Shënime & Specifikime</h3>
          <p class="text-xs text-slate-400 leading-relaxed whitespace-pre-line">
            <%= project.notes %>
          </p>
        </div>
      <% } %>

    </div>
  </div>
</div>

<!-- Modal: Shto Anëtar / Monter në Ekipin e Projektit -->
<div id="modal-shto-antar" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h3 class="text-sm font-bold text-slate-100 uppercase tracking-wider flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        Shto Monter në Ekipin e Projektit
      </h3>
      <button type="button" onclick="document.getElementById('modal-shto-antar').classList.add('hidden')" class="text-slate-400 hover:text-slate-200">
        ✕
      </button>
    </div>

    <form action="/projektet/<%= project.id %>/ekipi" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block text-slate-400 font-semibold mb-1">Përzgjidh Punëtorin / Monterin *</label>
        <select name="employeeId" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
          <option value="">-- Zgjidh Punëtorin --</option>
          <% if (typeof availableEmployees !== 'undefined' && availableEmployees) { %>
            <% availableEmployees.forEach(e => { %>
              <option value="<%= e.id %>"><%= e.firstName %> <%= e.lastName %> (<%= e.code %>) - <%= e.position %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div>
        <label class="block text-slate-400 font-semibold mb-1">Roli në këtë Projekt *</label>
        <select name="roleInProject" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
          <option value="Kryemonter">Kryemonter (Team Leader)</option>
          <option value="Teknik Montimi" selected>Teknik Montimi</option>
