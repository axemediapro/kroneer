<div class="space-y-6">
  <!-- Header & Stage Bar -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3 mb-2">
          <span class="px-3 py-1 text-xs font-bold rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-400 font-mono">
            <%= project.number %>
          </span>
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-700 text-slate-800 dark:text-slate-200">
            Faza: <%= project.stage %>
          </span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= project.name %></h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Klienti: <a href="/klientet/<%= project.customerId %>" class="font-medium text-amber-600 hover:underline"><%= project.customer.companyName %></a> 
          • Filluar më: <%= new Date(project.startDate).toLocaleDateString('sq-AL') %>
        </p>
      </div>

      <!-- Change Stage Form -->
      <form action="/projektet/<%= project.id %>/faza" method="POST" class="flex items-center space-x-2 bg-slate-50 dark:bg-slate-900/80 p-2 rounded-xl border border-slate-200 dark:border-slate-700">
        <label class="text-xs font-bold text-slate-600 dark:text-slate-300 whitespace-nowrap pl-2">Ndrysho Fazën:</label>
        <select name="stage" class="text-xs px-3 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <% stages.forEach(st => { %>
            <option value="<%= st %>" <%= project.stage === st ? 'selected' : '' %>><%= st %></option>
          <% }) %>
        </select>
        <button type="submit" class="px-3 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 rounded-lg transition">
          Ruaj
        </button>
      </form>
    </div>

    <!-- 9-Stage Progress Pipeline -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-700/60">
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-2">
        <% 
          const stageOrder = ['Planifikim', 'Inxhinieri', 'Prodhim', 'Transport', 'Instalim', 'Testim', 'Inspektim', 'Dorëzim', 'Përfunduar'];
          const currentIdx = stageOrder.indexOf(project.stage);
        %>
        <% stageOrder.forEach((st, idx) => { 
          const isPassed = idx < currentIdx;
          const isCurrent = idx === currentIdx;
        %>
          <div class="text-center">
            <div class="h-2 rounded-full mb-2 <%= isCurrent ? 'bg-amber-500 shadow-md shadow-amber-500/20' : (isPassed ? 'bg-emerald-500' : 'bg-slate-200 dark:bg-slate-700') %>"></div>
            <span class="text-[11px] font-medium <%= isCurrent ? 'text-amber-600 dark:text-amber-400 font-bold' : (isPassed ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-400 dark:text-slate-500') %>">
              <%= st %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Key Metrics & Overview -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Vlera e Projektit</span>
      <div class="text-2xl font-bold text-slate-900 dark:text-white mt-1">€<%= (project.value || 0).toLocaleString('de-DE') %></div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Numri i Lifteve</span>
      <div class="text-2xl font-bold text-slate-900 dark:text-white mt-1"><%= project.elevatorCount %> Lifta</div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Kate / Ndalesa</span>
      <div class="text-2xl font-bold text-slate-900 dark:text-white mt-1"><%= project.floorsCount %> Kate</div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Afati i Synuar</span>
      <div class="text-lg font-bold text-slate-900 dark:text-white mt-2">
        <%= project.targetCompletionDate ? new Date(project.targetCompletionDate).toLocaleDateString('sq-AL') : 'I papërcaktuar' %>
      </div>
    </div>
  </div>

  <!-- Main Tabs / Sections -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left 2 Cols: Installations & Handover -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Installations in this project -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <i data-lucide="wrench" class="w-5 h-5 text-amber-500"></i>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Instalimet e Lifteve (<%= project.installations.length %>)</h2>
          </div>
          <a href="/instalimet/krijo?projectId=<%= project.id %>" class="px-3 py-1.5 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition flex items-center">
            <i data-lucide="plus" class="w-3.5 h-3.5 mr-1"></i> Shto Instalim
          </a>
        </div>

        <% if (project.installations.length === 0) { %>
          <div class="text-center py-8 text-slate-400 text-sm">
            Nuk ka ende instalime të regjistruara për këtë projekt.
          </div>
        <% } else { %>
          <div class="space-y-4">
            <% project.installations.forEach(inst => { %>
              <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-4 hover:border-amber-400 transition bg-slate-50/50 dark:bg-slate-900/40">
                <div class="flex items-center justify-between mb-2">
                  <div>
                    <a href="/instalimet/<%= inst.id %>" class="text-sm font-bold text-slate-900 dark:text-white hover:text-amber-600">
                      <%= inst.elevatorModel %>
                    </a>
                    <span class="text-xs font-mono text-slate-500 dark:text-slate-400 ml-2">SN: <%= inst.serialNumber %></span>
                  </div>
                  <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full <%= inst.status === 'Përfunduar' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400' : 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-400' %>">
                    <%= inst.status %>
                  </span>
                </div>
                <div class="space-y-1.5">
                  <div class="flex justify-between text-xs text-slate-500">
                    <span>Progresi i instalimit</span>
                    <span class="font-bold text-slate-800 dark:text-slate-200"><%= inst.progressPercent %>%</span>
                  </div>
                  <div class="w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                    <div class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: <%= inst.progressPercent %>%"></div>
                  </div>
                </div>
                <div class="mt-3 flex items-center justify-between text-xs text-slate-500">
                  <span>Përgjegjës: <%= inst.teamLead %></span>
                  <a href="/instalimet/<%= inst.id %>" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline flex items-center">
                    Hap Listën e Kontrollit (13 Pika) <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-1"></i>
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Handover Protocols -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <i data-lucide="file-check" class="w-5 h-5 text-emerald-500"></i>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Procesverbalet e Dorëzimit (<%= project.handovers.length %>)</h2>
          </div>
          <a href="/dorezimi/krijo?projectId=<%= project.id %>" class="px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition flex items-center">
            <i data-lucide="plus" class="w-3.5 h-3.5 mr-1"></i> Krijo Procesverbal
          </a>
        </div>

        <% if (project.handovers.length === 0) { %>
          <div class="text-center py-6 text-slate-400 text-sm">
            Nuk është kryer ende dorëzimi teknik zyrtar.
          </div>
        <% } else { %>
          <div class="space-y-3">
            <% project.handovers.forEach(h => { %>
              <div class="flex items-center justify-between p-3.5 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-900/50">
                <div>
                  <div class="font-bold text-sm text-slate-900 dark:text-white"><%= h.elevatorModel %> (SN: <%= h.serialNumber %>)</div>
                  <div class="text-xs text-slate-500 mt-0.5">
                    Data: <%= new Date(h.handoverDate).toLocaleDateString('sq-AL') %> • Nënshkruar nga: <%= h.clientSigneeName %>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <a href="/dorezimi/<%= h.id %>" class="px-2.5 py-1 text-xs font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 rounded hover:bg-slate-200">
                    Shiko
                  </a>
                  <a href="/dorezimi/<%= h.id %>/print" target="_blank" class="px-2.5 py-1 text-xs font-medium text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 rounded hover:bg-amber-100">
                    Printo PDF
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right 1 Col: Contract, Financials & Notes -->
    <div class="space-y-6">
      <!-- Client & Building Info -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Informacione për Objektin</h3>
        <div class="space-y-2.5 text-sm">
          <div>
            <span class="text-xs text-slate-400 block">Objekti:</span>
            <span class="font-medium text-slate-900 dark:text-white"><%= project.customer.buildingName || project.name %></span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Adresa e Objektit:</span>
            <span class="text-slate-700 dark:text-slate-300"><%= project.customer.buildingAddress || project.customer.address || '-' %></span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Personi Kontaktues:</span>
            <span class="text-slate-700 dark:text-slate-300"><%= project.customer.contactPerson %> (<%= project.customer.phone %>)</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Arkitekti / Kontraktori:</span>
            <span class="text-slate-700 dark:text-slate-300"><%= project.customer.architect || project.customer.mainContractor || 'I pa regjistruar' %></span>
          </div>
        </div>
      </div>

      <!-- Linked Contract -->
      <% if (project.contract) { %>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Kontrata e Ndërlidhur</h3>
          <div class="p-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 rounded-lg">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-amber-900 dark:text-amber-300"><%= project.contract.number %></span>
              <span class="text-xs font-semibold text-amber-700 dark:text-amber-400">€<%= (project.contract.totalValue || 0).toLocaleString('de-DE') %></span>
            </div>
            <div class="mt-2 text-xs text-amber-800 dark:text-amber-400">
              Garancia: <%= project.contract.warrantyMonths %> Muaj
            </div>
            <a href="/kontratat/<%= project.contract.id %>" class="mt-3 block text-center text-xs font-bold text-amber-700 hover:text-amber-800 dark:text-amber-300 underline">
              Shiko Detajet e Kontratës →
            </a>
          </div>
        </div>
      <% } %>

      <!-- Notes -->
      <% if (project.notes) { %>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-2">Shënime & Kërkesa Teknike</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-line">
            <%= project.notes %>
          </p>
        </div>
      <% } %>
    </div>
  </div>
</div>
