<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">NDRYSHO MODELIN E LIFTIT</h1>
    <p class="text-xs text-slate-400 mt-1"><%= elevator.model %> (<%= elevator.code %>)</p>
  </div>
  <div class="flex items-center gap-2">
    <a href="/lifts/<%= elevator.id %>" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <form action="/lifts/<%= elevator.id %>/fshi" method="POST" onsubmit="return confirm('A jeni i sigurt që doni ta fshini këtë model nga katalogu? Ky veprim nuk mund të kthehet.');">
      <button type="submit" class="px-4 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 font-semibold text-xs border border-rose-500/30 transition-all">
        Fshi Modelin
      </button>
    </form>

  </div>
</div>

<form action="/lifts/<%= elevator.id %>/ndrysho" method="POST" class="space-y-6">

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Informacioni i Përgjithshëm
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kodi i Modelit *</label>
        <input type="text" name="code" required value="<%= elevator.code %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono uppercase">
      </div>
      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Emri i Modelit *</label>
        <input type="text" name="model" required value="<%= elevator.model %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lloji i Liftit *</label>
        <select name="type" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% types.forEach(t => { %>
            <option value="<%= t %>" <%= elevator.type === t ? 'selected' : '' %>><%= t %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Aktiv" <%= elevator.status === 'Aktiv' ? 'selected' : '' %>>Aktiv</option>
          <option value="Joaktiv" <%= elevator.status === 'Joaktiv' ? 'selected' : '' %>>Joaktiv</option>
        </select>
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Çmimi Bazë (€) *</label>
        <input type="number" step="0.01" name="basePrice" required value="<%= elevator.basePrice %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div class="sm:col-span-3">
        <label class="block font-semibold text-slate-300 mb-1">Përshkrimi</label>
        <textarea name="description" rows="2" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"><%= elevator.description || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      2. Specifikimet Teknike
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kapaciteti (KG)</label>
        <input type="number" name="capacityKg" value="<%= elevator.capacityKg %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Personave</label>
        <input type="number" name="personsCount" value="<%= elevator.personsCount %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Shpejtësia (m/s)</label>
        <input type="number" step="0.01" name="speed" value="<%= elevator.speed %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Kateve</label>
        <input type="number" name="floorsCount" value="<%= elevator.floorsCount %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Ndalesave</label>
        <input type="number" name="stopsCount" value="<%= elevator.stopsCount %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lloji i Motorit</label>
        <input type="text" name="motorType" value="<%= elevator.motorType %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Lëvizjes</label>
        <input type="text" name="driveSystem" value="<%= elevator.driveSystem %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Tipi i Dyerve</label>
        <input type="text" name="doorType" value="<%= elevator.doorType %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Fuqia e Motorit (kW)</label>
        <input type="number" step="0.1" name="motorPower" value="<%= elevator.motorPower %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Dimensionet e Kabinës</label>
        <input type="text" name="cabinDimensions" value="<%= elevator.cabinDimensions || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Dimensionet e Boshtit</label>
        <input type="text" name="shaftDimensions" value="<%= elevator.shaftDimensions || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Thellësia e Gropës (mm)</label>
        <input type="number" name="pitDepth" value="<%= elevator.pitDepth %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lartësia e Sipërme (mm)</label>
        <input type="number" name="headroomHeight" value="<%= elevator.headroomHeight %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Furnizimi Elektrik</label>
        <input type="text" name="powerSupply" value="<%= elevator.powerSupply %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Materiali i Kabinës</label>
        <input type="text" name="cabinMaterial" value="<%= elevator.cabinMaterial %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Ndriçimi</label>
        <input type="text" name="lighting" value="<%= elevator.lighting %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Kontrollit</label>
        <input type="text" name="controlSystem" value="<%= elevator.controlSystem %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Sigurisë</label>
        <input type="text" name="safetySystem" value="<%= elevator.safetySystem %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Garancia (Muaj)</label>
        <input type="number" name="warrantyMonths" value="<%= elevator.warrantyMonths %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">TVSH (%)</label>
        <input type="number" step="0.01" name="vatRate" value="<%= elevator.vatRate %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <a href="/lifts/<%= elevator.id %>" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
      RUAJ NDRYSHIMET
    </button>
  </div>

</form>

<div class="mt-6 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider">3. Galeria e Fotove & Videove</h3>
    <span class="text-[11px] text-slate-500">Shfaqet edhe në pamjen publike (QR / Link)</span>
  </div>

  <form action="/lifts/<%= elevator.id %>/media" method="POST" enctype="multipart/form-data" class="mb-5 flex flex-col sm:flex-row items-stretch sm:items-end gap-3 p-4 rounded-xl bg-slate-950/70 border border-slate-800">
    <div class="flex-1">
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Ngarko Foto ose Video (nga kompjuteri)</label>
      <input type="file" name="media" accept="image/*,video/*" multiple required class="w-full text-xs text-slate-300 file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400 file:cursor-pointer">
    </div>
    <div class="flex-1">
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Titulli (opsional)</label>
      <input type="text" name="caption" placeholder="p.sh. Kabina nga brenda" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
    </div>
    <button type="submit" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 transition-all whitespace-nowrap">
      Shto në Galeri
    </button>
  </form>

  <% if (elevator.media && elevator.media.length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <% elevator.media.forEach(m => { %>
        <div class="relative group rounded-xl overflow-hidden border border-slate-800 bg-slate-950">
          <% if (m.type === 'video') { %>
            <video src="<%= m.url %>" class="w-full h-32 object-cover" controls muted></video>
          <% } else { %>
            <img src="<%= m.url %>" alt="<%= m.caption || elevator.model %>" class="w-full h-32 object-cover">
          <% } %>
          <% if (m.caption) { %>
            <p class="px-2 py-1 text-[10px] text-slate-300 bg-slate-950/80 truncate"><%= m.caption %></p>
          <% } %>
          <form action="/lifts/<%= elevator.id %>/media/<%= m.id %>/fshi" method="POST" onsubmit="return confirm('Ta fshij këtë media nga galeria?');" class="absolute top-1.5 right-1.5">
            <button type="submit" title="Fshi" class="w-7 h-7 flex items-center justify-center rounded-lg bg-slate-950/80 hover:bg-rose-500/80 text-slate-300 hover:text-white transition-colors">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </form>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p class="text-xs text-slate-500 text-center py-6">Nuk ka ende foto apo video në galerinë e këtij modeli.</p>
  <% } %>
</div>
