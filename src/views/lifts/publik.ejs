<!-- Koka Publike e Modelit -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
  <div>
    <div class="flex items-center gap-2 mb-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">FLETA TEKNIKE ZYRTARE E LIFTIT</span>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight"><%= elevator.model %></h1>
      <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
        <%= elevator.code %>
      </span>
    </div>
    <p class="text-xs sm:text-sm text-slate-400 mt-1 flex items-center gap-2">
      <span><%= elevator.type %></span>
      <span>•</span>
      <span class="text-emerald-400 font-semibold">Standardi Evropian EN 81-20/50 & CE</span>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2.5">
    <button type="button" onclick="window.print()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-2 shadow transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Printo / PDF</span>
    </button>
    <a href="tel:<%= company.phone || '+38338500600' %>" class="no-print px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/20 flex items-center gap-2 transition-all">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span>Kërko Ofertë / Na Telefono</span>
    </a>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  
  <!-- Tabela Teknike (2 Kolona) -->
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-5">
        <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Specifikimet Inxhinierike të Modelit</span>
        </h3>
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          I CERTIFIKUAR
        </span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3.5 text-xs">
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Kodi i Modelit:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.code %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Lloji i Liftit:</span>
          <span class="font-bold text-slate-200"><%= elevator.type %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Kapaciteti në KG:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.capacityKg %> KG</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Numri i Personave:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.personsCount %> Persona</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Shpejtësia Nominale:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.speed %> m/s</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Sistemi i Lëvizjes:</span>
          <span class="font-bold text-slate-200"><%= elevator.driveSystem %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Lloji i Motorit:</span>
          <span class="font-bold text-slate-200"><%= elevator.motorType %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Fuqia e Motorit:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.motorPower %> kW</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Tipi i Dyerve:</span>
          <span class="font-bold text-slate-200"><%= elevator.doorType %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Dimensionet e Kabinës:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.cabinDimensions || '1100 x 1400 x 2200 mm' %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Dimensionet e Boshtit:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.shaftDimensions || '1650 x 1750 mm' %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Thellësia e Gropës (Pit):</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.pitDepth %> mm</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Lartësia e Sipërme (Headroom):</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.headroomHeight %> mm</span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Furnizimi Elektrik:</span>
          <span class="font-mono font-bold text-slate-200"><%= elevator.powerSupply %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Materiali i Kabinës:</span>
          <span class="font-bold text-slate-200"><%= elevator.cabinMaterial %></span>
        </div>
        <div class="flex justify-between border-b border-slate-800/60 pb-2">
          <span class="text-slate-400">Garancia Inxhinierike:</span>
          <span class="font-mono font-bold text-emerald-400"><%= elevator.warrantyMonths %> Muaj</span>
        </div>
      </div>
    </div>

    <!-- Karakteristikat e Sigurisë & Përshkrimi -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
      <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>Standardet & Siguria e Integruar</span>
      </h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        <%= elevator.description || 'Ky model është projektuar dhe prodhuar në përputhje rigoroze me direktivën evropiane të ashensorëve 2014/33/EU dhe standardet EN 81-20 / EN 81-50. Ofron efikasitet maksimal energjetik, lëvizje të qetë dhe jetëgjatësi maksimale të komponentëve mekanikë dhe elektronikë.' %>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 text-[11px] font-semibold text-slate-300">
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-2">
          <span class="text-emerald-400">✓</span> EN 81-20/50
        </div>
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-2">
          <span class="text-emerald-400">✓</span> Sensorë Infrared
        </div>
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-2">
          <span class="text-emerald-400">✓</span> Frenim Emergjent
        </div>
        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-2">
          <span class="text-emerald-400">✓</span> Evakuim Automatik (UPS)
        </div>
      </div>
    </div>

    <!-- Galeria e Fotove & Videove -->
    <% if (elevator.media && elevator.media.length > 0) { %>
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Galeria e Fotove & Videove</span>
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <% elevator.media.forEach(m => { %>
            <% if (m.type === 'video') { %>
              <video src="<%= m.url %>" class="w-full h-28 object-cover rounded-xl border border-slate-800" controls muted></video>
            <% } else { %>
              <a href="<%= m.url %>" target="_blank" class="block">
                <img src="<%= m.url %>" alt="<%= m.caption || elevator.model %>" class="w-full h-28 object-cover rounded-xl border border-slate-800 hover:border-amber-400 transition-colors">
              </a>
            <% } %>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Kolona Djathtas: Çmimi, QR Code & Kontakt -->
  <div class="space-y-6">
    
    <!-- Çmimi Bazë -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">ÇMIMI BAZË INXHINIERIK</span>
      <div class="text-3xl font-black text-amber-400 font-mono mb-3"><%= formatCurrency(elevator.basePrice) %></div>
      <p class="text-xs text-slate-400 leading-relaxed mb-5">
        Çmimi përfshin setin e plotë të makinerisë, pajisjet e kontrollit, kabinën inoksi, shinat dhe sistemin e plotë të sigurisë EN 81-20.
      </p>

      <!-- QR Code Container -->
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-center space-y-3">
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-amber-400 block">
          QR KODI I MODELIT
        </span>
        <div class="flex justify-center">
          <div class="p-2 bg-white rounded-xl shadow-md inline-block">
            <img src="<%= qrCodeDataUrl %>" alt="QR Code <%= elevator.code %>" class="w-32 h-32 block">
          </div>
        </div>
        <p class="text-[10px] text-slate-400">Skanoni me celular për të hapur këtë fletë teknike në çdo kohë</p>
      </div>

      <div class="mt-5 space-y-2.5">
        <a href="tel:<%= company.phone || '+38338500600' %>" class="no-print w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs text-center block shadow-lg shadow-amber-500/20 transition-all">
          KËRKO KONSULTË & OFERTË
        </a>
        <a href="mailto:<%= company.email || 'info@kroneer-lifts.com' %>?subject=Interesim%20per%20Modelin%20<%= encodeURIComponent(elevator.model) %>%20(<%= encodeURIComponent(elevator.code) %>)" class="no-print w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs text-center block border border-slate-700 transition-all">
          Dërgo Email Inxhinierëve
        </a>
      </div>
    </div>

    <!-- Të Dhënat e Kompanisë -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl text-xs space-y-2.5">
      <h4 class="font-bold text-slate-200 uppercase tracking-wider text-[11px] border-b border-slate-800 pb-2">
        KRONEER SISTEME LIFTSH
      </h4>
      <p class="text-slate-400"><%= company.address || 'Rruga Dëshmorët e Kombit, Nr. 45' %>, <%= company.city || 'Prishtinë' %></p>
      <p class="text-slate-400">Tel: <span class="text-slate-200 font-mono"><%= company.phone || '+383 38 500 600' %></span></p>
      <p class="text-slate-400">Email: <span class="text-slate-200 font-mono"><%= company.email || 'info@kroneer-lifts.com' %></span></p>
      <p class="text-slate-400">Web: <span class="text-amber-400 font-mono"><%= company.website || 'www.kroneer-lifts.com' %></span></p>
    </div>

  </div>

</div>
