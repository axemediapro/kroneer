<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">KATALOGU I LIFTEVE KRONEER</h1>
    <p class="text-xs text-slate-400 mt-1">Gama e plotë inxhinierike e lifteve evropiane sipas standardeve EN 81-20/50</p>
  </div>
  <a href="/lifts/konfiguruesi" class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
    <span>Hap Konfiguruesin e Liftit</span>
  </a>
  <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
    <a href="/lifts/krijo" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs shadow transition-all flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Shto Model të Ri</span>
    </a>
  <% } %>
</div>

<!-- Filtruesi sipas Llojit -->
<div class="mb-8 flex flex-wrap gap-2">
  <a href="/lifts/katalogu" class="px-4 py-2 rounded-xl text-xs font-bold transition-colors <%= !filters.type ? 'bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20' : 'bg-slate-900 border border-slate-800 text-slate-300 hover:bg-slate-800' %>">
    Të Gjithë Modelet
  </a>
  <% types.forEach(t => { %>
    <a href="/lifts/katalogu?type=<%= encodeURIComponent(t) %>" class="px-4 py-2 rounded-xl text-xs font-bold transition-colors <%= filters.type === t ? 'bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20' : 'bg-slate-900 border border-slate-800 text-slate-300 hover:bg-slate-800' %>">
      <%= t %>
    </a>
  <% }); %>
</div>

<!-- Rrjeti i Modeleve të Lifteve -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% elevators.forEach(e => { %>
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl hover:border-amber-500/50 transition-all flex flex-col justify-between group">
      <div>
        <!-- Badge & Code -->
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
            <%= e.type %>
          </span>
          <div class="flex items-center gap-1.5">
            <% if (e.status !== 'Aktiv') { %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-700 text-slate-300">Joaktiv</span>
            <% } %>
            <span class="font-mono text-xs text-slate-500"><%= e.code %></span>
          </div>
        </div>

        <!-- Title & Description -->
        <h3 class="text-lg font-black text-slate-100 group-hover:text-amber-400 transition-colors">
          <%= e.model %>
        </h3>
        <p class="text-xs text-slate-400 mt-2 line-clamp-2 leading-relaxed">
          <%= e.description %>
        </p>

        <!-- Specifikacionet Teknike Kryesore -->
        <div class="grid grid-cols-2 gap-3 my-5 p-3.5 rounded-xl bg-slate-950/70 border border-slate-800/80 text-xs">
          <div>
            <span class="text-slate-500 block text-[10px]">Kapaciteti:</span>
            <span class="font-mono font-bold text-slate-200"><%= e.capacityKg %> KG (<%= e.personsCount %> Persona)</span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px]">Shpejtësia:</span>
            <span class="font-mono font-bold text-slate-200"><%= e.speed %> m/s</span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px]">Sistemi:</span>
            <span class="font-mono font-bold text-slate-200"><%= e.driveSystem %></span>
          </div>
          <div>
            <span class="text-slate-500 block text-[10px]">Garancia:</span>
            <span class="font-mono font-bold text-emerald-400"><%= e.warrantyMonths %> Muaj</span>
          </div>
        </div>
      </div>

      <!-- Çmimi dhe Veprimi -->
      <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
        <div>
          <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Çmimi Bazë:</span>
          <span class="text-lg font-black text-amber-400 font-mono"><%= formatCurrency(e.basePrice) %></span>
        </div>
        <div class="flex items-center gap-2">
          <a href="/lifts/<%= e.id %>" class="px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
            Specifikat
          </a>
          <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
            <a href="/lifts/<%= e.id %>/ndrysho" title="Ndrysho Modelin" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors">
              <i data-lucide="pencil" class="w-4 h-4"></i>
            </a>
          <% } %>
          <a href="/lifts/konfiguruesi?elevatorId=<%= e.id %>" class="px-3.5 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow transition-all">
            Konfiguro
          </a>
        </div>
      </div>

    </div>
  <% }); %>
</div>
