<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">SHTO MODEL TË RI LIFTI</h1>
    <p class="text-xs text-slate-400 mt-1">Regjistroni një model të ri në katalogun e KRONEER me specifikimet e tij inxhinierike</p>
  </div>
  <a href="/lifts/katalogu" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo
  </a>
</div>

<form action="/lifts/krijo" method="POST" class="space-y-6">

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Informacioni i Përgjithshëm
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kodi i Modelit *</label>
        <input type="text" name="code" required placeholder="p.sh. KR-PASS-800" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono uppercase">
      </div>
      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Emri i Modelit *</label>
        <input type="text" name="model" required placeholder="p.sh. KRONEER Elegance 800" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lloji i Liftit *</label>
        <select name="type" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% types.forEach(t => { %>
            <option value="<%= t %>"><%= t %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Aktiv">Aktiv</option>
          <option value="Joaktiv">Joaktiv</option>
        </select>
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Çmimi Bazë (€) *</label>
        <input type="number" step="0.01" name="basePrice" required value="20000" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div class="sm:col-span-3">
        <label class="block font-semibold text-slate-300 mb-1">Përshkrimi</label>
        <textarea name="description" rows="2" placeholder="Përshkrim i shkurtër marketing/teknik i modelit..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"></textarea>
      </div>
    </div>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      2. Specifikimet Teknike
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kapaciteti (KG)</label>
        <input type="number" name="capacityKg" value="630" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Personave</label>
        <input type="number" name="personsCount" value="8" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Shpejtësia (m/s)</label>
        <input type="number" step="0.01" name="speed" value="1.0" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Kateve</label>
        <input type="number" name="floorsCount" value="5" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Ndalesave</label>
        <input type="number" name="stopsCount" value="5" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lloji i Motorit</label>
        <input type="text" name="motorType" value="Gearless" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Lëvizjes</label>
        <input type="text" name="driveSystem" value="MRL" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Tipi i Dyerve</label>
        <input type="text" name="doorType" value="Automatike Qendrore" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Fuqia e Motorit (kW)</label>
        <input type="number" step="0.1" name="motorPower" value="5.5" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Dimensionet e Kabinës</label>
        <input type="text" name="cabinDimensions" placeholder="1100 x 1400 x 2200 mm" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Dimensionet e Boshtit</label>
        <input type="text" name="shaftDimensions" placeholder="1650 x 1750 mm" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Thellësia e Gropës (mm)</label>
        <input type="number" name="pitDepth" value="1200" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lartësia e Sipërme (mm)</label>
        <input type="number" name="headroomHeight" value="3600" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Furnizimi Elektrik</label>
        <input type="text" name="powerSupply" value="380V / 3 Faza / 50Hz" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Materiali i Kabinës</label>
        <input type="text" name="cabinMaterial" value="Inox Saten AISI 304" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Ndriçimi</label>
        <input type="text" name="lighting" value="LED me fikje automatike" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Kontrollit</label>
        <input type="text" name="controlSystem" value="Mikroprocesor VVF Inverter" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Sistemi i Sigurisë</label>
        <input type="text" name="safetySystem" value="EN81-20/50 e plotë" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Garancia (Muaj)</label>
        <input type="number" name="warrantyMonths" value="24" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
      <div>
        <label class="block font-semibold text-slate-300 mb-1">TVSH (%)</label>
        <input type="number" step="0.01" name="vatRate" value="18" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <a href="/lifts/katalogu" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
      SHTO MODELIN NË KATALOG
    </button>
  </div>

</form>
