<div class="space-y-6" x-data="{
  search: '',
  stageFilter: 'all'
}">

  <!-- Shtylla 4 Header Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-950 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl relative overflow-hidden">
    <div class="absolute right-0 top-0 bottom-0 w-1/3 bg-gradient-to-l from-violet-500/10 via-violet-500/5 to-transparent pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 relative z-10">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-violet-500/15 text-violet-400 border border-violet-500/30">
            SHTYLLA 4
          </span>
          <span class="text-xs font-mono text-slate-400">KRONEER ELEVATOR MODERNIZATION & RETROFIT</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-slate-100 font-mono tracking-tight flex items-center gap-2.5">
          <svg class="w-6 h-6 text-violet-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Modernizimi i Lifteve
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Projektet inxhinierike të modernizimit të lifteve ekzistuese — rinovim kabine, ndërrim motori/makinerie, konvertim në VVVF dhe përmirësim i plotë i sigurisë sipas standardeve EN81-20/50.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <% if (!currentUser || currentUser.role !== 'TEKNIK') { %>
        <a href="/projektet/krijo?line=Modernizim" class="px-4 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-black text-xs shadow-lg shadow-violet-500/20 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Hap Projekt Modernizimi</span>
        </a>
        <% } %>
        <a href="/projektet?line=Modernizim" class="px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-all flex items-center gap-1.5">
          <span>Të Gjitha Projektet</span>
        </a>
      </div>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-md">
      <div class="flex items-center justify-between text-slate-400 mb-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider">TOTAL PROJEKTE</span>
        <span class="p-1 rounded-md bg-violet-500/10 text-violet-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </span>
      </div>
      <div class="text-2xl font-black text-slate-100 font-mono"><%= stats.totalProjects %></div>
      <span class="text-[10px] text-slate-400 font-medium">Portofoli i modernizimeve</span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-md">
      <div class="flex items-center justify-between text-slate-400 mb-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider">NË EKZEKUTIM</span>
        <span class="p-1 rounded-md bg-amber-500/10 text-amber-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </span>
      </div>
      <div class="text-2xl font-black text-amber-400 font-mono"><%= stats.activeProjects %></div>
      <span class="text-[10px] text-amber-300 font-medium">Projekte aktive në terren</span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-md">
      <div class="flex items-center justify-between text-slate-400 mb-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider">TË PËRFUNDUARA</span>
        <span class="p-1 rounded-md bg-emerald-500/10 text-emerald-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </span>
      </div>
      <div class="text-2xl font-black text-emerald-400 font-mono"><%= stats.completedProjects %></div>
      <span class="text-[10px] text-emerald-300 font-medium">Dorëzuar me sukses</span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-md">
      <div class="flex items-center justify-between text-slate-400 mb-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider">VLERA E PORTOFOLIT</span>
        <span class="p-1 rounded-md bg-blue-500/10 text-blue-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </span>
      </div>
      <div class="text-xl sm:text-2xl font-black text-blue-400 font-mono"><%= formatCurrency(stats.totalValue) %></div>
      <span class="text-[10px] text-blue-300 font-medium">Vlera totale e kontratave</span>
    </div>

  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900/90 border border-slate-800 p-4 rounded-xl">
    <div class="flex flex-wrap items-center gap-2">
      <input type="text" x-model="search" placeholder="Kërko projekt modernizimi (numër, klient, emër)..." class="px-3 py-1.5 bg-slate-950 border border-slate-700 rounded-lg text-xs text-slate-200 focus:border-violet-400 focus:outline-none w-72">
      <select x-model="stageFilter" class="px-3 py-1.5 bg-slate-950 border border-slate-700 rounded-lg text-xs text-slate-200 focus:border-violet-400 focus:outline-none">
        <option value="all">Të gjitha fazat</option>
        <option value="Planifikim">Planifikim</option>
        <option value="Inxhinieri">Inxhinieri</option>
        <option value="Prodhim">Prodhim</option>
        <option value="Transport">Transport</option>
        <option value="Instalim">Instalim</option>
        <option value="Testim">Testim</option>
        <option value="Dorëzim">Dorëzim</option>
        <option value="Përfunduar">Përfunduar</option>
      </select>
    </div>
  </div>

  <!-- Lista e Projekteve të Modernizimit -->
  <div class="bg-slate-900/90 rounded-2xl border border-slate-800 overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-[11px] uppercase tracking-wider text-slate-400 bg-slate-950/60 border-b border-slate-800">
            <th class="py-3 px-4">Projekti</th>
            <th class="py-3 px-4">Klienti & Lokacioni</th>
            <th class="py-3 px-4">Faza & Progresi</th>
            <th class="py-3 px-4">Menaxheri i Projektit</th>
            <th class="py-3 px-4">Lifta / Kate</th>
            <th class="py-3 px-4">Vlera</th>
            <th class="py-3 px-4 text-right">Veprime</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800 text-slate-300">
          <% if (!projects.length) { %>
            <tr>
              <td colspan="7" class="py-14 text-center text-slate-500">
                <div class="flex flex-col items-center justify-center gap-2">
                  <svg class="w-10 h-10 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  <p class="font-semibold text-slate-400">Nuk ka ende projekte modernizimi të hapura.</p>
                  <% if (!currentUser || currentUser.role !== 'TEKNIK') { %>
                  <a href="/projektet/krijo?line=Modernizim" class="mt-2 px-4 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-bold text-xs shadow transition-all">
                    Krijo Projektin e Parë të Modernizimit
                  </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% } %>
          <% projects.forEach(p => { %>
            <tr class="hover:bg-slate-800/50 transition-colors"
                x-show="(stageFilter === 'all' || '<%= p.stage %>' === stageFilter) &&
                        (search === '' || '<%= (p.number + ' ' + (p.customer ? p.customer.companyName : '') + ' ' + p.name).toLowerCase() %>'.includes(search.toLowerCase()))">
              <td class="py-3.5 px-4">
                <a href="/projektet/<%= p.id %>" class="font-mono font-bold text-violet-400 hover:text-violet-300 hover:underline"><%= p.number %></a>
                <div class="text-slate-200 font-semibold text-xs mt-0.5"><%= p.name %></div>
              </td>
              <td class="py-3.5 px-4">
                <div class="font-medium text-slate-200"><%= p.customer ? p.customer.companyName : '—' %></div>
                <div class="text-[11px] text-slate-400"><%= p.customer ? (p.customer.city || '') : '' %></div>
              </td>
              <td class="py-3.5 px-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= p.stage === 'Përfunduar' ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' : (p.stage === 'Instalim' ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30' : 'bg-violet-500/15 text-violet-300 border border-violet-500/30') %>">
                  <%= p.stage %>
                </span>
                <% if (p.installations && p.installations.length > 0) { %>
                  <div class="w-24 bg-slate-800 rounded-full h-1.5 mt-1.5 overflow-hidden">
                    <div class="bg-violet-500 h-1.5 rounded-full" style="width: <%= p.installations[0].progressPercent || 0 %>%"></div>
                  </div>
                <% } %>
              </td>
              <td class="py-3.5 px-4 text-xs text-slate-300">
                <%= p.projectManager ? p.projectManager.fullName : 'I pacaktuar' %>
              </td>
              <td class="py-3.5 px-4 text-xs text-slate-300">
                <%= p.elevatorCount %> lift / <%= p.floorsCount %> kate
              </td>
              <td class="py-3.5 px-4 font-mono font-bold text-violet-400">
                <%= formatCurrency(p.value) %>
              </td>
              <td class="py-3.5 px-4 text-right">
                <a href="/projektet/<%= p.id %>" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-violet-300 hover:text-white font-semibold text-xs transition-colors">
                  Detaje
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
