<!-- Dëftesë Zyrtare Pagese KRONEER -->
<div class="flex justify-between items-start border-b-2 border-slate-900 pb-5 mb-6">
  <div>
    <% const printLogo = (company && company.logoUrl) ? company.logoUrl : (company && company.logoDarkBgUrl ? company.logoDarkBgUrl : null); %>
    <% if (printLogo) { %>
      <div class="h-11 max-w-[220px] flex items-center justify-start mb-2">
        <img src="<%= printLogo %>" alt="<%= company.companyName %>" class="max-h-11 w-auto max-w-full object-contain">
      </div>
    <% } else { %>
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-slate-950 text-amber-400 font-black flex items-center justify-center text-lg font-mono">
          K
        </div>
        <div>
          <h1 class="text-xl font-black tracking-widest text-slate-950 font-mono"><%= company.companyName %></h1>
          <p class="text-[10px] font-bold text-amber-600"><%= company.tagline %></p>
        </div>
      </div>
    <% } %>
    <div class="text-[11px] text-slate-600">
      <%= company.address %>, <%= company.city %> • Tel: <%= company.phone %>
    </div>
  </div>

  <div class="text-right">
    <span class="inline-block px-3 py-1 bg-emerald-700 text-white text-xs font-mono font-black rounded uppercase tracking-wider mb-2">
      DËFTESË PAGESE (ARKËTIM)
    </span>
    <div class="text-lg font-black font-mono text-slate-950"><%= payment.number %></div>
    <div class="text-xs text-slate-600 mt-1">Data: <strong class="text-slate-900"><%= formatDate(payment.date) %></strong></div>
  </div>
</div>

<div class="bg-slate-50 p-4 rounded-lg border border-slate-200 mb-6 text-xs space-y-1">
  <div class="text-slate-500 font-bold uppercase text-[10px]">PAGESA U KRYE NGA:</div>
  <div class="text-base font-bold text-slate-900"><%= payment.customer ? payment.customer.companyName : '-' %></div>
  <div class="text-slate-600">Personi Kontaktues: <%= payment.customer ? (payment.customer.contactPerson || '-') : '-' %></div>
  <div class="text-slate-600">NUI: <%= payment.customer ? (payment.customer.taxNumber || '-') : '-' %></div>
</div>

<div class="bg-white border border-slate-300 rounded-lg p-6 mb-6 text-xs space-y-3">
  <div class="flex justify-between items-center border-b border-slate-200 pb-3">
    <span class="text-slate-600 font-bold uppercase">SHUMA E PAGUAR ME SUKSES:</span>
    <span class="text-2xl font-black font-mono text-emerald-700"><%= formatCurrency(payment.amount) %></span>
  </div>

  <div class="grid grid-cols-2 gap-4 text-slate-700 pt-2">
    <div>Metoda e Pagesës: <strong class="text-slate-900"><%= payment.paymentMethod %></strong></div>
    <div>Numri i Referencës: <strong class="font-mono text-slate-900"><%= payment.referenceNumber || '-' %></strong></div>
    <% if (payment.invoice) { %>
      <div>Fatura e Shlyer: <strong class="font-mono text-slate-900"><%= payment.invoice.number %></strong></div>
      <div>Borxhi i Mbetur i Faturës: <strong class="font-mono text-slate-900"><%= formatCurrency(payment.invoice.balanceDue) %></strong></div>
    <% } %>
  </div>

  <% if (payment.notes) { %>
    <div class="pt-2 border-t border-slate-200 text-slate-600">
      <span>Shënime:</span> <%= payment.notes %>
    </div>
  <% } %>
</div>

<div class="grid grid-cols-2 gap-12 pt-8 border-t border-slate-300 text-xs text-center">
  <div>
    <p class="font-bold text-slate-800 mb-12">Arkëtuar nga (<%= company.companyName %>):</p>
    <div class="w-48 mx-auto border-b border-slate-900 pb-1">
      <span class="text-[10px] text-slate-500">(Nënshkrimi & Vula)</span>
    </div>
  </div>
  <div>
    <p class="font-bold text-slate-800 mb-12">Nënshkrimi i Paguesit:</p>
    <div class="w-48 mx-auto border-b border-slate-900 pb-1">
      <span class="text-[10px] text-slate-500">(Klienti)</span>
    </div>
  </div>
</div>
