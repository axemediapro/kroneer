<!-- Koka e Faqes -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">Konfigurimi & Administrimi</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight mt-1">
      CILËSIMET E SISTEMIT
    </h1>
    <p class="text-xs text-slate-400 mt-1">Konfigurimi i të dhënave zyrtare të KRONEER, numërimit automatik dhe llogarive të stafit</p>
  </div>
</div>

<!-- Alpine Container për Tabs dhe Modale -->
<div x-data="{ 
  activeTab: '<%= activeTab || "kompania" %>',
  isCreateUserModalOpen: false,
  isEditUserModalOpen: false,
  editUserData: { id: null, fullName: '', username: '', email: '', phone: '', role: 'SHITJE' },
  openEditModal(user) {
    this.editUserData = { ...user };
    this.isEditUserModalOpen = true;
  }
}" class="space-y-6">

  <!-- Tab Navigation -->
  <div class="flex items-center gap-2 p-1.5 bg-slate-900/90 border border-slate-800 rounded-2xl overflow-x-auto shadow-lg">
    <button type="button" @click="activeTab = 'kompania'" :class="activeTab === 'kompania' ? 'bg-amber-500/15 text-amber-400 border-amber-500/30 shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 border-transparent'" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border text-xs font-bold transition-all whitespace-nowrap">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      <span>Kompania & Banka</span>
    </button>
    <button type="button" @click="activeTab = 'prefiksat'" :class="activeTab === 'prefiksat' ? 'bg-amber-500/15 text-amber-400 border-amber-500/30 shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 border-transparent'" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border text-xs font-bold transition-all whitespace-nowrap">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
      <span>Prefiksat e Numërimit</span>
    </button>
    <button type="button" @click="activeTab = 'perdoruesit'" :class="activeTab === 'perdoruesit' ? 'bg-amber-500/15 text-amber-400 border-amber-500/30 shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 border-transparent'" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border text-xs font-bold transition-all whitespace-nowrap">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <span>Përdoruesit & Rolet (<%= users.length %>)</span>
    </button>
    <button type="button" @click="activeTab = 'sistemi'" :class="activeTab === 'sistemi' ? 'bg-amber-500/15 text-amber-400 border-amber-500/30 shadow-sm' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 border-transparent'" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border text-xs font-bold transition-all whitespace-nowrap">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
      <span>Sistemi & Baza e të Dhënave</span>
    </button>
  </div>

  <!-- TAB 1: Kompania & Banka -->
  <div x-show="activeTab === 'kompania'" x-cloak class="space-y-6">

    <!-- Karta e Menaxhimit të Logove dhe Vulës & Nënshkrimit të Kompanisë -->
    <div class="space-y-6" x-data="{
      darkBgLogoPreview: '<%= settings && settings.logoDarkBgUrl ? settings.logoDarkBgUrl : "" %>',
      darkBgLogoFile: '',
      darkBgLogoSize: '',
      
      standardLogoPreview: '<%= settings && settings.logoUrl ? settings.logoUrl : "" %>',
      standardLogoFile: '',
      standardLogoSize: '',

      stampPreview: '<%= settings && settings.stampUrl ? settings.stampUrl : "" %>',
      stampFile: '',
      stampSize: '',
      stampHeight: <%= settings && settings.stampHeight ? settings.stampHeight : 80 %>,

      handleDarkBgLogoSelect(event) {
        const file = event.target.files[0];
        if (!file) return;
        this.darkBgLogoFile = file.name;
        this.darkBgLogoSize = (file.size / 1024).toFixed(1) + ' KB';
        const reader = new FileReader();
        reader.onload = (e) => { this.darkBgLogoPreview = e.target.result; };
        reader.readAsDataURL(file);
      },

      handleStandardLogoSelect(event) {
        const file = event.target.files[0];
        if (!file) return;
        this.standardLogoFile = file.name;
        this.standardLogoSize = (file.size / 1024).toFixed(1) + ' KB';
        const reader = new FileReader();
        reader.onload = (e) => { this.standardLogoPreview = e.target.result; };
        reader.readAsDataURL(file);
      },

      handleStampSelect(event) {
        const file = event.target.files[0];
        if (!file) return;
        this.stampFile = file.name;
        this.stampSize = (file.size / 1024).toFixed(1) + ' KB';
        const reader = new FileReader();
        reader.onload = (e) => { this.stampPreview = e.target.result; };
        reader.readAsDataURL(file);
      }
    }">
      
      <!-- Seksioni me 3 Kolona: Logo Dark UI, Logo Dokumentesh, dhe Vula & Nënshkrimi (.PNG) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Karta 1: Logoja e Bardhë / për Sfond të Errët (Dark UI) -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center font-bold text-sm">
                  🌙
                </div>
                <div>
                  <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                    Logoja e Bardhë (Dark UI)
                  </h3>
                  <p class="text-[11px] text-slate-400">Për Sidebar, Faqen e Kyçjes & Panel</p>
                </div>
              </div>
            </div>

            <!-- Preview Box (Sfond Dark) -->
            <div class="bg-slate-950 border-2 border-dashed border-slate-800 rounded-xl h-36 flex flex-col items-center justify-center p-3 relative mb-4">
              <template x-if="darkBgLogoPreview">
                <div class="flex flex-col items-center justify-center h-full w-full">
                  <img :src="darkBgLogoPreview" alt="Dark UI Logo Preview" class="max-h-16 max-w-[75%] w-auto object-contain filter drop-shadow">
                  <span class="mt-2 px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    ✓ E optimizuar për Dark Mode
                  </span>
                </div>
              </template>
              <template x-if="!darkBgLogoPreview">
                <div class="text-center space-y-1 text-slate-400">
                  <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto text-base font-bold font-mono">
                    K
                  </div>
                  <p class="font-bold text-slate-300 text-xs">Nuk është ngarkuar</p>
                  <p class="text-[10px] text-slate-500">Përdoret emblema standarde</p>
                </div>
              </template>
            </div>

            <!-- Forma e Ngarkimit -->
            <form action="/cilesimet/logo" method="POST" enctype="multipart/form-data" class="space-y-3">
              <input type="hidden" name="returnUrl" value="/cilesimet?tab=kompania">
              <input type="hidden" name="variant" value="dark_bg">

              <div>
                <label class="block font-semibold text-slate-300 text-xs mb-1">
                  Skedari (.SVG, .PNG, .WEBP):
                </label>
                <input type="file" name="logo" accept=".svg,.png,.jpg,.jpeg,.webp,image/svg+xml,image/*" required @change="handleDarkBgLogoSelect" class="w-full px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-xs focus:outline-none focus:border-amber-400 file:mr-2.5 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400 file:cursor-pointer">
              </div>

              <div class="flex flex-wrap items-center gap-2 pt-1">
                <button type="submit" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 flex items-center gap-1.5 transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                  <span>Ruaj</span>
                </button>

                <% if (settings && settings.logoDarkBgUrl) { %>
                  <button type="submit" formaction="/cilesimet/logo/fshi" formmethod="POST" onclick="return confirm('A jeni të sigurt që dëshironi ta fshini logon e bardhë?');" class="px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 font-semibold border border-rose-500/30 text-xs flex items-center gap-1 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <span>Fshi</span>
                  </button>
                <% } %>
              </div>
            </form>
          </div>
        </div>

        <!-- Karta 2: Logoja Kryesore / për Sfond të Bardhë (Dokumente & Printim A4) -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold text-sm">
                  ☀️
                </div>
                <div>
                  <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                    Logoja e Dokumenteve
                  </h3>
                  <p class="text-[11px] text-slate-400">Për Fatura, Oferta, Kontrata & PDF</p>
                </div>
              </div>
            </div>

            <!-- Preview Box (Sfond i Bardhë A4) -->
            <div class="bg-white border-2 border-dashed border-slate-300 rounded-xl h-36 flex flex-col items-center justify-center p-3 relative mb-4">
              <template x-if="standardLogoPreview">
                <div class="flex flex-col items-center justify-center h-full w-full">
                  <img :src="standardLogoPreview" alt="Document Logo Preview" class="max-h-16 max-w-[75%] w-auto object-contain filter drop-shadow">
                  <span class="mt-2 px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    ✓ E optimizuar për A4
                  </span>
                </div>
              </template>
              <template x-if="!standardLogoPreview">
                <div class="text-center space-y-1 text-slate-500">
                  <div class="w-9 h-9 rounded-lg bg-slate-100 border border-slate-300 text-slate-800 flex items-center justify-center mx-auto text-base font-bold font-mono">
                    K
                  </div>
                  <p class="font-bold text-slate-700 text-xs">Nuk është ngarkuar</p>
                  <p class="text-[10px] text-slate-500">Përdoret logo standarde</p>
                </div>
              </template>
            </div>

            <!-- Forma e Ngarkimit -->
            <form action="/cilesimet/logo" method="POST" enctype="multipart/form-data" class="space-y-3">
              <input type="hidden" name="returnUrl" value="/cilesimet?tab=kompania">
              <input type="hidden" name="variant" value="standard">

              <div>
                <label class="block font-semibold text-slate-300 text-xs mb-1">
                  Skedari (.SVG, .PNG, .WEBP):
                </label>
                <input type="file" name="logo" accept=".svg,.png,.jpg,.jpeg,.webp,image/svg+xml,image/*" required @change="handleStandardLogoSelect" class="w-full px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-xs focus:outline-none focus:border-amber-400 file:mr-2.5 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400 file:cursor-pointer">
              </div>

              <div class="flex flex-wrap items-center gap-2 pt-1">
                <button type="submit" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 flex items-center gap-1.5 transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                  <span>Ruaj</span>
                </button>

                <% if (settings && settings.logoUrl) { %>
                  <button type="submit" formaction="/cilesimet/logo/fshi" formmethod="POST" onclick="return confirm('A jeni të sigurt që dëshironi ta fshini logon për dokumente?');" class="px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 font-semibold border border-rose-500/30 text-xs flex items-center gap-1 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <span>Fshi</span>
                  </button>
                <% } %>
              </div>
            </form>
          </div>
        </div>

        <!-- Karta 3: Vula & Nënshkrimi Zyrtar (.PNG) me Kontrollues Madhësie / Zoom -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-500/15 border border-blue-500/30 text-blue-400 flex items-center justify-center font-bold text-sm">
                  🖋️
                </div>
                <div>
                  <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                    Vula & Nënshkrimi (.PNG)
                  </h3>
                  <p class="text-[11px] text-slate-400">Për të gjitha PDF-të e KRONEER</p>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30">Auto-Signature</span>
            </div>

            <!-- Preview Box me Lartësi Dinamike sipas Slider-it -->
            <div class="bg-white border-2 border-dashed border-blue-300 rounded-xl p-3 min-h-[140px] flex flex-col items-center justify-center relative overflow-hidden" style="background-image: radial-gradient(#cbd5e1 0.75px, transparent 0.75px); background-size: 8px 8px;">
              <template x-if="stampPreview">
                <div class="flex flex-col items-center justify-center w-full py-1">
                  <img :src="stampPreview" alt="Stamp & Signature Preview" :style="'height: ' + stampHeight + 'px; max-height: ' + stampHeight + 'px;'" class="w-auto object-contain filter drop-shadow-sm transition-all duration-150">
                  <div class="mt-2.5 flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-blue-100 text-blue-800 border border-blue-300">
                      ✓ Aktive në PDF
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-slate-900 text-amber-400 border border-slate-700" x-text="'Lartësia: ' + stampHeight + 'px'"></span>
                  </div>
                </div>
              </template>
              <template x-if="!stampPreview">
                <div class="text-center space-y-1 text-slate-500 py-2">
                  <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center mx-auto text-base">
                    📜
                  </div>
                  <p class="font-bold text-slate-700 text-xs">Nuk është ngarkuar vula & nënshkrimi</p>
                  <p class="text-[10px] text-slate-500">Mbetet vija standarde për nënshkrim manual</p>
                </div>
              </template>
            </div>

            <!-- Kontrolluesi i Madhësisë (Slider & Presets) -->
            <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-200 flex items-center gap-1.5">
                  <span>📏 Madhësia / Lartësia:</span>
                </span>
                <span class="font-mono font-black text-xs text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20" x-text="stampHeight + ' px'"></span>
              </div>

              <!-- Slider -->
              <input type="range" min="40" max="240" step="5" x-model="stampHeight" class="w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400">

              <!-- Butona të Shpejtë (Presets) -->
              <div class="flex flex-wrap gap-1 pt-0.5">
                <button type="button" @click="stampHeight = 55" :class="stampHeight == 55 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">55px</button>
                <button type="button" @click="stampHeight = 80" :class="stampHeight == 80 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">80px (Std)</button>
                <button type="button" @click="stampHeight = 110" :class="stampHeight == 110 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">110px</button>
                <button type="button" @click="stampHeight = 140" :class="stampHeight == 140 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">140px (Madhe)</button>
                <button type="button" @click="stampHeight = 180" :class="stampHeight == 180 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">180px (XL)</button>
                <button type="button" @click="stampHeight = 220" :class="stampHeight == 220 ? 'bg-amber-500 text-slate-950 font-bold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'" class="px-2 py-1 rounded text-[10px] border border-slate-800 transition-colors">220px (Max)</button>
              </div>

              <!-- Buton i Shpejtë për Ruajtjen e Madhësisë -->
              <form action="/cilesimet/vula/madhesia" method="POST" class="pt-1.5 flex items-center justify-between border-t border-slate-800/80">
                <input type="hidden" name="returnUrl" value="/cilesimet?tab=kompania">
                <input type="hidden" name="stampHeight" :value="stampHeight">
                <span class="text-[10px] text-slate-400">Rregulloni dhe ruani madhësinë:</span>
                <button type="submit" class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-bold text-[11px] border border-amber-500/40 transition-colors flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>Ruaj Madhësinë</span>
                </button>
              </form>
            </div>

            <!-- Forma e Ngarkimit të Vulës & Nënshkrimit -->
            <form action="/cilesimet/vula" method="POST" enctype="multipart/form-data" class="space-y-3">
              <input type="hidden" name="returnUrl" value="/cilesimet?tab=kompania">
              <input type="hidden" name="stampHeight" :value="stampHeight">

              <div>
                <label class="block font-semibold text-slate-300 text-xs mb-1">
                  Skedari Transparent (.PNG, .WEBP):
                </label>
                <input type="file" name="stamp" accept=".png,.webp,.svg,.jpg,.jpeg,image/png,image/*" required @change="handleStampSelect" class="w-full px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-xs focus:outline-none focus:border-amber-400 file:mr-2.5 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-blue-500 file:text-slate-950 hover:file:bg-blue-400 file:cursor-pointer">
              </div>

              <div class="flex flex-wrap items-center gap-2 pt-1">
                <button type="submit" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-400 hover:to-blue-500 text-white font-bold text-xs shadow-md shadow-blue-500/20 flex items-center gap-1.5 transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                  <span>Ngarko Vulën e Re</span>
                </button>

                <% if (settings && settings.stampUrl) { %>
                  <button type="submit" formaction="/cilesimet/vula/fshi" formmethod="POST" onclick="return confirm('A jeni të sigurt që dëshironi ta fshini vulën dhe nënshkrimin zyrtar?');" class="px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 font-semibold border border-rose-500/30 text-xs flex items-center gap-1 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <span>Fshi</span>
                  </button>
                <% } %>
              </div>
            </form>
          </div>
        </div>

      </div>

      <!-- Këshilla Informative -->
      <div class="p-3.5 bg-slate-950/60 rounded-xl border border-slate-800 text-[11px] text-slate-400 flex items-start gap-2.5">
        <span class="text-amber-400 font-bold mt-0.5">ℹ️ Këshillë:</span>
        <span class="leading-relaxed">Për <strong>Vula & Nënshkrimi</strong>, rekomandohet skedar në format <strong>.PNG me sfond transparent</strong> (ose .WEBP). Sistemi do ta vendosë automatikisht mbi/te seksioni i nënshkrimit dhe vulës së KRONEER në <strong>Fatura, Oferta, Kontrata, Mirëmbajtje, Dorëzim, Dëftesa Pagesash dhe Raportet Zyrtare</strong>.</span>
      </div>
    </div>

    <form action="/cilesimet/kompania" method="POST" class="space-y-6">
      <input type="hidden" name="returnTab" value="kompania">

      <!-- Informacioni Bazë i Kompanisë -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
              🏢
            </div>
            <div>
              <h2 class="text-base font-bold text-slate-100">Të Dhënat Kryesore të Kompanisë</h2>
              <p class="text-xs text-slate-400">Këto të dhëna shfaqen në të gjitha faturat, ofertat, kontratat dhe printimet zyrtare</p>
