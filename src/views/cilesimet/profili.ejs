<div class="mb-6">
  <div class="flex items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
    <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">Llogaria ime</span>
  </div>
  <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight mt-1">
    CILËSIMET E LLOGARISË
  </h1>
  <p class="text-xs text-slate-400 mt-1">Ndryshoni vetëm të dhënat tuaja. Roli dhe emri i përdoruesit i cakton administratori.</p>
</div>

<div class="max-w-xl bg-slate-900/90 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl">
  <form action="/cilesimet/profili" method="POST" class="space-y-4 text-sm">
    <div>
      <label class="block text-xs font-semibold text-slate-400 mb-1">Emri i përdoruesit</label>
      <input type="text" value="<%= profileUser.username %>" disabled class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-500 font-mono cursor-not-allowed">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-400 mb-1">Roli</label>
      <input type="text" value="<%= profileUser.role %>" disabled class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-amber-400/80 font-mono cursor-not-allowed">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1">Emri i plotë *</label>
      <input type="text" name="fullName" required value="<%= profileUser.fullName %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1">Email *</label>
      <input type="email" name="email" required value="<%= profileUser.email %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-1">Telefoni</label>
      <input type="text" name="phone" value="<%= profileUser.phone || '' %>" placeholder="+383 ..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
    </div>

    <div class="pt-2 border-t border-slate-800">
      <p class="text-[11px] text-slate-500 mb-3">Ndryshimi i fjalëkalimit (opsionale)</p>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Fjalëkalimi aktual</label>
          <input type="password" name="currentPassword" autocomplete="current-password" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Fjalëkalimi i ri</label>
          <input type="password" name="newPassword" autocomplete="new-password" minlength="6" placeholder="Të paktën 6 karaktere" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 pt-2">
      <a href="/paneli" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold">Anulo</a>
      <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black shadow-lg shadow-amber-500/20">
        Ruaj të dhënat e mia
      </button>
    </div>
  </form>
</div>
