<!DOCTYPE html>
<html lang="sq" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#020617">
  <meta name="description" content="KRONEER - Sistem profesional ERP & CRM për menaxhimin e lifteve">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'KRONEER - Sistem për Menëxhimin e Lifteve' %></title>

  <link rel="stylesheet" href="/css/style.css?v=15">
  <script defer src="/vendor/lucide.min.js?v=3"></script>
  <script defer src="/js/app.min.js?v=11"></script>
  <script defer src="/vendor/alpine.min.js"></script></head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

  <!-- Mobile Sidebar Backdrop Overlay -->
  <div id="sidebar-backdrop" class="hidden fixed inset-0 z-40 bg-black/60 lg:hidden"></div>

  <!-- Main Sidebar (Left) -->
  <%- include('../partials/sidebar') %>

  <!-- Main Content Wrapper (Right of Sidebar) -->
  <div class="flex-1 flex flex-col  min-w-0">
    
    <!-- Topbar Header -->
    <%- include('../partials/topbar') %>

    <!-- Page Body Container -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-[96rem] w-full mx-auto pb-24 lg:pb-8">
      <%- include('../partials/alerts') %>
      <%- body %>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer') %>
  </div>

  <!-- Mobile Bottom Navigation Bar (Fixed for mobile) -->
  <%- include('../partials/mobile-navbar') %>

  <!-- Modal global i Pamjes së Shpejtë (Quick View) -->
  <%- include('../partials/quick-view-modal') %>
</body>
</html>





