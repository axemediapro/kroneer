<!DOCTYPE html>
<html lang="sq" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'KRONEER — Sisteme Profesionale të Lifteve' %></title>
  
  <!-- Fonts: Inter, Outfit, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-amber-500 selection:text-slate-950">

  <!-- Public Header / Navbar -->
  <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-xl">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between py-3.5">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <% const publicLogo = (typeof company !== 'undefined' && company && company.logoDarkBgUrl) ? company.logoDarkBgUrl : (typeof company !== 'undefined' && company && company.logoUrl ? company.logoUrl : null); %>
        <% if (publicLogo) { %>
          <div class="h-8 max-w-[190px] flex items-center justify-start flex-shrink-0">
            <img src="<%= publicLogo %>" alt="<%= company.companyName %>" class="max-h-8 w-auto max-w-full object-contain filter drop-shadow group-hover:scale-105 transition-transform">
          </div>
        <% } else { %>
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-md shadow-amber-500/20 text-slate-950 font-black text-base tracking-wider group-hover:scale-105 transition-transform font-mono">
            K
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-base font-black tracking-widest text-slate-100 font-mono"><%= typeof company !== 'undefined' && company ? company.companyName : 'KRONEER' %></span>
              <span class="px-1.5 py-0.5 rounded text-[8px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">LIFTS</span>
            </div>
            <p class="text-[9px] font-bold text-amber-400 tracking-wider"><%= typeof company !== 'undefined' && company ? company.tagline : 'SISTEME PROFESIONALE LIFTSH' %></p>
          </div>
        <% } %>
      </a>

      <!-- Quick Contact / Hotline & Portal Link -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a href="tel:+38338500600" class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-800 text-slate-300 text-xs font-semibold border border-slate-700/80 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>+383 38 500 600</span>
        </a>
        <a href="/kycu" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          <span class="hidden sm:inline">Portali KRONEER</span>
          <span class="sm:hidden">Kyçu</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 lg:p-8">
    <%- body %>
  </main>

  <!-- Public Footer -->
  <footer class="bg-slate-900 border-t border-slate-800 mt-12 py-8 text-xs text-slate-400">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-300">KRONEER SISTEME LIFTSH</span>
        <span>•</span>
        <span>Standardi Evropian EN 81-20/50</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500">
        <span>Prishtinë, Kosovë</span>
        <span>•</span>
        <a href="mailto:info@kroneer-lifts.com" class="hover:text-amber-400 transition-colors">info@kroneer-lifts.com</a>
        <span>•</span>
        <span>© <%= new Date().getFullYear() %> KRONEER</span>
      </div>
    </div>
  </footer>

</body>
</html>
