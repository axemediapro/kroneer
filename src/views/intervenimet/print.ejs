<!DOCTYPE html>
<html lang="sq">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - KRONEER</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="/css/style.css?v=3">
  <style>
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print { display: none !important; }
      @page { margin: 12mm; size: A4 portrait; }
    }
  </style>
</head>
<body class="bg-white text-slate-900 font-sans p-6 text-sm max-w-4xl mx-auto">

  <!-- Butonat e Printimit -->
  <div class="no-print mb-6 flex items-center justify-between bg-slate-900 text-white p-4 rounded-xl shadow-lg">
    <div class="flex items-center gap-3">
      <a href="/intervenimet/<%= intervention.id %>" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold border border-slate-700">
        ← Kthehu te Intervenimi
      </a>
      <span class="text-xs text-slate-300 font-mono"><%= intervention.number %></span>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="window.print()" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-lg text-xs flex items-center gap-2 shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        PRINT / SHKARKO RAPORTIN (PDF)
      </button>
    </div>
  </div>

  <!-- Raporti Zyrtar -->
  <div class="border-2 border-slate-800 rounded-2xl p-6 bg-white shadow-sm space-y-5">
    
    <!-- Header -->
    <div class="flex items-start justify-between border-b-2 border-slate-800 pb-4">
      <div>
        <% if (company && company.logoUrl) { %>
          <img src="<%= company.logoUrl %>" alt="KRONEER" class="h-10 w-auto object-contain">
        <% } else { %>
          <span class="text-2xl font-black tracking-tight text-slate-950 font-mono">KRONEER</span>
        <% } %>
        <p class="text-[11px] text-slate-600 mt-1"><%= company.address || 'Prishtinë, Kosovë' %> • Tel: <%= company.phone || '+383 38 500 600' %> • <%= company.email || 'info@kroneer.com' %></p>
      </div>

      <div class="text-right">
        <span class="inline-block px-3 py-1 bg-slate-900 text-amber-400 font-mono font-black text-xs uppercase tracking-wider rounded-md mb-1">
          RAPORT INTERVENIMI NË TERREN
        </span>
        <p class="font-mono text-xs font-bold text-slate-900">Nr: <%= intervention.number %></p>
        <p class="text-[11px] text-slate-600 font-mono">Data: <%= new Date(intervention.date).toLocaleDateString('sq-AL') %></p>
      </div>
    </div>

    <!-- Të Dhënat e Projektit & Intervenimit -->
    <div class="grid grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs">
      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Titulli & Lloji:</span>
        <span class="text-sm font-bold text-slate-950 block"><%= intervention.title %></span>
        <span class="text-slate-700 block mt-0.5">Lloji: <strong><%= intervention.type %></strong> • Statusi: <strong><%= intervention.status %></strong></span>
        <% if (intervention.project) { %>
          <span class="text-slate-700 block mt-0.5">Projekti: <strong><%= intervention.project.name %> (<%= intervention.project.number %>)</strong></span>
        <% } %>
      </div>

      <div class="text-right">
        <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Menaxheri & Lokacioni:</span>
        <span class="text-xs font-bold text-slate-900 block">Menaxher Projekti: <%= intervention.projectManager ? intervention.projectManager.fullName : 'Stafi Qendror' %></span>
        <span class="text-slate-700 block mt-0.5">Lokacioni: <%= intervention.location || '-' %></span>
        <% if (intervention.startTime) { %>
          <span class="text-slate-600 font-mono block mt-0.5">Orari: <%= intervention.startTime %><%= intervention.endTime ? ' - ' + intervention.endTime : '' %></span>
        <% } %>
      </div>
    </div>

    <!-- EKIPIN E PUNËTORËVE/MONTERËVE QË KANË QENË PREZENT -->
    <div class="border border-slate-300 rounded-xl overflow-hidden">
      <div class="bg-slate-100 px-4 py-2.5 border-b border-slate-300">
        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider font-mono">
          Ekipi i Monterëve / Punëtorëve Prezent në Intervenim
        </h3>
      </div>
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-[10px] font-mono">
          <tr>
            <th class="py-2 px-4">Nr.</th>
            <th class="py-2 px-4">Punëtori / Monter</th>
            <th class="py-2 px-4">Kodi</th>
            <th class="py-2 px-4">Roli në Ndërhyrje</th>
            <th class="py-2 px-4 text-right">Nënshkrimi i Monterit</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if (intervention.teamWorkers && intervention.teamWorkers.length > 0) { %>
            <% intervention.teamWorkers.forEach((tw, idx) => { %>
              <tr>
                <td class="py-2.5 px-4 font-mono font-bold text-slate-600"><%= idx + 1 %>.</td>
                <td class="py-2.5 px-4 font-bold text-slate-900"><%= tw.employee.firstName %> <%= tw.employee.lastName %></td>
                <td class="py-2.5 px-4 font-mono text-slate-600"><%= tw.employee.code %></td>
                <td class="py-2.5 px-4"><%= tw.roleInTeam %></td>
                <td class="py-2.5 px-4 text-right text-slate-400 font-mono text-[10px]">___________________</td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-4 text-center text-slate-500">Nuk ka monterë të specifikuar.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Përshkrimi i Punëve dhe Pjesët -->
    <div class="space-y-3 text-xs">
      <div class="border border-slate-300 rounded-xl p-4">
        <span class="font-bold text-slate-900 uppercase block text-[11px] mb-1">Punët e Realizuara nga Ekipi:</span>
        <p class="text-slate-700 leading-relaxed whitespace-pre-line">
          <%= intervention.workDescription || 'Nuk ka përshkrim shtesë.' %>
        </p>
      </div>

      <% if (intervention.partsReplaced) { %>
        <div class="border border-slate-300 rounded-xl p-4">
          <span class="font-bold text-slate-900 uppercase block text-[11px] mb-1">Pjesët & Materialet e Vendosura / Ndërruara:</span>
          <p class="text-slate-700 font-mono">
            <%= intervention.partsReplaced %>
          </p>
        </div>
      <% } %>
    </div>

    <!-- Nënshkrimet & Vula -->
    <div class="grid grid-cols-2 gap-8 pt-6 border-t border-slate-300 items-end">
      <div>
        <p class="text-[11px] text-slate-600 font-bold mb-8">Përfaqësuesi / Pranuesi në Objekt (Klienti):</p>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= intervention.clientSignee || 'Klienti / Përgjegjësi i Objektit' %></p>
        <p class="text-[10px] text-slate-500 font-mono">Nënshkrimi & Data</p>
      </div>

      <div class="text-right flex flex-col items-end">
        <p class="text-[11px] text-slate-600 font-bold mb-3">Përgjegjësi i Ekipit / Menaxheri (KRONEER):</p>
        <% if (company && company.stampUrl) { %>
          <img src="<%= company.stampUrl %>" alt="Vula" style="max-height: <%= company.stampHeight || 60 %>px;" class="mb-1">
        <% } %>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= intervention.projectManager ? intervention.projectManager.fullName : 'Menaxher Projekti KRONEER' %></p>
        <p class="text-[10px] text-slate-500 font-mono">Vula & Nënshkrimi Zyrtar</p>
      </div>
    </div>

  </div>

</body>
</html>
