<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2 text-sm text-slate-400 mb-1">
        <a href="/intervenimet" class="hover:text-amber-400">Intervenimet</a>
        <span>/</span>
        <span class="text-slate-200">Regjistro Intervenim të Ri</span>
      </div>
      <h1 class="text-2xl font-black text-slate-100 font-mono tracking-tight">Regjistro Intervenim në Terren & Cakto Ekipin</h1>
    </div>
    <a href="/intervenimet" class="px-4 py-2 text-xs font-bold text-slate-300 bg-slate-800 border border-slate-700 rounded-xl hover:bg-slate-700 transition">
      Kthehu
    </a>
  </div>

  <form action="/intervenimet/krijo" method="POST" class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-2">Numri i Intervenimit</label>
        <input type="text" value="<%= nextNumber %>" readonly class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-amber-400 font-mono focus:outline-none cursor-not-allowed">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Titulli / Përshkrimi i Shkurtër i Intervenimit *</label>
        <input type="text" name="title" required placeholder="p.sh. Montimi i shinave dhe motorit - Kulla A" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Lloji i Intervenimit *</label>
        <select name="type" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Montim & Instalim">Montim & Instalim</option>
          <option value="Mirëmbajtje Periodike">Mirëmbajtje Periodike</option>
          <option value="Servis Urgjent">Servis Urgjent</option>
          <option value="Riparim & Pjesë">Riparim & Pjesë</option>
          <option value="Testim & Kalibrim">Testim & Kalibrim</option>
          <option value="Inspektim Teknik">Inspektim Teknik</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Prioriteti</label>
        <select name="priority" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Normal" selected>Normal</option>
          <option value="I Lartë">I Lartë</option>
          <option value="Urgjent">Urgjent (24/7)</option>
          <option value="Kritik">Kritik</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Projekti Ndërlidhës (Opsionale)</label>
        <select name="projectId" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Pa projekt të caktuar (Intervenim i pavarur) --</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>" <%= selectedProjectId === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.number %>)</option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Menaxheri i Projektit / Përgjegjësi</label>
        <select name="projectManagerId" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Zgjidh Menaxherin --</option>
          <% if (typeof managers !== 'undefined' && managers) { %>
            <% managers.forEach(m => { %>
              <option value="<%= m.id %>" <%= (currentUser && currentUser.id === m.id) ? 'selected' : '' %>><%= m.fullName %> (<%= m.role %>)</option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Lokacioni / Adresa e Objektit</label>
        <input type="text" name="location" placeholder="p.sh. Rr. Nëna Terezë Nr. 12, Prishtinë" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Numri Serik i Ashensorit (SN)</label>
        <input type="text" name="elevatorSerialNumber" placeholder="p.sh. KR-SN-2026-0012" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div class="grid grid-cols-3 gap-3 md:col-span-2">
        <div>
          <label class="block font-semibold text-slate-300 mb-2">Data e Intervenimit</label>
          <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-2">Koha e Nisjes</label>
          <input type="time" name="startTime" value="08:30" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-2">Koha e Mbarimit</label>
          <input type="time" name="endTime" value="16:30" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- EKIPIN E MONTERËVE QË KANË QENË NË KËTË INTERVENIM -->
      <!-- ========================================================================= -->
      <div class="md:col-span-2 bg-slate-950/80 p-5 rounded-xl border border-slate-800/80 space-y-3">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div>
            <span class="font-bold text-amber-400 uppercase tracking-wider text-xs block">Ekipi i Monterëve / Punëtorëve që ishin në Intervenim *</span>
            <span class="text-[11px] text-slate-400">Zgjidhni anëtarët e ekipit<% if (typeof canAssignBonus !== 'undefined' && canAssignBonus) { %> dhe mundësisht caktoni mëditje kesh apo bonuse<% } else { %> dhe mëditje kesh<% } %> për këtë ndërhyrje:</span>
          </div>
        </div>

        <div class="space-y-2.5 max-h-72 overflow-y-auto pr-1">
          <% if (typeof employees !== 'undefined' && employees) { %>
            <% employees.forEach((emp, index) => { %>
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <label class="flex items-center gap-3 cursor-pointer select-none">
                  <input type="checkbox" name="workers[<%= index %>][id]" value="<%= emp.id %>" class="rounded text-amber-500 focus:ring-amber-400 bg-slate-950 border-slate-700">
                  <div>
                    <span class="font-bold text-slate-100 text-xs block"><%= emp.firstName %> <%= emp.lastName %></span>
                    <span class="text-[10px] text-slate-400 font-mono"><%= emp.code %> • <%= emp.position %></span>
                  </div>
                </label>

                <div class="flex items-center gap-2 text-xs flex-wrap">
                  <select name="workers[<%= index %>][role]" class="px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg text-slate-200 text-[11px] focus:outline-none focus:border-amber-400">
                    <option value="Kryemonter">Kryemonter</option>
                    <option value="Monter" selected>Monter</option>
                    <option value="Elektricist">Elektricist</option>
                    <option value="Teknik Servisi">Teknik Servisi</option>
                    <option value="Ndihmës">Ndihmës</option>
                  </select>

                  <div class="flex items-center gap-1">
                    <span class="text-[10px] text-slate-500 font-mono">Kesh:</span>
                    <input type="number" step="0.01" min="0" name="workers[<%= index %>][cashGiven]" placeholder="0.00 €" class="w-16 px-2 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-[11px] text-amber-400">
                  </div>

                  <% if (typeof canAssignBonus !== 'undefined' && canAssignBonus) { %>
                  <div class="flex items-center gap-1">
                    <span class="text-[10px] text-slate-500 font-mono">Bonus:</span>
                    <input type="number" step="0.01" min="0" name="workers[<%= index %>][bonusGiven]" placeholder="0.00 €" class="w-16 px-2 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-[11px] text-emerald-400">
                  </div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <div class="md:col-span-2">
        <label class="block font-semibold text-slate-300 mb-2">Përshkrimi i Punëve të Kryera (Raporti Teknik)</label>
        <textarea name="workDescription" rows="3" placeholder="Përshkruani në detaje punët e montimit, instalimit, testimit apo riparimit të kryera nga ekipi..." class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400"></textarea>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Pjesët & Materialet e Përdorura / Ndërruara</label>
        <input type="text" name="partsReplaced" placeholder="p.sh. Kontaktor 24V, Vaj hidraulik 20L, Shina udhëzuese" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-2">Klienti / Përfaqësuesi Pranues në Objekt</label>
        <input type="text" name="clientSignee" placeholder="Emri dhe mbiemri i personit përgjegjës në objekt" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div class="md:col-span-2">
        <label class="block font-semibold text-slate-300 mb-2">Statusi Fillestar</label>
        <select name="status" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Në Proces" selected>Në Proces (Ekipi në Terren)</option>
          <option value="Planifikuar">Planifikuar</option>
          <option value="Përfunduar">Përfunduar me Sukses</option>
        </select>
      </div>
    </div>

    <div class="pt-4 border-t border-slate-800 flex justify-end items-center gap-3">
      <a href="/intervenimet" class="px-5 py-2.5 text-xs font-semibold text-slate-300 bg-slate-800 rounded-xl hover:bg-slate-700 transition">
        Anulo
      </a>
      <button type="submit" class="px-7 py-2.5 text-xs font-black text-slate-950 bg-amber-500 hover:bg-amber-400 rounded-xl transition shadow-lg shadow-amber-500/20 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        RUAJ INTERVENIMIN & EKIPIN
      </button>
    </div>
  </form>
</div>
