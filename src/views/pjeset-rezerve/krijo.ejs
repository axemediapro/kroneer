<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-1">
        <a href="/pjeset-rezerve" class="hover:text-amber-600 dark:hover:text-amber-400">Produktet/Shërbimet</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-slate-200">Regjistro</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Regjistro Pjesë Rezervë, Produkt ose Shërbim</h1>
    </div>
    <a href="/pjeset-rezerve" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition">
      Kthehu
    </a>
  </div>

  <form action="/pjeset-rezerve/krijo" method="POST" id="itemForm" class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-6">
    <div>
      <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Çfarë po regjistroni? *</label>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <% Object.entries(itemTypes).forEach(([key, t]) => { %>
          <label class="cursor-pointer">
            <input type="radio" name="itemType" value="<%= key %>" class="peer sr-only" <%= selectedType === key ? 'checked' : '' %>>
            <div class="px-4 py-3 rounded-xl border-2 border-slate-300 dark:border-slate-700 text-center text-sm font-bold text-slate-600 dark:text-slate-300 peer-checked:border-amber-500 peer-checked:bg-amber-500/10 peer-checked:text-amber-500 transition">
              <%= t.label %>
              <span class="block text-[11px] font-normal opacity-70 mt-0.5"><%= key === 'produkt' ? 'Paketë / Modernizim' : (key === 'sherbim' ? 'Pa stok' : 'Me stok në magazinë') %></span>
            </div>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Kodi</label>
        <input type="text" name="partNumber" id="partNumberInput" placeholder="Gjenerohet automatikisht" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
        <p class="text-[11px] text-slate-500 mt-1">Lëreni bosh që sistemi ta japë kodin (<span id="prefixHint"></span>-0001...).</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2" id="nameLabel">Emri *</label>
        <input type="text" name="name" required placeholder="p.sh. Inverter VVVF Yaskawa 7.5kW" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Kategoria *</label>
        <select name="category" id="categorySelect" required class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Lifta Kompatibilë</label>
        <input type="text" name="compatibleElevators" placeholder="p.sh. KRONEER ProPassenger 630, 1000" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div data-stock-field>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Sasia Fillestare në Stok</label>
        <input type="number" name="stockQty" min="0" value="5" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div data-stock-field>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Pragu Minimal i Stokut (Alarm)</label>
        <input type="number" name="minStockQty" min="1" value="2" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Çmimi Blerës (€)</label>
        <input type="number" step="0.01" name="purchasePrice" placeholder="450.00" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Çmimi Shitës (€) *</label>
        <input type="number" step="0.01" name="sellingPrice" required placeholder="650.00" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Furnitori</label>
        <select name="supplierId" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"><option value="">— Pa furnitor —</option><% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select><a href="/furnitoret/krijo" class="text-[11px] text-amber-500 hover:text-amber-400 mt-1 inline-block">+ Furnitor i ri</a>
      </div>

      <div data-stock-field>
        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Vendndodhja në Magazinë (Rafti)</label>
        <input type="text" name="location" placeholder="p.sh. Rafti A-04, Sektori Elektrik" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>
    </div>

    <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex justify-end space-x-3">
      <a href="/pjeset-rezerve" class="px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-600 transition">
        Anulo
      </a>
      <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 rounded-lg transition shadow-sm flex items-center">
        <i data-lucide="check" class="w-4 h-4 mr-2"></i>
        Regjistro
      </button>
    </div>
  </form>
</div>

<script>
  (function () {
    var types = <%- JSON.stringify(itemTypes) %>;
    var form = document.getElementById('itemForm');
    var select = document.getElementById('categorySelect');
    var hint = document.getElementById('prefixHint');
    var nameLabel = document.getElementById('nameLabel');

    function apply() {
      var key = form.querySelector('input[name="itemType"]:checked').value;
      var t = types[key];
      select.innerHTML = t.categories.map(function (c) { return '<option value="' + c + '">' + c + '</option>'; }).join('');
      hint.textContent = t.prefix;
      nameLabel.textContent = 'Emri i ' + (key === 'pjese' ? 'Pjesës Rezervë' : key === 'produkt' ? 'Produktit' : 'Shërbimit') + ' *';
      form.querySelectorAll('[data-stock-field]').forEach(function (el) {
        el.style.display = key === 'sherbim' ? 'none' : '';
      });
    }

    form.querySelectorAll('input[name="itemType"]').forEach(function (r) { r.addEventListener('change', apply); });
    apply();
  })();
</script>
