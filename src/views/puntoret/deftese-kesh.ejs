<!DOCTYPE html>
<html lang="sq">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - KRONEER</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .no-print { display: none !important; }
      @page { margin: 12mm; size: A5 landscape; }
    }
  </style>
</head>
<body class="bg-white text-slate-900 font-sans p-6 text-sm max-w-4xl mx-auto">

  <!-- Butonat e Printimit -->
  <div class="no-print mb-6 flex items-center justify-between bg-slate-900 text-white p-4 rounded-xl shadow-lg">
    <div class="flex items-center gap-3">
      <a href="/puntoret/<%= transaction.employeeId %>" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold border border-slate-700">
        ← Kthehu te Profili
      </a>
      <span class="text-xs text-slate-300 font-mono"><%= transaction.number %></span>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="window.print()" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-lg text-xs flex items-center gap-2 shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        PRINT / SHKARKO PDF
      </button>
    </div>
  </div>

  <!-- Dëftesa Zyrtare (Border me stil profesional) -->
  <div class="border-2 border-slate-800 rounded-2xl p-6 relative overflow-hidden bg-white shadow-sm">
    
    <!-- Header -->
    <div class="flex items-start justify-between border-b-2 border-slate-800 pb-4 mb-5">
      <div>
        <div class="flex items-center gap-3">
          <% if (company && company.logoUrl) { %>
            <img src="<%= company.logoUrl %>" alt="KRONEER" class="h-10 w-auto object-contain">
          <% } else { %>
            <span class="text-2xl font-black tracking-tight text-slate-950 font-mono">KRONEER</span>
          <% } %>
        </div>
        <p class="text-[11px] text-slate-600 font-medium mt-1"><%= company.address || 'Prishtinë, Kosovë' %> • Tel: <%= company.phone || '+383 38 500 600' %></p>
      </div>

      <div class="text-right">
        <span class="inline-block px-3 py-1 bg-slate-900 text-amber-400 font-mono font-black text-xs uppercase tracking-wider rounded-md mb-1">
          <%= transaction.type === 'BONUS' ? 'DËFTESË BONUSESH' : (transaction.type === 'ZBRITJE' ? 'FLETË ZBRITJEJE' : 'DËFTESË PAGESE NË KESH') %>
        </span>
        <p class="font-mono text-xs font-bold text-slate-900">Nr: <%= transaction.number %></p>
        <p class="text-[11px] text-slate-600 font-mono">Data: <%= new Date(transaction.date).toLocaleDateString('sq-AL') %></p>
      </div>
    </div>

    <!-- Të Dhënat e Përfituesit (Punëtorit) -->
    <div class="grid grid-cols-2 gap-4 mb-5 bg-slate-50 p-4 rounded-xl border border-slate-200">
      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Punëtori / Përfituesi:</span>
        <span class="text-base font-black text-slate-950 block"><%= transaction.employee.firstName %> <%= transaction.employee.lastName %></span>
        <span class="text-xs text-slate-700 font-mono"><%= transaction.employee.code %> • <%= transaction.employee.position %></span>
        <span class="text-xs text-slate-600 block"><%= transaction.employee.department %></span>
      </div>

      <div class="text-right">
        <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Lloji i Pagesës & Metoda:</span>
        <span class="text-xs font-bold text-slate-900 block"><%= transaction.category || 'Mëditje / Shpërblim' %></span>
        <span class="text-xs text-slate-700 font-mono"><%= transaction.paymentMethod %></span>
        <% if (transaction.project) { %>
          <span class="text-[11px] text-amber-700 font-medium block mt-1">Projekti: <%= transaction.project.name %> (<%= transaction.project.number %>)</span>
        <% } %>
      </div>
    </div>

    <!-- Shuma dhe Përshkrimi -->
    <div class="border border-slate-300 rounded-xl p-4 mb-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-3">
        <div>
          <span class="text-xs text-slate-600 block">Përshkrimi i Pagesës / Arsyetimi:</span>
          <span class="font-semibold text-slate-900 text-sm"><%= transaction.title %></span>
          <% if (transaction.notes) { %>
            <p class="text-xs text-slate-500 italic mt-0.5"><%= transaction.notes %></p>
          <% } %>
        </div>
        <div class="text-right pl-4">
          <span class="text-[10px] font-bold uppercase text-slate-500 block">Shuma e Paguar:</span>
          <span class="text-2xl font-black font-mono text-emerald-700">
            <%= transaction.amount.toFixed(2) %> €
          </span>
        </div>
      </div>

      <div class="text-xs text-slate-700">
        <strong>Shuma me fjalë:</strong> 
        <span class="font-medium italic text-slate-900">
          <%= transaction.amount.toFixed(2) %> Euro (EUR)
        </span>
      </div>
    </div>

    <!-- Nënshkrimet & Vula -->
    <div class="grid grid-cols-2 gap-8 pt-4 border-t border-slate-300 items-end">
      <div>
        <p class="text-[11px] text-slate-600 font-bold mb-10">Përfituesi (Pranoi Paratë):</p>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= transaction.employee.firstName %> <%= transaction.employee.lastName %></p>
        <p class="text-[10px] text-slate-500 font-mono">Nënshkrimi i Punëtorit</p>
      </div>

      <div class="text-right flex flex-col items-end">
        <p class="text-[11px] text-slate-600 font-bold mb-3">Përgjegjësi / Arkëtari (Dorëzoi Paratë):</p>
        <% if (company && company.stampUrl) { %>
          <img src="<%= company.stampUrl %>" alt="Vula" style="max-height: <%= company.stampHeight || 70 %>px;" class="mb-1">
        <% } %>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= transaction.recordedBy || 'KRONEER Financa' %></p>
        <p class="text-[10px] text-slate-500 font-mono">Vula & Nënshkrimi Zyrtar</p>
      </div>
    </div>

  </div>

</body>
</html>
