<div class="border-2 border-slate-800 rounded-2xl p-6 relative overflow-hidden bg-white shadow-sm">
    
    <!-- Header -->
    <div class="flex items-start justify-between border-b-2 border-slate-800 pb-4 mb-5">
      <div>
        <div class="flex items-center gap-3">
          <% const printLogo = (typeof company !== 'undefined' && company && company.logoUrl) ? company.logoUrl : (typeof company !== 'undefined' && company && company.logoDarkBgUrl ? company.logoDarkBgUrl : null); %>
          <% if (printLogo) { %>
            <div class="flex items-center justify-start mb-2">
              <img src="<%= printLogo %>" alt="<%= typeof company !== 'undefined' && company ? company.companyName : 'KRONEER' %>" style="height: 48px; width: auto; max-width: 100%; object-fit: contain; display: block;">
            </div>
          <% } else { %>
            <span class="text-2xl font-black tracking-tight text-slate-950 font-mono"><%= typeof company !== 'undefined' && company ? company.companyName : 'KRONEER' %></span>
          <% } %>
        </div>
        <div class="text-sm text-slate-600 space-y-0.5 mt-1"><div><%= company.address %>, <%= company.city %> • NUI: <%= company.taxNumber %></div><div>Tel: <%= company.phone %> • Email: <%= company.email %></div></div>
      </div>

      <div class="text-right">
        <span class="inline-block px-3 py-1 bg-slate-900 text-amber-400 font-mono font-black text-xs uppercase tracking-wider rounded-md mb-1">
          <%= transaction.type === 'BONUS' ? 'DËFTESË BONUSESH' : (transaction.type === 'ZBRITJE' ? 'FLETË ZBRITJEJE' : 'DËFTESË PAGESE NË KESH') %>
        </span>
        <p class="font-mono text-xs font-bold text-slate-900">Nr: <%= transaction.number %></p>
        <p class="text-sm text-slate-600 font-mono">Data: <%= new Date(transaction.date).toLocaleDateString('sq-AL') %></p>
      </div>
    </div>

    <!-- Të Dhënat e Përfituesit (Punëtorit) -->
    <div class="grid grid-cols-2 gap-4 mb-5 bg-slate-50 p-4 rounded-xl border border-slate-200">
      <div>
        <span class="text-xs uppercase font-bold text-slate-500 tracking-wider block">Punëtori / Përfituesi:</span>
        <span class="text-base font-black text-slate-950 block"><%= transaction.employee.firstName %> <%= transaction.employee.lastName %></span>
        <span class="text-sm text-slate-700 font-mono"><%= transaction.employee.code %> • <%= transaction.employee.position %></span>
        <span class="text-sm text-slate-600 block"><%= transaction.employee.department %></span>
      </div>

      <div class="text-right">
        <span class="text-xs uppercase font-bold text-slate-500 tracking-wider block">Lloji i Pagesës & Metoda:</span>
        <span class="text-xs font-bold text-slate-900 block"><%= transaction.category || 'Mëditje / Shpërblim' %></span>
        <span class="text-sm text-slate-700 font-mono"><%= transaction.paymentMethod %></span>
        <% if (transaction.project) { %>
          <span class="text-sm text-amber-700 font-medium block mt-1">Projekti: <%= transaction.project.name %> (<%= transaction.project.number %>)</span>
        <% } %>
      </div>
    </div>

    <!-- Shuma dhe Përshkrimi -->
    <div class="border border-slate-300 rounded-xl p-4 mb-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-3">
        <div>
          <span class="text-sm text-slate-600 block">Përshkrimi i Pagesës / Arsyetimi:</span>
          <span class="font-semibold text-slate-900 text-sm"><%= transaction.title %></span>
          <% if (transaction.notes) { %>
            <p class="text-sm text-slate-500 italic mt-0.5"><%= transaction.notes %></p>
          <% } %>
        </div>
        <div class="text-right pl-4">
          <span class="text-xs font-bold uppercase text-slate-500 block">Shuma e Paguar:</span>
          <span class="text-2xl font-black font-mono text-emerald-700">
            <%= transaction.amount.toFixed(2) %> €
          </span>
        </div>
      </div>

      <div class="text-sm text-slate-700">
        <strong>Shuma me fjalë:</strong> 
        <span class="font-medium italic text-slate-900">
          <%= transaction.amount.toFixed(2) %> Euro (EUR)
        </span>
      </div>
    </div>

    <!-- Nënshkrimet & Vula -->
    <div class="grid grid-cols-2 gap-8 pt-4 border-t border-slate-300 items-end">
      <div>
        <p class="text-sm text-slate-600 font-bold mb-14">Përfituesi (Pranoi Paratë):</p>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= transaction.employee.firstName %> <%= transaction.employee.lastName %></p>
        <p class="text-sm text-slate-500 font-mono">Nënshkrimi i Punëtorit</p>
      </div>

      <div class="text-right flex flex-col items-end">
        <p class="text-sm text-slate-600 font-bold mb-3">Përgjegjësi / Arkëtari (Dorëzoi Paratë):</p>
        <% if (company && company.stampUrl) { %>
          <img src="<%= company.stampUrl %>" alt="Vula" style="max-height: <%= Math.round((company.stampHeight || 70) * 1.6) %>px;" class="mb-1">
        <% } %>
        <div class="border-b border-slate-400 w-48 mb-1"></div>
        <p class="text-xs font-bold text-slate-900"><%= transaction.recordedBy || 'KRONEER Financa' %></p>
        <p class="text-sm text-slate-500 font-mono">Vula & Nënshkrimi Zyrtar</p>
      </div>
    </div>

  </div>
