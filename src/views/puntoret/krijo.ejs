<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono tracking-tight">REGJISTRO PUNTOR TË RI</h1>
      <span class="font-mono text-sm font-bold text-amber-400 bg-amber-500/15 border border-amber-500/30 px-3 py-1 rounded-lg">
        <%= nextCode %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Plotësoni të dhënat e punonjësit, orarin zyrtar të punës dhe llogaritjet financiare</p>
  </div>
  <a href="/puntoret" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo
  </a>
</div>

<form action="/puntoret/krijo" method="POST" x-data="{ createAccount: true }" class="space-y-6 max-w-4xl">
  
  <!-- 1. Të Dhënat Personale -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      1. Të Dhënat Personale & Kontakti
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Emri <span class="text-rose-400">*</span></label>
        <input type="text" name="firstName" required placeholder="P.sh. Agim" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Mbiemri <span class="text-rose-400">*</span></label>
        <input type="text" name="lastName" required placeholder="P.sh. Krasniqi" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri Personal / ID</label>
        <input type="text" name="personalNumber" placeholder="P.sh. 1234567890" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Telefonit</label>
        <input type="text" name="phone" placeholder="P.sh. +383 44 123 456" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Email Adresa</label>
        <input type="email" name="email" placeholder="P.sh. agim.krasniqi@kroneer.com" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
      </div>
    </div>
  </div>

  <!-- 2. Pozita & Organizimi -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      2. Pozita & Organizimi
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pozita e Punës <span class="text-rose-400">*</span></label>
        <input type="text" name="position" list="positions-list" required placeholder="P.sh. Menaxher Projekti ose Teknik" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400">
        <datalist id="positions-list">
          <% positions.forEach(pos => { %>
            <option value="<%= pos %>">
          <% }); %>
        </datalist>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Departamenti</label>
        <select name="department" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% departments.forEach(dep => { %>
            <option value="<%= dep %>"><%= dep %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi i Punonjësit</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Aktiv" selected>Aktiv</option>
          <option value="Pushim Vjetor">Pushim Vjetor</option>
          <option value="Pushim Mjekësor">Pushim Mjekësor</option>
          <option value="Pezulluar">Pezulluar</option>
          <option value="Joaktiv">Joaktiv</option>
        </select>
      </div>
    </div>
  </div>

  <!-- 3. Qasja & Llogaria e Kyçjes në Sistem (Login) -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-800 pb-3 gap-2">
      <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
        3. Qasja & Llogaria e Kyçjes në Portal (Username & Fjalëkalimi)
      </h3>
      <label class="flex items-center gap-2 cursor-pointer bg-amber-500/10 border border-amber-500/30 px-3 py-1.5 rounded-xl">
        <input type="checkbox" name="createAccount" value="true" x-model="createAccount" class="w-4 h-4 rounded border-slate-700 bg-slate-950 text-amber-500 focus:ring-amber-400">
        <span class="text-xs font-bold text-amber-300">Krijo llogari kyçjeje për këtë person</span>
      </label>
    </div>

    <!-- Forma e Krijimit të Llogarisë -->
    <div x-show="createAccount" class="p-4 rounded-xl bg-amber-500/5 border border-amber-500/20 space-y-3">
      <p class="text-xs text-amber-200">
        Vendosni të dhënat e kyçjes (Username & Fjalëkalimin) që punonjësi/menaxheri të hyjë në platformë me rolin e duhur:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-200 mb-1">Username për Kyçje <span class="text-amber-400">*</span></label>
          <input type="text" name="accountUsername" placeholder="p.sh. emri.mbiemri" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-100 placeholder-slate-500 font-mono focus:outline-none focus:border-amber-400">
          <span class="text-[10px] text-slate-400 mt-1 block">Nëse lihet bosh, gjenerohet automatikisht.</span>
        </div>

        <div>
          <label class="block font-semibold text-slate-200 mb-1">Fjalëkalimi Fillestar <span class="text-amber-400">*</span></label>
          <input type="password" name="accountPassword" placeholder="Fillestar: kroneer123" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-100 placeholder-slate-500 font-mono focus:outline-none focus:border-amber-400">
          <span class="text-[10px] text-slate-400 mt-1 block">Standardi fillestar: <code>kroneer123</code></span>
        </div>

        <div>
          <label class="block font-semibold text-slate-200 mb-1">Roli në Sistem <span class="text-rose-400">*</span></label>
          <select name="accountRole" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-100 font-semibold focus:outline-none focus:border-amber-400">
            <option value="MENAXHER_PROJEKTI">Menaxher Projekti & Ekipi (Shef)</option>
            <option value="TEKNIK" selected>Teknik / Punëtor Terreni</option>
            <option value="SHITJE">Shitje & CRM</option>
            <option value="FINANCE">Financë</option>
            <option value="ADMINISTRATOR">Administrator</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Ose lidh me llogari ekzistuese dhe cakto menaxherin -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-2">
      <div x-show="!createAccount">
        <label class="block font-semibold text-slate-300 mb-1">Ose lidh me Përdorues Ekzistues (Opsionale)</label>
        <select name="userId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Pa lidhje me User Login --</option>
          <% availableUsers.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.fullName %> (@<%= u.username %> - <%= u.role %>)</option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Menaxheri i Ekipit / Përgjegjësi</label>
        <select name="managerId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Pa menaxher të veçantë (Staf Qendror) --</option>
          <% if (typeof managers !== 'undefined' && managers) { %>
            <% managers.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.fullName %> (<%= m.role %>)</option>
            <% }); %>
          <% } %>
        </select>
      </div>
    </div>
  </div>

  <!-- 3. Orari Zyrtar & Paga -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      3. Orari Standard & Kushtet Financiare
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Orari i Fillimit (Shift Start)</label>
        <input type="time" name="shiftStart" value="08:00" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Orari i Mbarimit (Shift End)</label>
        <input type="time" name="shiftEnd" value="17:00" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pauza Standarde (Minuta)</label>
        <input type="number" name="breakMinutes" value="60" min="0" max="180" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Paga Mujore Bazë (€)</label>
        <input type="number" name="monthlySalary" step="0.01" value="0" placeholder="P.sh. 650.00" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pagesa për Orë (€)</label>
        <input type="number" name="hourlyRate" step="0.01" value="0" placeholder="P.sh. 4.50" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Data e Punësimit</label>
        <input type="date" name="hireDate" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-3">
        <label class="block font-semibold text-slate-300 mb-1">Shënime Shtesë</label>
        <textarea name="notes" rows="2" placeholder="Shënime mbi aftësitë profesionale, certifikatat EN 81-20, patentë shofer, etj." class="w-full p-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 leading-relaxed focus:outline-none focus:border-amber-400"></textarea>
      </div>
    </div>
  </div>

  <!-- Butonat e Veprimit -->
  <div class="flex items-center justify-end gap-3 pt-2">
    <a href="/puntoret" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-7 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span>RUAJ DHE REGJISTRO PUNTORIN</span>
    </button>
  </div>

</form>
