<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono tracking-tight">NDRYSHO PUNTORIN</h1>
      <span class="font-mono text-sm font-bold text-amber-400 bg-amber-500/15 border border-amber-500/30 px-3 py-1 rounded-lg">
        <%= employee.code %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Përditësoni të dhënat e punonjësit <%= employee.firstName %> <%= employee.lastName %></p>
  </div>
  <a href="/puntoret/<%= employee.id %>" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Kthehu te Profili
  </a>
</div>

<form action="/puntoret/<%= employee.id %>/ndrysho" method="POST" class="space-y-6 max-w-4xl">
  
  <!-- 1. Të Dhënat Personale -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      1. Të Dhënat Personale & Kontakti
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Emri <span class="text-rose-400">*</span></label>
        <input type="text" name="firstName" value="<%= employee.firstName %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Mbiemri <span class="text-rose-400">*</span></label>
        <input type="text" name="lastName" value="<%= employee.lastName %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri Personal / ID</label>
        <input type="text" name="personalNumber" value="<%= employee.personalNumber || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Telefonit</label>
        <input type="text" name="phone" value="<%= employee.phone || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Email Adresa</label>
        <input type="email" name="email" value="<%= employee.email || '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>
    </div>
  </div>

  <!-- 2. Pozita, Departamenti & Llogaria -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      2. Pozita & Organizimi
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pozita e Punës <span class="text-rose-400">*</span></label>
        <input type="text" name="position" list="positions-list" value="<%= employee.position %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <datalist id="positions-list">
          <% positions.forEach(pos => { %>
            <option value="<%= pos %>">
          <% }); %>
        </datalist>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Departamenti</label>
        <select name="department" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% departments.forEach(dep => { %>
            <option value="<%= dep %>" <%= employee.department === dep ? 'selected' : '' %>><%= dep %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi i Punonjësit</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Aktiv" <%= employee.status === 'Aktiv' ? 'selected' : '' %>>Aktiv</option>
          <option value="Pushim Vjetor" <%= employee.status === 'Pushim Vjetor' ? 'selected' : '' %>>Pushim Vjetor</option>
          <option value="Pushim Mjekësor" <%= employee.status === 'Pushim Mjekësor' ? 'selected' : '' %>>Pushim Mjekësor</option>
          <option value="Pezulluar" <%= employee.status === 'Pezulluar' ? 'selected' : '' %>>Pezulluar</option>
          <option value="Joaktiv" <%= employee.status === 'Joaktiv' ? 'selected' : '' %>>Joaktiv</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Lidh me Përdorues të Sistemit</label>
        <select name="userId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Pa lidhje me User Login --</option>
          <% availableUsers.forEach(u => { %>
            <option value="<%= u.id %>" <%= employee.userId === u.id ? 'selected' : '' %>><%= u.fullName %> (<%= u.username %> - <%= u.role %>)</option>
          <% }); %>
        </select>
      </div>

      <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Menaxheri i Ekipit / Përgjegjësi</label>
          <select name="managerId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
            <option value="">-- Pa menaxher të veçantë (Staf Qendror) --</option>
            <% if (typeof managers !== 'undefined' && managers) { %>
              <% managers.forEach(m => { %>
                <option value="<%= m.id %>" <%= employee.managerId === m.id ? 'selected' : '' %>><%= m.fullName %> (<%= m.role %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>
      <% } else { %>
        <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-3">
          <span class="block font-semibold text-cyan-200 mb-1">Menaxheri i ekipit</span>
          <span class="text-slate-400"><%= employee.manager ? employee.manager.fullName : (currentUser ? currentUser.fullName : 'Stafi qendror') %></span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 3. Orari Zyrtar & Paga -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      3. Orari Standard & Kushtet Financiare
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block font-semibold text-slate-300 mb-1">Orari i Fillimit (Shift Start)</label>
        <input type="time" name="shiftStart" value="<%= employee.shiftStart %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Orari i Mbarimit (Shift End)</label>
        <input type="time" name="shiftEnd" value="<%= employee.shiftEnd %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pauza Standarde (Minuta)</label>
        <input type="number" name="breakMinutes" value="<%= employee.breakMinutes %>" min="0" max="180" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Paga Mujore Bazë (€)</label>
        <input type="number" name="monthlySalary" step="0.01" value="<%= employee.monthlySalary %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Pagesa për Orë (€)</label>
        <input type="number" name="hourlyRate" step="0.01" value="<%= employee.hourlyRate %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Data e Punësimit</label>
        <input type="date" name="hireDate" value="<%= employee.hireDate ? new Date(employee.hireDate).toISOString().split('T')[0] : '' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-3">
        <label class="block font-semibold text-slate-300 mb-1">Shënime Shtesë</label>
        <textarea name="notes" rows="2" class="w-full p-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 leading-relaxed focus:outline-none focus:border-amber-400"><%= employee.notes || '' %></textarea>
      </div>
    </div>
  </div>

  <!-- Butonat e Veprimit -->
  <div class="flex items-center justify-between gap-3 pt-2">
    <form action="/puntoret/<%= employee.id %>/fshi" method="POST" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini këtë puntor nga sistemi?');">
      <button type="submit" class="px-4 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-bold transition-all">
        Fshi Puntorin
      </button>
    </form>

    <div class="flex items-center gap-3">
      <a href="/puntoret/<%= employee.id %>" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
        Anulo
      </a>
      <button type="submit" class="px-7 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>RUAJ NDRYSHIMET</span>
      </button>
    </div>
  </div>

</form>
