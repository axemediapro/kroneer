<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono tracking-tight">ORARI & PREZENCA (ATTENDANCE)</h1>
      <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
        Live Software
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Sistemi digjital i menaxhimit të orarit, hyrjeve/daljeve, pauzave dhe orëve shtesë</p>
  </div>

  <div class="flex items-center gap-2.5 flex-wrap">
    <a href="/prezenca/print?data=<%= filters.data %>" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 shadow transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Raporti i Printimit (PDF)</span>
    </a>

    <a href="/puntoret" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      <span>Regjistri i Puntorëve</span>
    </a>
  </div>
</div>

<!-- Paneli Kryesor i Kohës Live & Butonat e Veprimit të Puntorit -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
  
  <!-- Ora Live & Time Clock Terminal -->
  <div class="lg:col-span-7 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-6 shadow-2xl relative overflow-hidden" x-data="{
    selectedEmpId: '<%= currentLoggedEmployee ? currentLoggedEmployee.id : (allActiveEmployees[0] ? allActiveEmployees[0].id : '') %>',
    employeesData: <%= JSON.stringify(liveEmployeeBoard.map(b => ({
      id: b.employee.id,
      name: `${b.employee.firstName} ${b.employee.lastName}`,
      code: b.employee.code,
      position: b.employee.position,
      status: b.status,
      checkIn: b.attendance && b.attendance.checkIn ? new Date(b.attendance.checkIn).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : null,
      breakStart: b.attendance && b.attendance.breakStart ? new Date(b.attendance.breakStart).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : null,
      workedHours: b.attendance ? b.attendance.workedHours : 0
    }))) %>,
    currentTime: '',
    currentDate: '',
    init() {
      this.updateClock();
      setInterval(() => this.updateClock(), 1000);
    },
    updateClock() {
      const now = new Date();
      this.currentTime = now.toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      this.currentDate = now.toLocaleDateString('sq-AL', options);
    },
    getSelectedEmp() {
      return this.employeesData.find(e => e.id == this.selectedEmpId) || {};
    }
  }">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800/80 pb-4 mb-5">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-widest text-amber-500 font-bold block mb-0.5">Terminali i Prezencës Digjitale</span>
        <div class="text-xs text-slate-300 font-medium capitalize" x-text="currentDate"></div>
      </div>
      <div class="bg-slate-950/80 border border-slate-800 px-4 py-2 rounded-xl text-right">
        <span class="font-mono text-2xl sm:text-3xl font-black text-amber-400 tracking-wider block leading-none" x-text="currentTime">--:--:--</span>
        <span class="text-[9px] font-mono text-slate-500 uppercase tracking-widest">Ora Zyrtare KRONEER</span>
      </div>
    </div>

    <!-- Zgjedhja e Puntorit -->
    <div class="space-y-4">
      <div>
        <label class="block font-semibold text-slate-300 text-xs mb-1.5 flex items-center justify-between">
          <span>Përzgjidhni Puntorin:</span>
          <span class="text-[11px] font-mono text-amber-400 font-bold" x-text="'Statusi: ' + (getSelectedEmp().status || 'Pa Regjistrim')"></span>
        </label>
        <select x-model="selectedEmpId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 font-medium focus:outline-none focus:border-amber-400">
          <% allActiveEmployees.forEach(emp => { %>
            <option value="<%= emp.id %>" <%= currentLoggedEmployee && currentLoggedEmployee.id === emp.id ? 'selected' : '' %>>
              <%= emp.firstName %> <%= emp.lastName %> (<%= emp.code %> - <%= emp.position %>)
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Butonat Kryesor të Veprimit të Orarit (Nis Punën, Nis Pauzën, Përfundo Pauzën, Përfundo Punën) -->
      <div class="pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          
          <!-- Butoni 1: Nis Punën (Clock In) -->
          <form action="/prezenca/nis-punen" method="POST">
            <input type="hidden" name="employeeId" :value="selectedEmpId">
            <input type="hidden" name="location" value="Zyra Qendrore / Terren">
            <button type="submit" 
                    :disabled="getSelectedEmp().status === 'Në Punë' || getSelectedEmp().status === 'Në Pauzë'"
                    :class="getSelectedEmp().status === 'Në Punë' || getSelectedEmp().status === 'Në Pauzë' ? 'opacity-40 cursor-not-allowed bg-slate-800 text-slate-400 border border-slate-700' : 'bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20'"
                    class="w-full py-3 px-4 rounded-xl font-black text-xs transition-all flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>NIS PUNËN (CLOCK IN)</span>
            </button>
          </form>

          <!-- Butoni 2: Nis / Mbyll Pauzën (Break Toggle) -->
          <template x-if="getSelectedEmp().status === 'Në Pauzë'">
            <form action="/prezenca/perfundo-pauzen" method="POST">
              <input type="hidden" name="employeeId" :value="selectedEmpId">
              <button type="submit" class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-black text-xs shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 animate-pulse">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                <span>PËRFUNDO PAUZËN (KTHEHU)</span>
              </button>
            </form>
          </template>

          <template x-if="getSelectedEmp().status !== 'Në Pauzë'">
            <form action="/prezenca/nis-pauzen" method="POST">
              <input type="hidden" name="employeeId" :value="selectedEmpId">
              <button type="submit" 
                      :disabled="getSelectedEmp().status !== 'Në Punë'"
                      :class="getSelectedEmp().status !== 'Në Punë' ? 'opacity-40 cursor-not-allowed bg-slate-800 text-slate-400 border border-slate-700' : 'bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 shadow-md shadow-amber-500/20'"
                      class="w-full py-3 px-4 rounded-xl font-black text-xs transition-all flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>NIS PAUZËN (BREAK)</span>
              </button>
            </form>
          </template>

          <!-- Butoni 3: Përfundo Punën (Clock Out) -->
          <div class="sm:col-span-2">
            <form action="/prezenca/perfundo-punen" method="POST">
              <input type="hidden" name="employeeId" :value="selectedEmpId">
              <button type="submit" 
                      :disabled="getSelectedEmp().status !== 'Në Punë' && getSelectedEmp().status !== 'Në Pauzë'"
                      :class="getSelectedEmp().status !== 'Në Punë' && getSelectedEmp().status !== 'Në Pauzë' ? 'opacity-40 cursor-not-allowed bg-slate-800 text-slate-400 border border-slate-700' : 'bg-gradient-to-r from-rose-500 to-rose-600 hover:from-rose-400 hover:to-rose-500 text-slate-950 shadow-lg shadow-rose-500/20'"
                      class="w-full py-3 px-4 rounded-xl font-black text-xs transition-all flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
                <span>PËRFUNDO PUNËN / MBYLL TURNIN (CLOCK OUT)</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Statistikat Ditore & Shtimi Manual -->
  <div class="lg:col-span-5 space-y-4">
    <!-- Përmbledhja Ditore KPI -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
      <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider border-b border-slate-800 pb-2 mb-3 flex items-center justify-between">
        <span>Gjendja e Stafit Sot</span>
        <span class="text-[10px] font-mono text-amber-400 font-bold"><%= formatDate(new Date()) %></span>
      </h3>
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
          <span class="text-slate-400 text-[11px] block">Në Punë Tani:</span>
          <span class="text-xl font-black text-emerald-400 font-mono"><%= stats.workingCount %></span>
        </div>
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
          <span class="text-slate-400 text-[11px] block">Në Pauzë Tani:</span>
          <span class="text-xl font-black text-amber-400 font-mono"><%= stats.onBreakCount %></span>
        </div>
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
          <span class="text-slate-400 text-[11px] block">Përfunduan Turnin:</span>
          <span class="text-xl font-black text-cyan-400 font-mono"><%= stats.completedCount %></span>
        </div>
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80">
          <span class="text-slate-400 text-[11px] block">Orë Pune Realizuar:</span>
          <span class="text-xl font-black text-slate-100 font-mono"><%= stats.totalHoursDone %> orë</span>
        </div>
      </div>
    </div>

    <!-- Regjistrimi Manual i Orarit nga Menaxheri -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl" x-data="{ openManual: false }">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Regjistrim Manual i Orarit</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Shto ose korrigjo prezencën për çdo ditë</p>
        </div>
        <button @click="openManual = !openManual" type="button" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 font-bold text-xs transition-all">
          <span x-text="openManual ? 'Mbyll' : '+ Regjistro Manualisht'"></span>
        </button>
      </div>

      <div x-show="openManual" x-cloak class="mt-4 pt-4 border-t border-slate-800 space-y-3">
        <form action="/prezenca/manual" method="POST" class="space-y-3 text-xs">
          <div>
            <label class="block font-semibold text-slate-300 mb-1">Puntori</label>
            <select name="employeeId" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
              <% allActiveEmployees.forEach(emp => { %>
                <option value="<%= emp.id %>"><%= emp.firstName %> <%= emp.lastName %> (<%= emp.code %>)</option>
              <% }); %>
            </select>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Data</label>
              <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Hyrja (Nisja)</label>
              <input type="time" name="checkIn" value="08:00" required class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Dalja (Mbarimi)</label>
              <input type="time" name="checkOut" value="17:00" class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Pauza (Minuta)</label>
              <input type="number" name="totalBreakMinutes" value="60" min="0" class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 font-mono focus:outline-none focus:border-amber-400">
            </div>
            <div>
              <label class="block font-semibold text-slate-300 mb-1">Lokacioni</label>
              <input type="text" name="location" value="Zyra Qendrore" class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <button type="submit" class="w-full py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md shadow-amber-500/20">
            Ruaj Regjistrimin Manual
          </button>
        </form>
      </div>
    </div>
  </div>

</div>

<!-- Tabela Live e të Gjithë Puntorëve Sot (Live Attendance Matrix) -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden mb-6">
  <div class="p-4 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-950/60">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider font-mono">
        Prezenca e Stafit Ditën e Sotme (<%= formatDate(filters.data) %>)
      </h3>
    </div>

    <!-- Filtri i Datës dhe Departamentit -->
    <form action="/prezenca" method="GET" class="flex items-center gap-2 text-xs flex-wrap">
      <input type="date" name="data" value="<%= filters.data %>" class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      
      <select name="departamenti" class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200 focus:outline-none focus:border-amber-400">
        <option value="te-gjitha">Të gjitha Departamentet</option>
        <% departments.forEach(dep => { %>
          <option value="<%= dep %>" <%= filters.departamenti === dep ? 'selected' : '' %>><%= dep %></option>
        <% }); %>
      </select>

      <button type="submit" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all">
        Filtro
      </button>
    </form>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-950/80 border-b border-slate-800 text-slate-400 uppercase text-[10px] tracking-wider font-mono">
        <tr>
          <th class="py-3.5 px-4">Puntori</th>
          <th class="py-3.5 px-4">Pozita & Departamenti</th>
          <th class="py-3.5 px-4">Hyrja (Clock In)</th>
          <th class="py-3.5 px-4">Pauza</th>
          <th class="py-3.5 px-4">Dalja (Clock Out)</th>
          <th class="py-3.5 px-4">Orë Pune Neto</th>
          <th class="py-3.5 px-4">Statusi</th>
          <th class="py-3.5 px-4 text-right">Veprime të Shpejta</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% if (liveEmployeeBoard && liveEmployeeBoard.length > 0) { %>
          <% liveEmployeeBoard.forEach(item => { %>
            <% const emp = item.employee; %>
            <% const att = item.attendance; %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="py-3.5 px-4">
                <a href="/puntoret/<%= emp.id %>" class="font-bold text-slate-100 hover:text-amber-400 text-sm block">
                  <%= emp.firstName %> <%= emp.lastName %>
                </a>
                <span class="text-[10px] font-mono text-slate-500"><%= emp.code %></span>
              </td>

              <td class="py-3.5 px-4">
                <span class="font-semibold text-slate-200 block"><%= emp.position %></span>
                <span class="text-[10px] text-amber-500/90"><%= emp.department %></span>
              </td>

              <td class="py-3.5 px-4 font-mono font-semibold">
                <% if (att && att.checkIn) { %>
                  <span class="text-emerald-400"><%= new Date(att.checkIn).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) %></span>
                <% } else { %>
                  <span class="text-slate-600">-</span>
                <% } %>
              </td>

              <td class="py-3.5 px-4 font-mono">
                <% if (att && att.status === 'Në Pauzë') { %>
                  <span class="text-amber-400 font-bold flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
                    Në Pauzë...
                  </span>
                <% } else if (att && att.totalBreakMinutes > 0) { %>
                  <span class="text-slate-300"><%= att.totalBreakMinutes %> min</span>
                <% } else { %>
                  <span class="text-slate-600">0 min</span>
                <% } %>
              </td>

              <td class="py-3.5 px-4 font-mono font-semibold">
                <% if (att && att.checkOut) { %>
                  <span class="text-rose-400"><%= new Date(att.checkOut).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) %></span>
                <% } else if (att && att.status === 'Në Punë') { %>
                  <span class="text-emerald-400/80 font-normal">Duke punuar...</span>
                <% } else { %>
                  <span class="text-slate-600">-</span>
                <% } %>
              </td>

              <td class="py-3.5 px-4 font-mono font-bold">
                <% if (att && att.workedHours > 0) { %>
                  <span class="text-slate-100"><%= att.workedHours %> orë</span>
                  <% if (att.overtimeMinutes > 0) { %>
                    <span class="text-cyan-400 text-[10px] block">+<%= (att.overtimeMinutes / 60).toFixed(1) %> orë shtesë</span>
                  <% } %>
                <% } else if (att && att.status === 'Në Punë') { %>
                  <span class="text-emerald-400 font-normal">Në proces...</span>
                <% } else { %>
                  <span class="text-slate-600">-</span>
                <% } %>
              </td>

              <td class="py-3.5 px-4">
                <% if (item.status === 'Pa Regjistrim') { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">
                    Pa Regjistrim
                  </span>
                <% } else if (item.status === 'Në Punë') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Në Punë
                  </span>
                <% } else if (item.status === 'Në Pauzë') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                    Në Pauzë
                  </span>
                <% } else if (item.status === 'Përfunduar') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                    Përfunduar
                  </span>
                <% } %>
              </td>

              <td class="py-3.5 px-4 text-right">
                <div class="flex items-center justify-end gap-1">
                  <% if (item.status === 'Pa Regjistrim' || item.status === 'Përfunduar') { %>
                    <form action="/prezenca/nis-punen" method="POST" class="inline">
                      <input type="hidden" name="employeeId" value="<%= emp.id %>">
                      <button type="submit" title="Nis Punën" class="p-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                      </button>
                    </form>
                  <% } %>

                  <% if (item.status === 'Në Punë') { %>
                    <form action="/prezenca/nis-pauzen" method="POST" class="inline">
                      <input type="hidden" name="employeeId" value="<%= emp.id %>">
                      <button type="submit" title="Nis Pauzën" class="p-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      </button>
                    </form>

                    <form action="/prezenca/perfundo-punen" method="POST" class="inline">
                      <input type="hidden" name="employeeId" value="<%= emp.id %>">
                      <button type="submit" title="Përfundo Punën" class="p-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
                      </button>
                    </form>
                  <% } %>

                  <% if (item.status === 'Në Pauzë') { %>
                    <form action="/prezenca/perfundo-pauzen" method="POST" class="inline">
                      <input type="hidden" name="employeeId" value="<%= emp.id %>">
                      <button type="submit" title="Përfundo Pauzën" class="p-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
                      </button>
                    </form>

                    <form action="/prezenca/perfundo-punen" method="POST" class="inline">
                      <input type="hidden" name="employeeId" value="<%= emp.id %>">
                      <button type="submit" title="Përfundo Punën" class="p-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
                      </button>
                    </form>
                  <% } %>

                  <a href="/puntoret/<%= emp.id %>" title="Kartela e plotë" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 border border-slate-700 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
