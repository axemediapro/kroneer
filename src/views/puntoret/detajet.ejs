<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight">
        <%= employee.firstName %> <%= employee.lastName %>
      </h1>
      <span class="font-mono text-sm font-bold text-amber-400 bg-amber-500/15 border border-amber-500/30 px-3 py-1 rounded-lg">
        <%= employee.code %>
      </span>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase <%= employee.status === 'Aktiv' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-300 border border-rose-500/30' %>">
        <%= employee.status %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">
      <strong class="text-slate-200"><%= employee.position %></strong> • Departamenti: <span class="text-amber-400 font-medium"><%= employee.department %></span>
      <% if (employee.manager) { %>
        • Menaxheri i Ekipit: <strong class="text-cyan-400 font-medium"><%= employee.manager.fullName %></strong>
      <% } %>
    </p>
  </div>

  <div class="flex items-center gap-2 flex-wrap">
    <button onclick="hapModalKesh()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-md shadow-amber-500/20 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      <span>+ SHTO KESH</span>
    </button>

    <% if (typeof canAssignBonus !== 'undefined' && canAssignBonus) { %>
    <button onclick="hapModalBonus()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-black text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>+ SHTO BONUS</span>
    </button>
    <% } %>

    <a href="/puntoret/<%= employee.id %>/ndrysho" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span>Ndrysho</span>
    </a>

    <a href="/prezenca" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>Prezenca Live</span>
    </a>
  </div>
</div>

<!-- Kartat Kryesore të Informacionit -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  
  <!-- 1. Kartela e Statusit të Sotëm (Clock In / Break / Out) -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
      <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Statusi i Sotëm
      </h3>
      <span class="text-[11px] text-slate-400 font-mono"><%= formatDate(new Date()) %></span>
    </div>

    <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800/80 text-center space-y-2">
      <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Gjendja Aktuale</span>
      <% if (!todayAttendance || todayAttendance.status === 'Pa Regjistrim') { %>
        <div class="text-lg font-black text-slate-400 font-mono">Pa Regjistrim Sot</div>
        <p class="text-[11px] text-slate-500">Puntori nuk e ka nisur orarin e punës për ditën e sotme.</p>
      <% } else if (todayAttendance.status === 'Në Punë') { %>
        <div class="text-xl font-black text-emerald-400 font-mono flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          NË PUNË AKTIV
        </div>
        <div class="text-xs text-slate-300 font-mono">
          Nisur më: <strong class="text-emerald-400"><%= todayAttendance.checkIn ? new Date(todayAttendance.checkIn).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : '-' %></strong>
        </div>
      <% } else if (todayAttendance.status === 'Në Pauzë') { %>
        <div class="text-xl font-black text-amber-400 font-mono flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
          NË PAUZË
        </div>
        <div class="text-xs text-slate-300 font-mono">
          Pauza nisi më: <strong class="text-amber-400"><%= todayAttendance.breakStart ? new Date(todayAttendance.breakStart).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : '-' %></strong>
        </div>
      <% } else if (todayAttendance.status === 'Përfunduar') { %>
        <div class="text-xl font-black text-cyan-400 font-mono">
          PËRFUNDUAR
        </div>
        <div class="text-xs text-slate-300 font-mono">
          Punuar: <strong class="text-cyan-300"><%= todayAttendance.workedHours %> Orë</strong> • Pauzë: <%= todayAttendance.totalBreakMinutes %> min
        </div>
      <% } %>
    </div>

    <!-- Butonat e Veprimit të Shpejtë -->
    <div class="space-y-2 pt-1">
      <% if (!todayAttendance || todayAttendance.status === 'Pa Regjistrim' || todayAttendance.status === 'Përfunduar') { %>
        <form action="/prezenca/nis-punen" method="POST">
          <input type="hidden" name="employeeId" value="<%= employee.id %>">
          <input type="hidden" name="location" value="Zyra Qendrore">
          <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-black text-xs shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
            <span>NIS PUNËN (CLOCK IN)</span>
          </button>
        </form>
      <% } %>

      <% if (todayAttendance && todayAttendance.status === 'Në Punë') { %>
        <div class="grid grid-cols-2 gap-2">
          <form action="/prezenca/nis-pauzen" method="POST">
            <input type="hidden" name="employeeId" value="<%= employee.id %>">
            <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 transition-all flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Nis Pauzën</span>
            </button>
          </form>

          <form action="/prezenca/perfundo-punen" method="POST">
            <input type="hidden" name="employeeId" value="<%= employee.id %>">
            <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-rose-500 hover:bg-rose-400 text-slate-950 font-bold text-xs shadow-md shadow-rose-500/20 transition-all flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
              <span>Mbyll Turnin</span>
            </button>
          </form>
        </div>
      <% } %>

      <% if (todayAttendance && todayAttendance.status === 'Në Pauzë') { %>
        <div class="grid grid-cols-2 gap-2">
          <form action="/prezenca/perfundo-pauzen" method="POST">
            <input type="hidden" name="employeeId" value="<%= employee.id %>">
            <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>
              <span>Mbyll Pauzën</span>
            </button>
          </form>

          <form action="/prezenca/perfundo-punen" method="POST">
            <input type="hidden" name="employeeId" value="<%= employee.id %>">
            <button type="submit" class="w-full py-2.5 px-3 rounded-xl bg-rose-500 hover:bg-rose-400 text-slate-950 font-bold text-xs shadow-md shadow-rose-500/20 transition-all flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
              <span>Mbyll Turnin</span>
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 2. Detajet e Kontratës & Pagës -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-3 text-xs">
    <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center justify-between">
      <span>Të Dhënat e Pagës & Orarit</span>
      <span class="text-amber-400 font-mono text-[11px]"><%= employee.shiftStart %> - <%= employee.shiftEnd %></span>
    </h3>

    <div class="space-y-2.5">
      <div class="flex items-center justify-between">
        <span class="text-slate-400">Paga Mujore Bazë:</span>
        <span class="font-mono font-bold text-slate-100 text-sm"><%= employee.monthlySalary > 0 ? formatCurrency(employee.monthlySalary) : '0.00 €' %></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-400">Pagesa për Orë:</span>
        <span class="font-mono font-bold text-slate-200"><%= employee.hourlyRate > 0 ? formatCurrency(employee.hourlyRate) + '/orë' : '-' %></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="text-slate-400">Data e Punësimit:</span>
        <span class="font-medium text-slate-300"><%= formatDate(employee.hireDate) %></span>
      </div>

      <% if (employee.manager) { %>
        <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between">
          <span class="text-slate-400">Menaxher Ekipi:</span>
          <span class="font-bold text-cyan-400 font-mono"><%= employee.manager.fullName %></span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 3. Kontakti, Identifikimi & Llogaria e Kyçjes -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-3 text-xs flex flex-col justify-between">
    <div class="space-y-3">
      <h3 class="text-xs font-bold text-slate-100 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center justify-between">
        <span>Kontakti & Identifikimi</span>
        <span class="text-[10px] text-slate-500 font-mono"><%= employee.code %></span>
      </h3>

      <div class="space-y-2">
        <div>
          <span class="text-slate-500 block text-[11px]">Telefoni:</span>
          <span class="font-mono font-semibold text-slate-200"><%= employee.phone || '-' %></span>
        </div>
        <div>
          <span class="text-slate-500 block text-[11px]">Email:</span>
          <span class="text-slate-200"><%= employee.email || '-' %></span>
        </div>
        <div>
          <span class="text-slate-500 block text-[11px]">Numri Personal / ID:</span>
          <span class="font-mono text-slate-200"><%= employee.personalNumber || '-' %></span>
        </div>
      </div>
    </div>

    <!-- Seksioni i Llogarisë së Kyçjes (Login Account) -->
    <div class="pt-3 border-t border-slate-800/80">
      <% if (employee.user) { %>
        <div class="p-3 rounded-xl bg-slate-950/80 border border-emerald-500/30 flex items-center justify-between">
          <div>
            <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider block">✓ Ka Llogari Kyçjeje</span>
            <span class="font-mono font-bold text-slate-200 text-xs">@<%= employee.user.username %></span>
            <span class="text-[10px] text-cyan-300 font-mono block"><%= employee.user.role %></span>
          </div>
          <button type="button" onclick="hapModalLlogaria('<%= employee.user.username %>', '<%= employee.user.role %>', '<%= employee.user.email || '' %>')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 transition-colors">
            Ndrysho
          </button>
        </div>
      <% } else { %>
        <div class="p-3 rounded-xl bg-slate-950/80 border border-amber-500/30 flex items-center justify-between">
          <div>
            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider block">Pa Llogari Kyçjeje</span>
            <span class="text-[11px] text-slate-400">Nuk mund të kyçet në portal</span>
          </div>
          <button type="button" onclick="hapModalLlogaria('', '<%= employee.position && employee.position.toLowerCase().includes('menaxher') ? 'MENAXHER_PROJEKTI' : 'TEKNIK' %>', '<%= employee.email || '' %>')" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow transition-colors">
            + Krijo Llogari
          </button>
        </div>
      <% } %>
    </div>
  </div>

</div>

<!-- ========================================================================= -->
<!-- SEKSIONI FINANCIAR: KESH & BONUSET E PUNËTORIT -->
<!-- ========================================================================= -->
<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-black text-slate-100 font-mono flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-amber-400"></span>
      Financat, Kesh & Bonuset e Punëtorit
    </h2>

    <div class="flex items-center gap-2">
      <button onclick="hapModalKesh()" class="px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-400 font-bold text-xs border border-amber-500/30 transition-colors">
        + Kesh / Avancë
      </button>
      <% if (typeof canAssignBonus !== 'undefined' && canAssignBonus) { %>
      <button onclick="hapModalBonus()" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400 font-bold text-xs border border-emerald-500/30 transition-colors">
        + Bonus
      </button>
      <% } %>
    </div>
  </div>

  <!-- Kartat e Bilancit Financiar -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
      <span class="text-slate-400 text-xs font-semibold block mb-1">Paga Bazë</span>
      <span class="text-xl font-black text-slate-200 font-mono"><%= formatCurrency(stats.baseSalary) %></span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
      <span class="text-slate-400 text-xs font-semibold block mb-1">Totali i Bonuseve (+)</span>
      <span class="text-xl font-black text-emerald-400 font-mono"><%= formatCurrency(stats.totalBonuses) %></span>
      <span class="text-[10px] text-slate-500 block mt-0.5"><%= employee.transactions.filter(t => t.type === 'BONUS').length %> herë</span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
      <span class="text-slate-400 text-xs font-semibold block mb-1">Kesh / Avanca të Dhëna (-)</span>
      <span class="text-xl font-black text-amber-400 font-mono"><%= formatCurrency(stats.totalCashAdvances) %></span>
      <span class="text-[10px] text-slate-500 block mt-0.5"><%= employee.transactions.filter(t => t.type === 'KESH_AVANC' || t.type === 'PAGESE_KESH').length %> transaksione</span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl">
      <span class="text-slate-400 text-xs font-semibold block mb-1">Neto e Llogaritur</span>
      <span class="text-xl font-black text-cyan-400 font-mono"><%= formatCurrency(stats.netPayableEstimated) %></span>
      <span class="text-[10px] text-slate-500 block mt-0.5">Paga + Bonuse - Kesh</span>
    </div>
  </div>

  <!-- Tabela e Transaksioneve të Keshit & Bonuseve -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-3.5 border-b border-slate-800 bg-slate-950/40 flex items-center justify-between">
      <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Historiku i Pagesave Kesh & Bonuseve</span>
      <a href="/puntoret/financat/kesh-bonuse" class="text-xs text-amber-400 hover:underline">Shiko të Gjitha →</a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 uppercase text-[10px] tracking-wider font-mono">
          <tr>
            <th class="py-2.5 px-4">Nr.</th>
            <th class="py-2.5 px-4">Lloji</th>
            <th class="py-2.5 px-4">Kategoria</th>
            <th class="py-2.5 px-4">Përshkrimi / Projekti</th>
            <th class="py-2.5 px-4">Data</th>
            <th class="py-2.5 px-4">Shuma</th>
            <th class="py-2.5 px-4">Regjistruar nga</th>
            <th class="py-2.5 px-4 text-right">Veprime</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if (employee.transactions && employee.transactions.length > 0) { %>
            <% employee.transactions.forEach(t => { %>
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="py-2.5 px-4 font-mono font-bold text-amber-400"><%= t.number %></td>
                <td class="py-2.5 px-4">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= t.type === 'BONUS' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : (t.type === 'ZBRITJE' ? 'bg-rose-500/20 text-rose-300' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30') %>">
                    <%= t.type === 'BONUS' ? 'BONUS' : (t.type === 'ZBRITJE' ? 'ZBRITJE' : 'KESH') %>
                  </span>
                </td>
                <td class="py-2.5 px-4 text-slate-300"><%= t.category || '-' %></td>
                <td class="py-2.5 px-4">
                  <span class="text-slate-200 font-medium block"><%= t.title %></span>
                  <% if (t.project) { %>
                    <span class="text-[10px] text-amber-400/90 font-mono">Prj: <%= t.project.name %></span>
                  <% } %>
                </td>
                <td class="py-2.5 px-4 font-mono text-slate-400"><%= formatDate(t.date) %></td>
                <td class="py-2.5 px-4 font-mono text-xs font-black <%= t.type === 'BONUS' ? 'text-emerald-400' : (t.type === 'ZBRITJE' ? 'text-rose-400' : 'text-amber-400') %>">
                  <%= t.type === 'ZBRITJE' ? '-' : '+' %><%= t.amount.toFixed(2) %> €
                </td>
                <td class="py-2.5 px-4 text-slate-400 text-[11px] font-mono"><%= t.recordedBy || 'Admin' %></td>
                <td class="py-2.5 px-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <a href="/puntoret/transaksionet/<%= t.id %>/print" target="_blank" title="Dëftesë / Fletëpagesë" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    </a>

                    <form action="/puntoret/transaksionet/<%= t.id %>/fshi" method="POST" onsubmit="return confirm('A jeni të sigurt që dëshironi të fshini këtë regjistrim?')">
                      <button type="submit" title="Fshi" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="py-6 text-center text-slate-500 text-xs">
                Nuk ka transaksione kesh apo bonuse të regjistruara për këtë punëtor.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- SEKSIONI I PROJEKTEVE & INTERVENIMEVE TË MONTERIT -->
<!-- ========================================================================= -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  
  <!-- Projektet ku është anëtar ekipi -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
      <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        Projektet e Caktuara
      </h3>
      <span class="text-[11px] font-mono text-slate-400"><%= employee.projectMemberships ? employee.projectMemberships.length : 0 %> Projekte</span>
    </div>

    <div class="space-y-2 max-h-60 overflow-y-auto">
      <% if (employee.projectMemberships && employee.projectMemberships.length > 0) { %>
        <% employee.projectMemberships.forEach(pm => { %>
          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center justify-between">
            <div>
              <a href="/projektet/<%= pm.projectId %>" class="font-bold text-xs text-slate-200 hover:text-amber-400 transition-colors">
                <%= pm.project.name %>
              </a>
              <span class="text-[10px] text-slate-500 font-mono block"><%= pm.project.number %> • Klienti: <%= pm.project.customer ? (pm.project.customer.companyName || pm.project.customer.firstName) : '-' %></span>
            </div>
            <div class="text-right">
              <span class="px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-400 font-mono text-[10px] font-bold border border-amber-500/30">
                <%= pm.roleInProject || 'Monter' %>
              </span>
              <span class="text-[10px] text-slate-400 block mt-0.5"><%= pm.project.stage %></span>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-xs text-slate-500 text-center py-6">Puntori nuk është caktuar ende në ndonjë projekt aktiv.</p>
      <% } %>
    </div>
  </div>

  <!-- Intervenimet në Terren ku ka marrë pjesë -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
      <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
        Intervenimet në Terren
      </h3>
      <span class="text-[11px] font-mono text-slate-400"><%= employee.interventionAssignments ? employee.interventionAssignments.length : 0 %> Intervenime</span>
    </div>

    <div class="space-y-2 max-h-60 overflow-y-auto">
      <% if (employee.interventionAssignments && employee.interventionAssignments.length > 0) { %>
        <% employee.interventionAssignments.forEach(ia => { %>
          <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center justify-between">
            <div>
              <a href="/intervenimet/<%= ia.interventionId %>" class="font-bold text-xs text-slate-200 hover:text-cyan-400 transition-colors">
                <%= ia.intervention.title %>
              </a>
              <span class="text-[10px] text-slate-500 font-mono block"><%= ia.intervention.number %> • Data: <%= formatDate(ia.intervention.date) %></span>
            </div>
            <div class="text-right">
              <span class="px-2 py-0.5 rounded-md bg-cyan-500/15 text-cyan-300 font-mono text-[10px] font-bold border border-cyan-500/30">
                <%= ia.roleInTeam || 'Monter' %>
              </span>
              <span class="text-[10px] text-slate-400 block mt-0.5"><%= ia.intervention.status %></span>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-xs text-slate-500 text-center py-6">Nuk ka intervenime të regjistruara për këtë punëtor.</p>
      <% } %>
    </div>
  </div>

</div>

<!-- ========================================================================= -->
<!-- SEKSIONI I PREZENCËS MUJORE -->
<!-- ========================================================================= -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden mb-6">
  <div class="p-4 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-950/40">
    <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Historiku i Prezencës Mujore (<%= stats.totalDaysWorked %> Ditë • <%= stats.totalWorkedHours %> Orë)
    </h3>

    <form action="/puntoret/<%= employee.id %>" method="GET" class="flex items-center gap-2 text-xs">
      <select name="muaji" class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200 focus:outline-none focus:border-amber-400">
        <% const monthNames = ['Janar', 'Shkurt', 'Mars', 'Prill', 'Maj', 'Qershor', 'Korrik', 'Gusht', 'Shtator', 'Tetor', 'Nëntor', 'Dhjetor']; %>
        <% monthNames.forEach((m, idx) => { %>
          <option value="<%= idx + 1 %>" <%= selectedMonth === (idx + 1) ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>

      <select name="viti" class="px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200 focus:outline-none focus:border-amber-400">
        <% for (let reportYear = new Date().getFullYear(); reportYear >= new Date().getFullYear() - 5; reportYear--) { %>
          <option value="<%= reportYear %>" <%= selectedYear === reportYear ? 'selected' : '' %>><%= reportYear %></option>
        <% } %>
      </select>

      <button type="submit" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold border border-slate-700">
        Filtro
      </button>
    </form>
    <a href="/prezenca/print?employeeId=<%= employee.id %>&muaji=<%= selectedMonth %>&viti=<%= selectedYear %>" target="_blank" class="inline-flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold">
      <i data-lucide="file-chart-column" class="w-4 h-4"></i> Raporti mujor
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-950/60 border-b border-slate-800 text-slate-400 uppercase text-[10px] tracking-wider font-mono">
        <tr>
          <th class="py-3 px-4">Data</th>
          <th class="py-3 px-4">Nisja (Hyrja)</th>
          <th class="py-3 px-4">Pauza Totale</th>
          <th class="py-3 px-4">Mbarimi (Dalja)</th>
          <th class="py-3 px-4">Orë Neto</th>
          <th class="py-3 px-4">Orë Shtesë</th>
          <th class="py-3 px-4">Statusi</th>
          <th class="py-3 px-4">Lokacioni / Shënime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% if (employee.attendances && employee.attendances.length > 0) { %>
          <% employee.attendances.forEach(att => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="py-3 px-4 font-mono font-bold text-slate-200"><%= formatDate(att.date) %></td>
              <td class="py-3 px-4 font-mono text-emerald-400 font-semibold"><%= att.checkIn ? new Date(att.checkIn).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : '-' %></td>
              <td class="py-3 px-4 font-mono text-amber-400"><%= att.totalBreakMinutes > 0 ? (att.totalBreakMinutes + ' min') : '-' %></td>
              <td class="py-3 px-4 font-mono text-rose-400 font-semibold"><%= att.checkOut ? new Date(att.checkOut).toLocaleTimeString('sq-AL', { hour: '2-digit', minute: '2-digit' }) : (att.status === 'Në Punë' ? 'Aktiv...' : '-') %></td>
              <td class="py-3 px-4 font-mono font-bold text-slate-100"><%= att.workedHours > 0 ? (att.workedHours + ' orë') : '-' %></td>
              <td class="py-3 px-4 font-mono text-cyan-400 font-bold"><%= att.overtimeMinutes > 0 ? ((att.overtimeMinutes / 60).toFixed(1) + ' orë') : '-' %></td>
              <td class="py-3 px-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= att.status === 'Në Punë' ? 'bg-emerald-500/20 text-emerald-300' : (att.status === 'Në Pauzë' ? 'bg-amber-500/20 text-amber-300' : 'bg-cyan-500/20 text-cyan-300') %>">
                  <%= att.status %>
                </span>
              </td>
              <td class="py-3 px-4 text-slate-400">
                <span><%= att.location || '-' %></span>
                <% if (att.notes) { %>
                  <span class="text-slate-500 block text-[10px]"><%= att.notes %></span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="py-8 text-center text-slate-500 text-xs">
              Nuk ka regjistrime të prezencës për periudhën e përzgjedhur.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal: Shto Kesh / Bonus për këtë punëtor -->
<div id="modal-transaksion-puntori" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
      <h3 id="modal-title" class="text-sm font-bold text-slate-100 uppercase tracking-wider flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        Regjistro Pagesë
      </h3>
      <button type="button" onclick="mbyllModal()" class="text-slate-400 hover:text-slate-200">
        ✕
      </button>
    </div>

    <form action="/puntoret/transaksionet" method="POST" class="space-y-3.5 text-xs">
      <input type="hidden" name="employeeId" value="<%= employee.id %>">
      <input type="hidden" id="form-type" name="type" value="KESH_AVANC">

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Shuma (€) *</label>
          <input type="number" step="0.01" min="0.5" name="amount" required placeholder="p.sh. 100.00" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl font-mono text-amber-400 font-bold focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block text-slate-400 font-semibold mb-1">Data</label>
          <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
        </div>
      </div>

      <div>
        <label class="block text-slate-400 font-semibold mb-1">Kategoria</label>
        <input type="text" id="form-category" name="category" placeholder="p.sh. Avancë Terreni, Bonus Montimi" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-slate-400 font-semibold mb-1">Lidhur me Projektin (Opsionale)</label>
        <select name="projectId" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
          <option value="">-- Pa projekt të caktuar --</option>
          <% activeProjects.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.number %>)</option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-slate-400 font-semibold mb-1">Përshkrimi</label>
        <input type="text" id="form-desc" name="title" placeholder="Përshkrimi i shkurtër i pagesës" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-slate-400 font-semibold mb-1">Shënime</label>
        <textarea name="notes" rows="2" placeholder="Shënime..." class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 focus:outline-none focus:border-amber-400"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
        <button type="button" onclick="mbyllModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">
          Anulo
        </button>
        <button type="submit" id="form-submit-btn" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-lg shadow-amber-500/20">
          Ruaj & Gjenero Dëftesë
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function hapModalKesh() {
    document.getElementById('modal-title').innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Regjistro Pagesë në Kesh / Avancë';
    document.getElementById('form-type').value = 'KESH_AVANC';
    document.getElementById('form-category').value = 'Avancë Terreni';
    document.getElementById('form-desc').value = 'Avancë Kesh për <%= employee.firstName %> <%= employee.lastName %>';
    document.getElementById('form-submit-btn').className = 'px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-lg shadow-amber-500/20';
    document.getElementById('modal-transaksion-puntori').classList.remove('hidden');
  }

  function hapModalBonus() {
    document.getElementById('modal-title').innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Shto Bonus për Punëtorin';
    document.getElementById('form-type').value = 'BONUS';
    document.getElementById('form-category').value = 'Bonus Montimi / Performancë';
    document.getElementById('form-desc').value = 'Bonus për <%= employee.firstName %> <%= employee.lastName %>';
    document.getElementById('form-submit-btn').className = 'px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black shadow-lg shadow-emerald-500/20';
    document.getElementById('modal-transaksion-puntori').classList.remove('hidden');
  }

  function mbyllModal() {
    const m1 = document.getElementById('modal-transaksion-puntori');
    if (m1) m1.classList.add('hidden');
    const m2 = document.getElementById('modal-llogaria-puntorit');
    if (m2) m2.classList.add('hidden');
  }

  function hapModalLlogaria(username, role, email) {
    const modal = document.getElementById('modal-llogaria-puntorit');
    if (!modal) return;
    document.getElementById('acc-username').value = username || '';
    document.getElementById('acc-role').value = role || 'TEKNIK';
    document.getElementById('acc-email').value = email || '';
    document.getElementById('acc-password').value = '';
    
    const title = document.getElementById('acc-modal-title');
    if (username) {
      title.textContent = 'Përditëso Llogarinë & Fjalëkalimin';
    } else {
      title.textContent = 'Krijo Llogari Kyçjeje në Sistem';
    }
    modal.classList.remove('hidden');
  }
</script>

<!-- MODAL: Krijimi / Përditësimi i Llogarisë së Kyçjes -->
<div id="modal-llogaria-puntorit" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/50">
      <h3 id="acc-modal-title" class="text-sm font-bold text-slate-100 flex items-center gap-2">
        Krijo Llogari Kyçjeje në Sistem
      </h3>
      <button type="button" onclick="mbyllModal()" class="text-slate-400 hover:text-slate-200">✕</button>
    </div>

    <form action="/puntoret/<%= employee.id %>/llogaria" method="POST" class="p-5 space-y-4 text-xs">
      <div>
        <label class="block text-slate-300 font-semibold mb-1">Username për Kyçje <span class="text-rose-400">*</span></label>
        <input type="text" id="acc-username" name="username" required placeholder="p.sh. <%= employee.firstName.toLowerCase() %>.<%= employee.lastName.toLowerCase().replace(/\s+/g, '') %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-slate-300 font-semibold mb-1">Email Zyrtar</label>
        <input type="email" id="acc-email" name="email" value="<%= employee.email || '' %>" placeholder="email@kroneer-lifts.com" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block text-slate-300 font-semibold mb-1">Fjalëkalimi (Të paktën 6 karaktere)</label>
        <input type="password" id="acc-password" name="password" minlength="6" placeholder="<%= employee.user ? 'Lëre bosh nëse nuk dëshiron ta ndryshosh' : 'Vendos fjalëkalimin fillestar' %>" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-mono focus:outline-none focus:border-amber-400">
      </div>

      <% if (currentUser && currentUser.role === 'ADMINISTRATOR') { %>
        <div>
          <label class="block text-slate-300 font-semibold mb-1">Roli në Sistem <span class="text-rose-400">*</span></label>
          <select id="acc-role" name="role" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-semibold focus:outline-none focus:border-amber-400">
            <option value="TEKNIK" <%= employee.user && employee.user.role === 'TEKNIK' ? 'selected' : '' %>>Punëtor / Teknik Terreni</option>
            <option value="MENAXHER" <%= employee.user && employee.user.role === 'MENAXHER' ? 'selected' : '' %>>Menaxher</option>
            <option value="MENAXHER_PROJEKTI" <%= employee.user && employee.user.role === 'MENAXHER_PROJEKTI' ? 'selected' : '' %>>Menaxher i projektit</option>
            <option value="SHITJE" <%= employee.user && employee.user.role === 'SHITJE' ? 'selected' : '' %>>Shitje & CRM</option>
            <option value="FINANCE" <%= employee.user && employee.user.role === 'FINANCE' ? 'selected' : '' %>>Financë</option>
            <option value="ADMINISTRATOR" <%= employee.user && employee.user.role === 'ADMINISTRATOR' ? 'selected' : '' %>>Administrator</option>
          </select>
        </div>
      <% } else { %>
        <div class="rounded-xl border border-slate-700 bg-slate-900/70 p-3 text-slate-300">
          Roli caktohet automatikisht si <strong class="text-amber-300">Punëtor / Teknik</strong>; vetëm administratori mund ta ndryshojë.
        </div>
      <% } %>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
        <button type="button" onclick="mbyllModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">
          Anulo
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-lg shadow-amber-500/20">
          Ruaj Llogarinë
        </button>
      </div>
    </form>
  </div>
</div>
