<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-black text-slate-100 font-mono">MENAXHIMI I OFERTAVE</h1>
    <p class="text-xs text-slate-400 mt-1">Gjenerimi, llogaritja dhe ndjekja e ofertave komerciale</p>
  </div>
  <div class="flex items-center gap-3">
    <a href="/lifts/konfiguruesi" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-all flex items-center gap-2">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
      <span>Nga Konfiguruesi</span>
    </a>
    <a href="/ofertat/krijo" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Krijo Ofertë të Re</span>
    </a>
  </div>
</div>

<!-- Filtruesi -->
<div class="mb-6 bg-slate-900/90 border border-slate-800 rounded-xl p-4">
  <form method="GET" action="/ofertat" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Kërko me numër oferte, klient..." class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
    </div>
    <div>
      <select name="status" class="w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha statuset</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700">Filtro</button>
      <% if (filters.search || filters.status) { %>
        <a href="/ofertat" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs rounded-lg flex items-center justify-center">Pastro</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela e Ofertave -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <th class="p-4">Numri i Ofertës</th>
          <th class="p-4">Klienti</th>
          <th class="p-4">Data & Vlefshmëria</th>
          <th class="p-4">Vlera (Nëntotal)</th>
          <th class="p-4">Totali me TVSH (18%)</th>
          <th class="p-4">Statusi</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (quotations && quotations.length > 0) { %>
          <% quotations.forEach(q => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4">
                <a href="/ofertat/<%= q.id %>" class="font-mono font-bold text-amber-400 hover:text-amber-300 block text-sm">
                  <%= q.number %>
                </a>
                <span class="text-[10px] text-slate-500"><%= q.items.length %> artikuj</span>
              </td>
              <td class="p-4">
                <a href="/klientet/<%= q.customer.id %>" class="font-bold text-slate-200 hover:text-amber-400 block">
                  <%= q.customer.companyName %>
                </a>
                <span class="text-[10px] text-slate-500"><%= q.customer.city || 'Kosovë' %></span>
              </td>
              <td class="p-4">
                <div class="text-slate-300"><%= formatDate(q.date) %></div>
                <div class="text-[10px] text-slate-500">Skadon: <%= formatDate(q.validUntil) %></div>
              </td>
              <td class="p-4 font-mono text-slate-300">
                <%= formatCurrency(q.subtotal - q.discount) %>
              </td>
              <td class="p-4 font-mono font-bold text-slate-100 text-sm">
                <%= formatCurrency(q.total) %>
              </td>
              <td class="p-4">
                <% if (q.status === 'Pranuar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Pranuar</span>
                <% } else if (q.status === 'Refuzuar' || q.status === 'Skaduar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30"><%= q.status %></span>
                <% } else if (q.status === 'Në negociatë') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">Në negociatë</span>
                <% } else { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/20 text-blue-400 border border-blue-500/30"><%= q.status %></span>
                <% } %>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <button type="button" onclick='openQuickView(<%- JSON.stringify({
                    title: `Oferta ${q.number}`,
                    subtitle: q.customer.companyName,
                    statusLabel: q.status,
                    statusClass: "bg-amber-500/20 text-amber-300 border-amber-500/30",
                    rows: [
                      { label: "Data", value: formatDate(q.date) },
                      { label: "Skadon", value: formatDate(q.validUntil) },
                      { label: "Artikuj", value: String(q.items.length) },
                      { label: "Nëntotali", value: formatCurrency(q.subtotal - q.discount) },
                      { label: "Totali me TVSH", value: formatCurrency(q.total) }
                    ],
                    viewUrl: `/ofertat/${q.id}`,
                    editUrl: `/ofertat/${q.id}/ndrysho`,
                    printUrl: `/ofertat/${q.id}/print`
                  }).replace(/</g, '\\u003c').replace(/'/g, '&#39;') %>)' class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-amber-400 border border-slate-700 transition-colors" title="Pamje e Shpejtë">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                  </button>
                  <a href="/ofertat/<%= q.id %>/ndrysho" class="p-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 transition-colors" title="Ndrysho Ofertën">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </a>
                  <form action="/ofertat/<%= q.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini ofertën <%= q.number %>?');">
                    <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-500/40 transition-colors" title="Fshi Ofertën">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                  <a href="/ofertat/<%= q.id %>/print" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 transition-colors" title="Printo / PDF">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="p-8 text-center text-slate-500">Nuk u gjet asnjë ofertë.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
