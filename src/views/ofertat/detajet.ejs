<!-- Header i Ofertës me Butonat e Veprimeve -->
<div class="mb-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono"><%= quotation.number %></h1>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
        <%= quotation.status %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Lëshuar për: <strong class="text-slate-200"><%= quotation.customer.companyName %></strong> • Data: <%= formatDate(quotation.date) %></p>
  </div>

  <!-- Shiriti i Butonave të Veprimit Real -->
  <div class="flex flex-wrap items-center gap-2">
    <!-- Edit Ofertën -->
    <a href="/ofertat/<%= quotation.id %>/ndrysho" class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span>Ndrysho</span>
    </a>

    <!-- 1. Printo / PDF -->
    <a href="/ofertat/<%= quotation.id %>/print" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all" title="Printo / PDF">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Printo / PDF</span>
    </a>

    <!-- 2. Dupliko Ofertën -->
    <form action="/ofertat/<%= quotation.id %>/dupliko" method="POST" class="inline">
      <button type="submit" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span>Dupliko</span>
      </button>
    </form>

    <!-- 3. Krijo Kontratë Direkt -->
    <div class="inline-flex items-center rounded-xl bg-emerald-600 shadow-md shadow-emerald-600/20 overflow-hidden">
      <form action="/ofertat/<%= quotation.id %>/kontrate" method="POST" class="inline">
        <button type="submit" class="px-3.5 py-2 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all" title="Gjenero Kontratën Menjëherë">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Krijo Kontratë</span>
        </button>
      </form>
      <a href="/kontratat/krijo?quotationId=<%= quotation.id %>" class="px-2 py-2 hover:bg-emerald-500 text-white border-l border-emerald-500/40 transition-all" title="Përshtat Nenet & Krijo Kontratë">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </a>
    </div>

    <!-- 4. Krijo Faturë Direkt -->
    <form action="/ofertat/<%= quotation.id %>/fature" method="POST" class="inline">
      <button type="submit" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-md shadow-amber-500/20 transition-all" title="Gjenero Faturën Zyrtare nga kjo Ofertë">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <span>Krijo Faturë</span>
      </button>
    </form>

    <!-- 5. Fshi Ofertën -->
    <form action="/ofertat/<%= quotation.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini ofertën <%= quotation.number %>? Ky veprim nuk mund të kthehet.');">
      <button type="submit" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Fshi</span>
      </button>
    </form>
  </div>
</div>

<!-- Trupi i Detajuar i Ofertës -->
<div class="space-y-6">
  
  <!-- Info Box me 2 Panele -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Të Dhënat e Klientit -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-2">
      <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-3 border-b border-slate-800 pb-2">
        KLIENTI
      </h3>
      <div class="text-sm font-bold text-slate-100"><%= quotation.customer.companyName %></div>
      <div class="text-slate-400">Përfaqësuesi: <span class="text-slate-200"><%= quotation.customer.contactPerson || '-' %></span></div>
      <div class="text-slate-400">Adresa: <span class="text-slate-200"><%= quotation.customer.address || '-' %>, <%= quotation.customer.city || '-' %></span></div>
      <div class="text-slate-400">Telefoni: <span class="font-mono text-slate-200"><%= quotation.customer.phone || '-' %></span></div>
      <div class="text-slate-400">Email: <span class="font-mono text-slate-200"><%= quotation.customer.email || '-' %></span></div>
    </div>

    <!-- Të Dhënat e Ofertës & Termave -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs space-y-2">
      <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-3 border-b border-slate-800 pb-2">
        TERMAT E OFERTËS
      </h3>
      <div class="flex justify-between"><span class="text-slate-400">Data e Lëshimit:</span><span class="font-bold text-slate-200"><%= formatDate(quotation.date) %></span></div>
      <div class="flex justify-between"><span class="text-slate-400">Vlefshmëria deri më:</span><span class="font-bold text-amber-400"><%= formatDate(quotation.validUntil) %></span></div>
      <div class="flex justify-between"><span class="text-slate-400">Afati i Dorëzimit:</span><span class="font-bold text-slate-200"><%= quotation.deliveryWeeks %> Javë</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Afati i Instalimit:</span><span class="font-bold text-slate-200"><%= quotation.installationWeeks %> Javë</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Garancia:</span><span class="font-bold text-emerald-400"><%= quotation.warrantyMonths %> Muaj</span></div>
    </div>

  </div>

  <!-- Tabela e Artikujve -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
    <div class="p-4 bg-slate-950/70 border-b border-slate-800">
      <h3 class="text-sm font-bold text-slate-100">Specifikacioni i Artikujve dhe Shërbimeve</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/40 text-slate-400 uppercase font-bold text-[10px] border-b border-slate-800">
          <tr>
            <th class="p-4">Nr.</th>
            <th class="p-4">Lloji</th>
            <th class="p-4">Produkti & Përshkrimi</th>
            <th class="p-4 text-center">Sasia</th>
            <th class="p-4 text-right">Çmimi për Njësi</th>
            <th class="p-4 text-right">Zbritja</th>
            <th class="p-4 text-right">Totali pa TVSH</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% quotation.items.forEach((item, idx) => { %>
            <tr class="hover:bg-slate-800/30">
              <td class="p-4 font-mono text-slate-500"><%= idx + 1 %></td>
              <td class="p-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-amber-400"><%= item.itemType %></span>
              </td>
              <td class="p-4">
                <div class="font-bold text-slate-100 text-sm"><%= item.name %></div>
                <% if (item.description) { %>
                  <div class="text-slate-400 text-xs mt-0.5"><%= item.description %></div>
                <% } %>
              </td>
              <td class="p-4 text-center font-mono font-bold text-slate-200">
                <%= item.quantity %> <%= item.unit %>
              </td>
              <td class="p-4 text-right font-mono text-slate-300">
                <%= formatCurrency(item.unitPrice) %>
              </td>
              <td class="p-4 text-right font-mono text-emerald-400">
                <%= item.discount > 0 ? ('-' + formatCurrency(item.discount)) : '-' %>
              </td>
              <td class="p-4 text-right font-mono font-bold text-slate-100">
                <%= formatCurrency(item.total) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Përmbledhja Financiare -->
    <div class="p-6 bg-slate-950/80 border-t border-slate-800 flex flex-col sm:flex-row justify-between gap-6">
      <div class="max-w-md text-xs text-slate-400 space-y-2">
        <div class="font-bold text-slate-200">Kushtet e Pagesës:</div>
        <p class="leading-relaxed"><%= quotation.paymentTerms %></p>
        <% if (quotation.notes) { %>
          <div class="mt-2 pt-2 border-t border-slate-800/80">
            <span class="font-bold text-slate-200">Shënime:</span>
            <p class="mt-0.5"><%= quotation.notes %></p>
          </div>
        <% } %>
      </div>

      <div class="w-72 space-y-2 text-xs">
        <div class="flex justify-between text-slate-400">
          <span>Nëntotali bruto:</span>
          <span class="font-mono font-bold text-slate-200"><%= formatCurrency(quotation.subtotal) %></span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>Zbritja totale:</span>
          <span class="font-mono font-bold text-emerald-400">-<%= formatCurrency(quotation.discount) %></span>
        </div>
        <div class="flex justify-between text-slate-300 font-semibold pt-2 border-t border-slate-800">
          <span>Nëntotali neto:</span>
          <span class="font-mono font-bold text-slate-100"><%= formatCurrency(quotation.subtotal - quotation.discount) %></span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>TVSH (18%):</span>
          <span class="font-mono font-bold text-slate-200"><%= formatCurrency(quotation.vatAmount) %></span>
        </div>
        <div class="pt-3 border-t-2 border-amber-500/40 flex justify-between">
          <span class="text-sm font-black text-slate-100">TOTALI ME TVSH:</span>
          <span class="text-2xl font-black text-amber-400 font-mono"><%= formatCurrency(quotation.total) %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Ndrysho Statusin e Ofertës -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <h3 class="text-sm font-bold text-slate-100">Përditëso Statusin e Ofertës</h3>
      <p class="text-xs text-slate-400">Ndryshoni statusin sipas ecurisë së negociatave me klientin</p>
    </div>
    <form action="/ofertat/<%= quotation.id %>/status" method="POST" class="flex items-center gap-2">
      <select name="status" class="px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-semibold">
        <% ['Draft', 'Dërguar', 'Shikuar', 'Në negociatë', 'Pranuar', 'Refuzuar', 'Skaduar'].forEach(st => { %>
          <option value="<%= st %>" <%= quotation.status === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
      <button type="submit" class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl shadow transition-all">
        RUAJ STATUSIN
      </button>
    </form>
  </div>

</div>
