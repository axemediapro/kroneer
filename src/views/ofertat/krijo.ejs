<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono">KRIJO OFERTË TË RE</h1>
      <span class="font-mono text-sm font-bold text-amber-400 bg-amber-500/15 border border-amber-500/30 px-3 py-1 rounded-lg">
        <%= nextNumber %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Plotësoni të dhënat dhe artikujt e ofertës komerciale</p>
  </div>
  <a href="/ofertat" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo
  </a>
</div>

<form action="/ofertat/krijo" method="POST" id="quotation-form" class="space-y-6">
  
  <!-- 1. Detajet e Përgjithshme të Ofertës -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Të Dhënat e Klientit dhe Termave Komerciale
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
      <div x-data="quickCustomerModal()">
        <label class="block font-semibold text-slate-300 mb-1">Klienti *</label>
        <div class="flex items-center gap-2">
          <select name="customerId" x-ref="customerSelect" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
            <option value="">-- Zgjidh Klientin --</option>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.companyName %> (<%= c.code %>) - <%= c.city || 'Kosovë' %></option>
            <% }); %>
          </select>
          <button type="button" @click="openModal()" title="Shto Klient të Ri" class="shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-base shadow-md shadow-amber-500/20 transition-all">+</button>
        </div>
        <%- include('../partials/quick-customer-modal') %>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Data e Ofertës *</label>
        <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Vlefshmëria deri më *</label>
        <input type="date" name="validUntil" value="<%= new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Përfaqësuesi i Shitjes</label>
        <select name="salesRepId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= currentUser && currentUser.id === u.id ? 'selected' : '' %>><%= u.fullName %> (<%= u.role %>)</option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Afati i Dorëzimit (Javë)</label>
        <input type="number" name="deliveryWeeks" value="6" min="1" max="52" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Afati i Instalimit (Javë)</label>
        <input type="number" name="installationWeeks" value="3" min="1" max="52" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>

      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Kushtet e Pagesës</label>
        <input type="text" name="paymentTerms" value="30% Parapagim, 40% Para Instalimit, 20% Gjatë Instalimit, 10% Pas Dorëzimit" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Garancia (Muaj)</label>
        <input type="number" name="warrantyMonths" value="24" min="12" max="120" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400 font-mono">
      </div>
    </div>
  </div>

  <!-- 2. Tabela Dinamike e Artikujve -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl" x-data="{
    items: [
      { itemType: 'Lift', name: 'Lift KRONEER Elegance 630', description: 'Motor gearless MRL, kabinë inoksi AISI 304, shpejtësi 1.0 m/s', quantity: 1, unit: 'copë', unitPrice: 22500, discount: 1000 },
      { itemType: 'Instalim', name: 'Instalimi dhe Montimi Profesional', description: 'Montimi i shinave, kabinës dhe lidhja elektrike', quantity: 1, unit: 'shërbim', unitPrice: 3500, discount: 0 },
      { itemType: 'Transport', name: 'Transporti në Kantier', description: 'Transport me vinç', quantity: 1, unit: 'shërbim', unitPrice: 900, discount: 0 }
    ],
    addItem() {
      this.items.push({ itemType: 'Komponent', name: '', description: '', quantity: 1, unit: 'copë', unitPrice: 0, discount: 0 });
    },
    removeItem(idx) {
      if (this.items.length > 1) this.items.splice(idx, 1);
    },
    subtotal() {
      return this.items.reduce((s, it) => s + (parseFloat(it.quantity || 1) * parseFloat(it.unitPrice || 0)), 0);
    },
    totalDiscount() {
      return this.items.reduce((s, it) => s + parseFloat(it.discount || 0), 0);
    },
    netSubtotal() {
      return Math.max(0, this.subtotal() - this.totalDiscount());
    },
    vat() {
      return Math.round(this.netSubtotal() * 0.18 * 100) / 100;
    },
    total() {
      return this.netSubtotal() + this.vat();
    }
  }">
    <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-2">
      <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider">
        2. Artikujt e Ofertës
      </h3>
      <button type="button" @click="addItem()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 font-bold text-xs flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Shto Artikull</span>
      </button>
    </div>

    <!-- Tabela e Artikujve -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/70 text-slate-400 uppercase font-bold text-[10px]">
          <tr>
            <th class="p-3">Lloji</th>
            <th class="p-3 w-1/3">Produkti & Përshkrimi</th>
            <th class="p-3">Sasia</th>
            <th class="p-3">Njësia</th>
            <th class="p-3">Çmimi (€)</th>
            <th class="p-3">Zbritja (€)</th>
            <th class="p-3 text-right">Totali (€)</th>
            <th class="p-3 text-center"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <template x-for="(item, index) in items" :key="index">
            <tr>
              <td class="p-2">
                <select x-model="item.itemType" class="px-2 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 focus:outline-none">
                  <option value="Lift">Lift</option>
                  <option value="Komponent">Komponent</option>
                  <option value="Shërbim">Shërbim</option>
                  <option value="Transport">Transport</option>
                  <option value="Instalim">Instalim</option>
                  <option value="Mirëmbajtje">Mirëmbajtje</option>
                  <option value="Artikull i personalizuar">I Personalizuar</option>
                </select>
              </td>
              <td class="p-2 space-y-1">
                <input type="text" x-model="item.name" required placeholder="Emri i produktit" class="w-full px-2.5 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 font-semibold focus:outline-none">
                <input type="text" x-model="item.description" placeholder="Përshkrim teknik" class="w-full px-2.5 py-1 bg-slate-950 border border-slate-800/60 rounded-lg text-[11px] text-slate-400 focus:outline-none">
              </td>
              <td class="p-2">
                <input type="number" x-model.number="item.quantity" min="1" step="0.5" class="w-16 px-2 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs font-mono text-slate-100 text-center focus:outline-none">
              </td>
              <td class="p-2">
                <input type="text" x-model="item.unit" class="w-16 px-2 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-100 text-center focus:outline-none">
              </td>
              <td class="p-2">
                <input type="number" x-model.number="item.unitPrice" min="0" step="10" class="w-24 px-2 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs font-mono text-slate-100 text-right focus:outline-none">
              </td>
              <td class="p-2">
                <input type="number" x-model.number="item.discount" min="0" step="10" class="w-20 px-2 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs font-mono text-emerald-400 text-right focus:outline-none">
              </td>
              <td class="p-2 font-mono font-bold text-slate-100 text-right" x-text="'€' + ((item.quantity * item.unitPrice) - item.discount).toLocaleString('de-DE', {minimumFractionDigits: 2})"></td>
              <td class="p-2 text-center">
                <button type="button" @click="removeItem(index)" class="text-slate-500 hover:text-rose-400 p-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Përmbledhja Financiare e Ofertës -->
    <div class="mt-6 pt-4 border-t border-slate-800 flex justify-end">
      <div class="w-72 space-y-2 text-xs">
        <div class="flex justify-between text-slate-400">
          <span>Nëntotali bruto:</span>
          <span class="font-mono font-bold text-slate-200" x-text="'€' + subtotal().toLocaleString('de-DE', {minimumFractionDigits: 2})"></span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>Zbritja totale:</span>
          <span class="font-mono font-bold text-emerald-400" x-text="'-€' + totalDiscount().toLocaleString('de-DE', {minimumFractionDigits: 2})"></span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>Nëntotali neto:</span>
          <span class="font-mono font-bold text-slate-200" x-text="'€' + netSubtotal().toLocaleString('de-DE', {minimumFractionDigits: 2})"></span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>TVSH (18%):</span>
          <span class="font-mono font-bold text-slate-200" x-text="'€' + vat().toLocaleString('de-DE', {minimumFractionDigits: 2})"></span>
        </div>
        <div class="pt-2 border-t-2 border-amber-500/40 flex justify-between">
          <span class="font-black text-slate-100 text-sm">TOTALI:</span>
          <span class="text-xl font-black text-amber-400 font-mono" x-text="'€' + total().toLocaleString('de-DE', {minimumFractionDigits: 2})"></span>
        </div>
      </div>
    </div>

    <!-- Hidden input to carry JSON items on submit -->
    <input type="hidden" name="items" :value="JSON.stringify(items)">
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <label class="block text-xs font-semibold text-slate-300 mb-2">Shënime & Kushte Shtesë të Ofertës</label>
    <textarea name="notes" rows="3" placeholder="Shkruani çdo vërejtje ose marrëveshje specifike..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"></textarea>
  </div>

  <!-- Butonat e Veprimit -->
  <div class="flex items-center justify-end gap-3">
    <a href="/ofertat" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
      RUAJ OFERTËN
    </button>
  </div>

</form>
