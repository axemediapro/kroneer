<div class="space-y-6" x-data="{
  tab: '<%= activeTab || 'progresi' %>',
  isReportingModalOpen: false,
  isCopied: false,
  copyTrackingLink() {
    navigator.clipboard.writeText('<%= trackingUrl %>');
    this.isCopied = true;
    setTimeout(() => { this.isCopied = false; }, 2500);
  }
}">

  <!-- Live Pulse Status Top Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
    <!-- Ambient Glow Background -->
    <div class="absolute -right-10 -top-10 w-72 h-72 <%= installation.status === 'Përfunduar' ? 'bg-emerald-500/10' : 'bg-amber-500/10' %> rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
      
      <!-- Lift Identity & Real-Time Status -->
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Real-time pulse indicator -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-bold <%= installation.status === 'Përfunduar' ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/15 text-amber-300 border border-amber-500/30' %>">
            <span class="w-2 h-2 rounded-full <%= installation.status === 'Përfunduar' ? 'bg-emerald-400' : 'bg-amber-400' %> animate-ping"></span>
            <%= installation.status === 'Përfunduar' ? 'LIFTI NË FUNKSION (AKTIV)' : 'NË PROCES INSTALIMI' %>
          </span>

          <span class="px-3 py-1 rounded-full text-[11px] font-mono font-bold bg-slate-800/80 text-slate-300 border border-slate-700">
            SN: <%= installation.serialNumber %>
          </span>

          <span class="px-2.5 py-1 rounded-full text-[10px] font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            EN 81-20/50 Certified
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight">
          <%= installation.elevatorModel %>
        </h1>

        <div class="text-xs sm:text-sm text-slate-400 flex flex-wrap items-center gap-y-1 gap-x-2">
          <span>Objekti: <strong class="text-slate-200"><%= installation.project.name %></strong></span>
          <span>•</span>
          <span>Klienti: <strong class="text-slate-200"><%= installation.project.customer ? installation.project.customer.companyName : '—' %></strong></span>
          <% if (installation.project.customer && installation.project.customer.city) { %>
            <span>•</span>
            <span>Lokacioni: <strong class="text-slate-200"><%= installation.project.customer.city %></strong></span>
          <% } %>
        </div>
      </div>

      <!-- Quick Actions (Copy Link, QR Modal, Report Issue) -->
      <div class="flex flex-wrap items-center gap-2.5 sm:self-start lg:self-center">
        <button type="button" @click="copyTrackingLink()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-2 shadow-sm">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
          <span x-text="isCopied ? 'Linku u Kopjua!' : 'Kopjo Linkun Publik'">Kopjo Linkun Publik</span>
        </button>

        <a href="#qr-section" @click="tab = 'specifikat'" class="px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
          <span>QR Kodi</span>
        </a>

        <button type="button" @click="isReportingModalOpen = true" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2">
          <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Raporto Defekt / Kërko Servis</span>
        </button>
      </div>

    </div>

    <!-- Quick Overview Bar (Progress & Key Dates) -->
    <div class="mt-6 pt-6 border-t border-slate-800 grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 block">PROGRESI I MONTIMIT</span>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="text-xl font-black font-mono <%= installation.progressPercent === 100 ? 'text-emerald-400' : 'text-amber-400' %>">
            <%= installation.progressPercent %>%
          </span>
          <span class="text-[11px] text-slate-400">(<%= installation.checklistItems.filter(i => i.isCompleted).length %> / <%= installation.checklistItems.length %> hapa)</span>
        </div>
      </div>

      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 block">DATA E NISJES</span>
        <span class="text-sm font-semibold text-slate-200 font-mono mt-0.5 block">
          <%= installation.startDate ? new Date(installation.startDate).toLocaleDateString('sq-AL') : '—' %>
        </span>
      </div>

      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 block">GARANCIA ZYRTARE</span>
        <span class="text-sm font-semibold text-emerald-400 font-mono mt-0.5 block">
          <%= handover ? '24 Muaj (Aktive)' : 'Aktivizohet pas dorëzimit' %>
        </span>
      </div>

      <div>
        <span class="text-[10px] uppercase font-bold text-slate-500 block">SHËRBIMI 24/7</span>
        <span class="text-sm font-bold text-slate-200 mt-0.5 block flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <%= company ? company.phone : '+383 38 500 600' %>
        </span>
      </div>
    </div>

    <!-- Live Animated Progress Bar -->
    <div class="w-full bg-slate-950 rounded-full h-3 mt-4 overflow-hidden p-0.5 border border-slate-800">
      <div class="h-full rounded-full transition-all duration-700 <%= installation.progressPercent === 100 ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : 'bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.5)]' %>" style="width: <%= installation.progressPercent %>%"></div>
    </div>
  </div>

  <!-- Navigation Tabs for the Lift Tracking Portal -->
  <div class="flex items-center gap-2 border-b border-slate-800 pb-2 overflow-x-auto">
    <button type="button" @click="tab = 'progresi'" class="px-4 py-2.5 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap" :class="tab === 'progresi' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      <span>1. Progresi i Montimit (<%= installation.progressPercent %>%)</span>
    </button>

    <button type="button" @click="tab = 'specifikat'" class="px-4 py-2.5 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap" :class="tab === 'specifikat' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      <span>2. Pasaporta Teknike & Specifikat</span>
    </button>

    <button type="button" @click="tab = 'dorezimi'" class="px-4 py-2.5 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap" :class="tab === 'dorezimi' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span>3. Dorëzimi Teknik & Garancia</span>
    </button>

    <button type="button" @click="tab = 'mirembajtja'" class="px-4 py-2.5 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap" :class="tab === 'mirembajtja' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <span>4. Mirëmbajtja & Vizitat</span>
    </button>

    <button type="button" @click="tab = 'servisi'" class="px-4 py-2.5 text-xs font-bold rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap" :class="tab === 'servisi' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      <span>5. Tiketat & Raportimi (<%= serviceTickets.length %>)</span>
    </button>
  </div>

  <!-- TAB 1: PROGRESI I MONTIMIT (13 HAPAT STANDARDË) -->
  <div x-show="tab === 'progresi'" class="space-y-6">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-6 border-b border-slate-800">
        <div>
          <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            Lista e Kontrollit Inxhinierik (13 Hapa Standardë KRONEER)
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Statusi në kohë reale i verifikimit dhe montimit teknik të çdo hallke strukturore dhe elektronike</p>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-800 text-amber-400 border border-slate-700 self-start sm:self-auto">
          <%= installation.checklistItems.filter(i => i.isCompleted).length %> nga 13 të Përfunduara
        </span>
      </div>

      <div class="divide-y divide-slate-800/70">
        <% installation.checklistItems.forEach((item, index) => { %>
          <div class="py-4 flex items-start justify-between gap-4 transition-colors <%= item.isCompleted ? 'hover:bg-slate-800/30' : 'hover:bg-slate-800/20' %>">
            <div class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-xl font-mono text-xs font-black flex items-center justify-center flex-shrink-0 mt-0.5 <%= item.isCompleted ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-slate-800 text-slate-500 border border-slate-700' %>">
                <%= index + 1 %>
              </span>
              <div>
                <p class="text-sm font-semibold <%= item.isCompleted ? 'text-slate-100' : 'text-slate-400' %>">
                  <%= item.itemTitle %>
                </p>
                <% if (item.isCompleted && item.completedAt) { %>
                  <div class="flex items-center gap-1.5 text-xs text-emerald-400 font-medium mt-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    <span>Verifikuar & Përfunduar më <%= new Date(item.completedAt).toLocaleString('sq-AL') %> <%= item.completedBy ? `• nga ${item.completedBy}` : '' %></span>
                  </div>
                <% } else { %>
                  <p class="text-[11px] text-slate-500 mt-0.5">Në proces ekzekutimi sipas planit inxhinierik.</p>
                <% } %>
              </div>
            </div>

            <div class="flex-shrink-0">
              <% if (item.isCompleted) { %>
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Përfunduar
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700">
                  Në Pritje
                </span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- TAB 2: PASAPORTA TEKNIKE & SPECIFIKAT -->
  <div x-show="tab === 'specifikat'" x-cloak class="space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Kolona e Majtë: Specifikat Inxhinierike (2 Kolona) -->
      <div class="lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
        <div>
          <h2 class="text-base font-bold text-slate-100 flex items-center gap-2 font-mono">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Pasaporta Teknike & Parametrat Inxhinierikë
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Të dhënat origjinale të fabrikimit dhe kalibrimit të ashensorit</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">KAPACITETI & PESHA</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.capacityKg : 630 %> KG / <%= elevatorModelData ? elevatorModelData.personsCount : 8 %> Persona
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">SHPEJTËSIA E LËVIZJES</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.speed : '1.0' %> m/s (VVVF Inverter)
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">MOTORI & MAKINERIA</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.motorType : 'Gearless Permanent Magnet' %>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">SISTEMI I DREJTIMIT</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.driveSystem : 'MRL (Machine-Room-Less)' %>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">DYERT E KATEVE DHE KABINËS</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.doorType : 'Automatike me Hapje Qendrore' %>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">FURNIZIMI ME ENERGJI</span>
            <div class="text-base font-bold text-slate-100 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.powerSupply : '380V / 3 Faza / 50Hz' %>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800 sm:col-span-2">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">STANDARDI I SIGURISË</span>
            <div class="text-base font-bold text-emerald-400 font-mono mt-1">
              <%= elevatorModelData ? elevatorModelData.safetySystem : 'EN81-20/50 e Plotë me GSM Telefon Emergjent' %>
            </div>
          </div>

        </div>
      </div>

      <!-- Kolona e Djathtë: QR Kodi & Ndarja me Banorët/Klientin -->
      <div id="qr-section" class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl flex flex-col items-center text-center space-y-4">
        <div>
          <h3 class="text-sm font-bold text-slate-100 font-mono">QR Kodi Zyrtar i Liftit</h3>
          <p class="text-xs text-slate-400 mt-1">Skanohet direkt në kabinë ose derë për gjendjen live dhe raportim defektesh 24/7</p>
        </div>

        <div class="p-3 bg-white rounded-2xl shadow-xl">
          <img src="<%= qrCodeDataUrl %>" alt="QR Code Lift SN <%= installation.serialNumber %>" class="w-48 h-48 object-contain">
        </div>

        <div class="w-full space-y-2 pt-2">
          <button type="button" @click="copyTrackingLink()" class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 transition flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            <span x-text="isCopied ? 'U Kopjua!' : 'Kopjo Linkun e Enkriptuar'">Kopjo Linkun e Enkriptuar</span>
          </button>

          <a href="<%= qrCodeDataUrl %>" download="QR_Kroneer_Lift_<%= installation.serialNumber %>.png" class="w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <span>Shkarko QR Kodin (PNG)</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- TAB 3: DORËZIMI TEKNIK & GARANCIA -->
  <div x-show="tab === 'dorezimi'" x-cloak class="space-y-6">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <h2 class="text-base font-bold text-slate-100 flex items-center gap-2 font-mono">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Procesverbali i Dorëzimit Teknik & Sigurimit të Cilësisë
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Verifikimi përfundimtar, certifikata e sigurisë dhe fillimi i garancisë zyrtare</p>
        </div>

        <% if (handover) { %>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 self-start sm:self-auto">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Dorëzuar me Sukses
          </span>
        <% } else { %>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 self-start sm:self-auto">
            Në Pritje të Dorëzimit Përfundimtar
          </span>
        <% } %>
      </div>

      <% if (handover) { %>
        <div class="mt-6 space-y-6">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
              <span class="text-slate-500 uppercase font-bold text-[10px] block">DATA E DORËZIMIT</span>
              <span class="text-sm font-bold text-slate-100 font-mono mt-1 block">
                <%= handover.handoverDate ? new Date(handover.handoverDate).toLocaleDateString('sq-AL') : '—' %>
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
              <span class="text-slate-500 uppercase font-bold text-[10px] block">PËRFAQËSUESI I KRONEER</span>
              <span class="text-sm font-bold text-slate-100 mt-1 block truncate">
                <%= handover.repSigneeName || 'Inxhinier KRONEER' %>
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
              <span class="text-slate-500 uppercase font-bold text-[10px] block">PRANUESI I OBJEKTIT</span>
              <span class="text-sm font-bold text-slate-100 mt-1 block truncate">
                <%= handover.clientSigneeName || 'Klienti' %>
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
              <span class="text-slate-500 uppercase font-bold text-[10px] block">GARANCIA ZYRTARE</span>
              <span class="text-sm font-bold text-emerald-400 mt-1 block">
                24 Muaj e Plotë
              </span>
            </div>
          </div>

          <!-- Verifikimet e Kryera -->
          <div class="p-5 rounded-2xl bg-slate-950/40 border border-slate-800/80">
            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Kontrollet e Sigurisë të Nënshkruara</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 text-xs text-slate-300">
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Inspektimi teknik zyrtar</div>
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Testimi i plotë i sigurisë</div>
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Dokumentacioni teknik i dorëzuar</div>
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Trajnimi i stafit / klientit</div>
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Çelësat emergjentë të dorëzuar</div>
              <div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Garancia e aktivizuar</div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-slate-500 text-xs">
          Procesverbali i dorëzimit teknik do të jetë i disponueshëm këtu sapo të përmbyllen të 13 hapat e montimit dhe testimit.
        </div>
      <% } %>
    </div>
  </div>

  <!-- TAB 4: MIRËMBAJTJA PERIODIKE & VIZITAT -->
  <div x-show="tab === 'mirembajtja'" x-cloak class="space-y-6">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <h2 class="text-base font-bold text-slate-100 flex items-center gap-2 font-mono">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Kontrata e Mirëmbajtjes & Shërbimi 24/7
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Ditar i inspektimeve periodike teknike, lubrifikimit dhe kontrolleve parandaluese</p>
        </div>

        <% if (maintenanceContract) { %>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 self-start sm:self-auto">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Kontratë Aktive (<%= maintenanceContract.number %>)
          </span>
        <% } else { %>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-800 text-slate-400 self-start sm:self-auto">
            Nuk ka kontratë të regjistruar
          </span>
        <% } %>
      </div>

      <% if (maintenanceContract) { %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">FREKUENCA E VIZITAVE</span>
            <span class="text-sm font-bold text-slate-100 mt-1 block"><%= maintenanceContract.frequency %></span>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">DATA E SKADIMIT</span>
            <span class="text-sm font-bold text-slate-100 font-mono mt-1 block">
              <%= maintenanceContract.endDate ? new Date(maintenanceContract.endDate).toLocaleDateString('sq-AL') : '—' %>
            </span>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">TEKNIKU PËRGJEGJËS</span>
            <span class="text-sm font-bold text-slate-100 mt-1 block">
              <%= maintenanceContract.technician ? maintenanceContract.technician.fullName : 'Ekipi KRONEER' %>
            </span>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
            <span class="text-slate-500 uppercase font-bold text-[10px] block">LINJA E URGJENCËS</span>
            <span class="text-sm font-bold text-amber-400 font-mono mt-1 block">24/7 Aktive</span>
          </div>
        </div>

        <!-- Ditar i Vizitave Teknike -->
        <div>
          <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Ditar i Vizitave të Fundit Teknike</h3>
          <% if (maintenanceContract.visits && maintenanceContract.visits.length > 0) { %>
            <div class="divide-y divide-slate-800/80 border border-slate-800 rounded-2xl overflow-hidden bg-slate-950/40">
              <% maintenanceContract.visits.forEach(v => { %>
                <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                  <div>
                    <div class="flex items-center gap-2 font-mono">
                      <span class="font-bold text-slate-200"><%= v.visitDate ? new Date(v.visitDate).toLocaleDateString('sq-AL') : '—' %></span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= v.status === 'E Përfunduar' ? 'bg-emerald-500/15 text-emerald-300' : 'bg-amber-500/15 text-amber-300' %>">
                        <%= v.status %>
                      </span>
                    </div>
                    <p class="text-slate-400 mt-1">Gjetjet: <strong class="text-slate-300"><%= v.findings || 'Kontroll i rregullt' %></strong></p>
                    <p class="text-slate-400">Veprimet: <span class="text-slate-300"><%= v.actionsTaken || 'Lubrifikim dhe testim i sigurisë' %></span></p>
                  </div>
                  <div class="text-right flex-shrink-0 font-mono text-slate-500">
                    <%= v.clientSigned ? '✓ Nënshkruar nga Klienti' : 'Nënshkrim i rregullt' %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-slate-500 text-xs py-4 text-center">Vizita e parë periodike do të regjistrohet sipas planit të mirëmbajtjes.</p>
          <% } %>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-slate-500 text-xs">
          Pas përfundimit të instalimit dhe dorëzimit teknik, këtu do të paraqitet kontrata e mirëmbajtjes dhe ditari i të gjitha vizitave periodike.
        </div>
      <% } %>
    </div>
  </div>

  <!-- TAB 5: TIKETAT DHE RAPORTIMI I DEFEKTEVE -->
  <div x-show="tab === 'servisi'" x-cloak class="space-y-6">
    <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div>
          <h2 class="text-base font-bold text-slate-100 flex items-center gap-2 font-mono">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Kërkesat e Servisit & Raportimi i Defekteve
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Historiku i kërkesave të hapura dhe zgjidhjeve teknike nga inxhinierët KRONEER</p>
        </div>

        <button type="button" @click="isReportingModalOpen = true" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow transition flex items-center gap-1.5 self-start sm:self-auto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Raporto Problem të Ri</span>
        </button>
      </div>

      <% if (serviceTickets && serviceTickets.length > 0) { %>
        <div class="divide-y divide-slate-800 border border-slate-800 rounded-2xl overflow-hidden bg-slate-950/40">
          <% serviceTickets.forEach(st => { %>
            <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono font-bold text-amber-400"><%= st.number %></span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= st.status === 'Hapur' ? 'bg-amber-500/15 text-amber-300' : (st.status === 'Zgjidhur' || st.status === 'Mbyllur' ? 'bg-emerald-500/15 text-emerald-300' : 'bg-blue-500/15 text-blue-300') %>">
                    <%= st.status %>
                  </span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= st.priority === 'Kritik' || st.priority === 'I lartë' ? 'bg-rose-500/15 text-rose-300' : 'bg-slate-800 text-slate-400' %>">
                    Prioritet: <%= st.priority %>
                  </span>
                </div>
                <p class="text-slate-300 mt-1 font-medium"><%= st.problemDescription %></p>
                <% if (st.resolutionNotes) { %>
                  <p class="text-emerald-400 mt-0.5">Zgjidhja: <%= st.resolutionNotes %></p>
                <% } %>
              </div>
              <div class="text-right flex-shrink-0 font-mono text-slate-500">
                <%= st.reportedDate ? new Date(st.reportedDate).toLocaleDateString('sq-AL') : '—' %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-slate-500 text-xs">
          Nuk ka asnjë defekt të raportuar për këtë lift. Sistemi funksionon me parametra optimalë.
        </div>
      <% } %>
    </div>
  </div>

  <!-- MODAL: RAPORTO DEFEKT DIREKT NGA LINKU PUBLIK -->
  <template x-teleport="body">
  <div x-show="isReportingModalOpen" x-cloak class="kr-modal flex items-center justify-center" style="position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;padding:1rem;background:rgba(0,0,0,.5);overflow-y:auto">
    <div @click.away="isReportingModalOpen = false" style="background:#0f172a;opacity:1" class="w-full max-w-lg border border-slate-700 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <div class="p-2 rounded-xl bg-amber-500/15 text-amber-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-100">Raporto Defekt / Kërko Servis</h3>
            <p class="text-xs text-slate-400">Lifti SN: <%= installation.serialNumber %></p>
          </div>
        </div>
        <button type="button" @click="isReportingModalOpen = false" class="p-1 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-slate-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form action="/track/lift/<%= trackingToken %>/report-issue" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Emri & Mbiemri juaj *</label>
          <input type="text" name="reporterName" required placeholder="p.sh. Agim Krasniqi (Menaxher Prone / Banor)" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:border-amber-400 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">Numri i Telefonit *</label>
          <input type="tel" name="reporterPhone" required placeholder="p.sh. +383 49 123 456" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:border-amber-400 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">Niveli i Urgjencës</label>
          <select name="priority" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:border-amber-400 focus:outline-none">
            <option value="Normal">Normal (Kontroll i planifikuar)</option>
            <option value="I lartë">I Lartë (Zhurmë, ngecje e vogël)</option>
            <option value="Kritik">Kritik / Urgjent (Lifti i bllokuar / jashtë funksionit)</option>
            <option value="Tjetër">Tjetër</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">Përshkrimi i Problemit të Vërejtur *</label>
          <textarea name="problemDescription" rows="4" required placeholder="Ju lutemi shpjegoni çfarë nuk po funksionon saktësisht (p.sh. dyert nuk mbyllen në katin 3, tingull i pazakontë, drita fikur)..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:border-amber-400 focus:outline-none"></textarea>
        </div>

        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
        <div class="pt-2 flex items-center justify-end gap-3">
          <button type="button" @click="isReportingModalOpen = false" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold transition">
            Anulo
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-lg shadow-amber-500/20 transition">
            Dërgo Kërkesën e Servisit
          </button>
        </div>
      </form>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </div>
  </div>
  </template>

</div>







