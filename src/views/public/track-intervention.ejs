<div class="max-w-4xl mx-auto py-6 sm:py-10 px-4">

  <!-- Header i Ndjekjes Live -->
  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden mb-6">
    <!-- Glow Background Accent -->
    <div class="absolute -top-24 -right-24 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-6">
      <div>
        <div class="flex items-center gap-2.5 mb-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            NDJEKJE LIVE NË KOHË REALE
          </span>
          <span class="text-xs font-mono text-slate-400">#<%= intervention.number %></span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight">
          <%= intervention.title %>
        </h1>
        <p class="text-xs text-slate-400 mt-1 flex items-center gap-2">
          <span>📅 Data: <strong class="text-slate-200"><%= formatDate(intervention.date) %></strong></span>
          <% if (intervention.startTime) { %>
            <span>• Ora: <strong class="text-slate-200 font-mono"><%= intervention.startTime %> <%= intervention.endTime ? '- ' + intervention.endTime : '' %></strong></span>
          <% } %>
        </p>
      </div>

      <!-- Status Badge -->
      <div class="flex flex-col items-start sm:items-end gap-2">
        <% 
          let statusBg = 'bg-amber-500/15 text-amber-400 border-amber-500/30';
          let statusDot = 'bg-amber-400';
          if (intervention.status === 'Përfunduar') {
            statusBg = 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30';
            statusDot = 'bg-emerald-400';
          } else if (intervention.status === 'Anuluar') {
            statusBg = 'bg-rose-500/15 text-rose-400 border-rose-500/30';
            statusDot = 'bg-rose-400';
          }
        %>
        <span class="px-4 py-2 rounded-xl text-xs font-mono font-black border flex items-center gap-2 <%= statusBg %>">
          <span class="w-2.5 h-2.5 rounded-full <%= statusDot %>"></span>
          <%= intervention.status.toUpperCase() %>
        </span>
        <span class="text-[11px] text-slate-400 font-mono">Prioriteti: <strong class="text-amber-300"><%= intervention.priority %></strong></span>
      </div>
    </div>

    <!-- Stepper Vizual i Progresit Live -->
    <div class="relative py-4">
      <%
        const isCompleted = intervention.status === 'Përfunduar';
        const inProcess = intervention.status === 'Në Proces' || isCompleted;
      %>
      <div class="grid grid-cols-3 gap-2 sm:gap-4 relative text-center">
        <!-- Linja lidhëse në sfond -->
        <div class="absolute top-1/2 -translate-y-1/2 left-10 right-10 h-1 bg-slate-800 -z-0"></div>
        <div class="absolute top-1/2 -translate-y-1/2 left-10 h-1 bg-gradient-to-r from-amber-500 <%= isCompleted ? 'to-emerald-500 w-full' : (inProcess ? 'to-amber-500 w-1/2' : 'w-0') %> transition-all duration-700 -z-0"></div>

        <!-- Hapi 1: Planifikuar -->
        <div class="flex flex-col items-center gap-2 relative z-10">
          <div class="w-10 h-10 rounded-full bg-amber-500 text-slate-950 font-black flex items-center justify-center text-xs shadow-lg shadow-amber-500/30 border-2 border-slate-900">
            ✓
          </div>
          <div>
            <span class="text-xs font-bold text-slate-200 block">1. Regjistruar</span>
            <span class="text-[10px] text-slate-400 font-mono">Detyra u planifikua</span>
          </div>
        </div>

        <!-- Hapi 2: Ekipi në Terren / Në Proces -->
        <div class="flex flex-col items-center gap-2 relative z-10">
          <div class="w-10 h-10 rounded-full font-black flex items-center justify-center text-xs border-2 border-slate-900 <%= inProcess ? 'bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/30 animate-pulse' : 'bg-slate-800 text-slate-400' %>">
            <%= inProcess ? (isCompleted ? '✓' : '⚡') : '2' %>
          </div>
          <div>
            <span class="text-xs font-bold <%= inProcess ? 'text-amber-300' : 'text-slate-400' %> block">2. Në Punim e Sipër</span>
            <span class="text-[10px] text-slate-400 font-mono"><%= inProcess ? (isCompleted ? 'Punimet u kryen' : 'Ekipi po punon') : 'Në pritje të ekipit' %></span>
          </div>
        </div>

        <!-- Hapi 3: Përfunduar & Dorëzuar -->
        <div class="flex flex-col items-center gap-2 relative z-10">
          <div class="w-10 h-10 rounded-full font-black flex items-center justify-center text-xs border-2 border-slate-900 <%= isCompleted ? 'bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/30' : 'bg-slate-800 text-slate-400' %>">
            <%= isCompleted ? '✓' : '3' %>
          </div>
          <div>
            <span class="text-xs font-bold <%= isCompleted ? 'text-emerald-300' : 'text-slate-400' %> block">3. Përfunduar</span>
            <span class="text-[10px] text-slate-400 font-mono"><%= isCompleted ? 'Testuar me sukses' : 'Verifikim final' %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Kartat e Detajeve Teknike & Ekipit -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">

    <!-- 1. Të Dhënat e Objektit & Liftit -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
      <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        Të Dhënat e Objektit & Liftit
      </h2>

      <div class="space-y-3 text-xs">
        <% if (intervention.project) { %>
          <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
            <span class="text-slate-400">Projekti / Objekti:</span>
            <span class="font-bold text-slate-100 font-mono"><%= intervention.project.name %> (<%= intervention.project.number %>)</span>
          </div>
          <% if (intervention.project.customer) { %>
            <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
              <span class="text-slate-400">Klienti / Investitori:</span>
              <span class="font-semibold text-slate-200"><%= intervention.project.customer.companyName %></span>
            </div>
          <% } %>
        <% } %>

        <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
          <span class="text-slate-400">Modeli i Liftit:</span>
          <span class="font-bold text-slate-200"><%= intervention.elevatorModel || 'Lift Standard KRONEER' %></span>
        </div>

        <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
          <span class="text-slate-400">Numri Serik i Liftit:</span>
          <span class="font-mono font-bold text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/20"><%= intervention.elevatorSerialNumber || '-' %></span>
        </div>

        <div class="flex justify-between items-center py-1 border-b border-slate-800/60">
          <span class="text-slate-400">Lokacioni / Adresa:</span>
          <span class="font-medium text-slate-300 text-right"><%= intervention.location || '-' %></span>
        </div>

        <div class="flex justify-between items-center py-1">
          <span class="text-slate-400">Lloji i Shërbimit:</span>
          <span class="font-bold text-amber-400"><%= intervention.type %></span>
        </div>
      </div>
    </div>

    <!-- 2. Ekipi Teknik Përgjegjës -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
      <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Ekipi Teknik në Terren
      </h2>

      <div class="space-y-3 text-xs">
        <% if (intervention.projectManager) { %>
          <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-slate-400 block">Menaxher / Shef Montimi:</span>
              <strong class="text-slate-100"><%= intervention.projectManager.fullName %></strong>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Menaxher</span>
          </div>
        <% } %>

        <% if (intervention.teamWorkers && intervention.teamWorkers.length > 0) { %>
          <div class="space-y-2">
            <span class="text-slate-400 text-[11px] font-semibold block">Teknikët e caktuar:</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <% intervention.teamWorkers.forEach(tw => { %>
                <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-bold flex items-center justify-center text-[10px]">
                    ✓
                  </div>
                  <div>
                    <span class="font-bold text-slate-200 block"><%= tw.employee.firstName %> <%= tw.employee.lastName %></span>
                    <span class="text-[10px] text-slate-400 font-mono"><%= tw.roleInTeam %></span>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <p class="text-slate-400 italic text-[11px]">Ekipi teknik kryesor i autorizuar nga KRONEER.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Përshkrimi i Punës & Vërejtjet -->
  <% if (intervention.workDescription || intervention.partsReplaced || intervention.notes) { %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl mb-6 space-y-4">
      <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2">
        Detajet e Punimeve & Materialet
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <% if (intervention.workDescription) { %>
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-slate-400 text-[11px] font-bold block mb-1">Punimet e Kryera:</span>
            <p class="text-slate-200 leading-relaxed"><%= intervention.workDescription %></p>
          </div>
        <% } %>

        <% if (intervention.partsReplaced) { %>
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-slate-400 text-[11px] font-bold block mb-1">Pjesët & Materialet e Ndërruara:</span>
            <p class="text-cyan-300 font-mono leading-relaxed"><%= intervention.partsReplaced %></p>
          </div>
        <% } %>
      </div>

      <% if (intervention.notes) { %>
        <div class="p-3 rounded-xl bg-amber-500/5 border border-amber-500/20 text-xs text-amber-200">
          <strong>Shënim:</strong> <%= intervention.notes %>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Butonat e Veprimit & Ndarjes -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-slate-900/80 border border-slate-800">
    <div class="flex items-center gap-2">
      <button type="button" onclick="kopjoLinkunLive()" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 flex items-center gap-2 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <span id="copy-btn-txt">Kopjo Linkun e Ndjekjes</span>
      </button>
      <a href="/intervenimet/<%= intervention.id %>/print" target="_blank" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-slate-700 flex items-center gap-2 transition-all">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        <span>Printo / PDF</span>
      </a>
    </div>

    <!-- Ndihma & Asistenca 24/7 -->
    <a href="tel:<%= company.phone ? company.phone.replace(/[^0-9+]/g, '') : '+38338500600' %>" class="text-xs text-slate-400 hover:text-amber-300 flex items-center gap-2 transition-colors">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span>Keni pyetje? Telefono: <strong class="text-slate-200 font-mono"><%= company.phone || '+383 (0) 38 500 600' %></strong></span>
    </a>
  </div>

</div>

<script>
  function kopjoLinkunLive() {
    const url = window.location.href;
    navigator.clipboard.writeText(url).then(() => {
      const btn = document.getElementById('copy-btn-txt');
      const original = btn.textContent;
      btn.textContent = '✓ Linku u Kopjua!';
      setTimeout(() => { btn.textContent = original; }, 2500);
    });
  }
</script>
