<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono">NDRYSHO SHPENZIMIN</h1>
      <span class="font-mono text-sm font-bold text-rose-400 bg-rose-500/15 border border-rose-500/30 px-3 py-1 rounded-lg">
        <%= expense.number %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Përditësoni të dhënat, faturën referuese ose kategorinë e shpenzimit</p>
  </div>
  <a href="/shpenzimet/<%= expense.id %>" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo
  </a>
</div>

<form action="/shpenzimet/<%= expense.id %>/ndrysho" method="POST" class="space-y-6">
  
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Detajet e Shpenzimit
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Përshkrimi / Titulli i Shpenzimit *</label>
        <input type="text" name="title" value="<%= expense.title %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kategoria e Shpenzimit *</label>
        <select name="category" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= expense.category === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Shuma (€) *</label>
        <input type="number" name="amount" step="0.01" min="0.01" value="<%= expense.amount %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono font-bold text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Data e Kryerjes *</label>
        <input type="date" name="date" value="<%= new Date(expense.date).toISOString().split('T')[0] %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi i Pagesës</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% statuses.forEach(st => { %>
            <option value="<%= st %>" <%= expense.status === st ? 'selected' : '' %>><%= st %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Mënyra e Pagesës</label>
        <select name="paymentMethod" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Transfertë bankare" <%= expense.paymentMethod === 'Transfertë bankare' ? 'selected' : '' %>>Transfertë bankare</option>
          <option value="Para në dorë" <%= expense.paymentMethod === 'Para në dorë' ? 'selected' : '' %>>Para në dorë (Arkë)</option>
          <option value="Kartelë" <%= expense.paymentMethod === 'Kartelë' ? 'selected' : '' %>>Kartelë</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Furnitori / Përfituesi</label>
        <input type="text" name="supplier" value="<%= expense.supplier || '' %>" placeholder="Furnitori..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Faturës Hyrëse / Kuponit</label>
        <input type="text" name="referenceNumber" value="<%= expense.referenceNumber || '' %>" placeholder="p.sh. FAT-2026-904" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Lidh me Projektin (Opsionale)</label>
        <select name="projectId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Asnjë projekt specifik --</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>" <%= expense.projectId === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.number %>)</option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="mt-4">
      <label class="block font-semibold text-slate-300 mb-1">Shënime Shtesë</label>
      <textarea name="notes" rows="3" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"><%= expense.notes || '' %></textarea>
    </div>
  </div>

  <!-- Butonat -->
  <div class="flex items-center justify-between pt-2">
    <button type="button" onclick="if(confirm('A jeni të sigurt që dëshironi ta fshini shpenzimin <%= expense.number %>?')) { document.getElementById('delete-expense-form').submit(); }" class="px-5 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold text-xs border border-rose-500/30 transition-all flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Fshi Shpenzimin
    </button>
    <div class="flex items-center gap-3">
      <a href="/shpenzimet/<%= expense.id %>" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
        Anulo
      </a>
      <button type="submit" class="px-7 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
        RUAJ NDRYSHIMET
      </button>
    </div>
  </div>

</form>

<form id="delete-expense-form" action="/shpenzimet/<%= expense.id %>/fshi" method="POST" class="hidden"></form>
