<!-- Koka Zyrtare e Raportit të Shpenzimeve -->
<div class="flex justify-between items-start border-b-2 border-slate-900 pb-5 mb-6">
  <div>
    <% const printLogo = (company && company.logoUrl) ? company.logoUrl : (company && company.logoDarkBgUrl ? company.logoDarkBgUrl : null); %>
    <% if (printLogo) { %>
      <div class="h-11 max-w-[220px] flex items-center justify-start mb-2">
        <img src="<%= printLogo %>" alt="<%= company.companyName %>" class="max-h-11 w-auto max-w-full object-contain">
      </div>
    <% } else { %>
      <div class="flex items-center gap-3 mb-2">
        <div class="w-9 h-9 rounded-lg bg-slate-950 text-amber-400 font-black flex items-center justify-center text-lg font-mono">
          K
        </div>
        <div>
          <h1 class="text-xl font-black tracking-widest text-slate-950 font-mono"><%= company.companyName %></h1>
          <p class="text-[10px] font-bold text-amber-600"><%= company.tagline %></p>
        </div>
      </div>
    <% } %>
    <div class="text-[11px] text-slate-600 space-y-0.5">
      <div><%= company.address %>, <%= company.city %> • NUI: <%= company.taxNumber %></div>
      <div>Tel: <%= company.phone %> • Email: <%= company.email %></div>
    </div>
  </div>

  <div class="text-right">
    <span class="inline-block px-3 py-1 bg-slate-950 text-amber-400 text-xs font-mono font-black rounded uppercase tracking-wider mb-2">
      RAPORTI I SHPENZIMEVE
    </span>
    <div class="text-xs text-slate-600 mt-1">Data e Gjenerimit: <strong class="text-slate-900"><%= formatDate(new Date()) %></strong></div>
    <% if (categoryFilter) { %>
      <div class="text-xs text-rose-700 font-bold mt-1">Kategoria: <%= categoryFilter %></div>
    <% } %>
  </div>
</div>

<!-- Tabela e Shpenzimeve -->
<table class="w-full text-left text-xs border border-slate-300 mb-6">
  <thead class="bg-slate-100 text-slate-800 font-bold uppercase text-[10px] border-b border-slate-300">
    <tr>
      <th class="p-2.5 border-r border-slate-300 text-center w-10">Nr.</th>
      <th class="p-2.5 border-r border-slate-300 w-28">Numri</th>
      <th class="p-2.5 border-r border-slate-300">Titulli / Përshkrimi</th>
      <th class="p-2.5 border-r border-slate-300">Kategoria</th>
      <th class="p-2.5 border-r border-slate-300">Furnitori</th>
      <th class="p-2.5 border-r border-slate-300 text-center w-24">Data</th>
      <th class="p-2.5 border-r border-slate-300 text-right w-28">Shuma (€)</th>
      <th class="p-2.5 text-center w-20">Statusi</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-slate-200">
    <% if (expenses && expenses.length > 0) { %>
      <% expenses.forEach((exp, idx) => { %>
        <tr>
          <td class="p-2 text-center font-mono border-r border-slate-200 text-slate-600"><%= idx + 1 %></td>
          <td class="p-2 font-mono font-bold text-slate-900 border-r border-slate-200"><%= exp.number %></td>
          <td class="p-2 border-r border-slate-200 text-slate-800 font-medium"><%= exp.title %></td>
          <td class="p-2 border-r border-slate-200 text-slate-700"><%= exp.category %></td>
          <td class="p-2 border-r border-slate-200 text-slate-700"><%= exp.supplier || '-' %></td>
          <td class="p-2 text-center border-r border-slate-200 text-slate-700 font-mono"><%= formatDate(exp.date) %></td>
          <td class="p-2 text-right font-mono font-bold text-slate-900 border-r border-slate-200"><%= formatCurrency(exp.amount) %></td>
          <td class="p-2 text-center text-[10px] font-bold"><%= exp.status %></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="8" class="p-6 text-center text-slate-500">Nuk ka shpenzime të regjistruara për këtë përzgjedhje.</td>
      </tr>
    <% } %>
  </tbody>
  <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-300">
    <tr>
      <td colspan="6" class="p-2.5 text-right uppercase text-[10px] text-slate-600">TOTALI I PËRGJITHSHËM I SHPENZIMEVE:</td>
      <td class="p-2.5 text-right font-mono text-rose-600 text-sm"><%= formatCurrency(totalAmount) %></td>
      <td></td>
    </tr>
  </tfoot>
</table>

<div class="text-[10px] text-slate-500 text-center pt-8 border-t border-slate-200">
  Ky raport është gjeneruar automatikisht nga sistemi ERP & CRM KRONEER më <%= new Date().toLocaleDateString('sq-AL') %>.
</div>
