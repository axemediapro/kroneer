<!-- Header & Butonat e Veprimit -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-rose-400">Financat & Kontabiliteti</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono tracking-tight mt-1">
      MENAXHIMI I SHPENZIMEVE
    </h1>
    <p class="text-xs text-slate-400 mt-1">Monitorimi i kostove operative, materialeve, rrogave dhe nënkontraktorëve</p>
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <a href="/shpenzimet/eksporto-pdf<%= filters.category ? '?category=' + encodeURIComponent(filters.category) : '' %>" target="_blank" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all" title="Eksporto Raportin si PDF">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>Eksporto Raportin (PDF)</span>
    </a>
    <a href="/shpenzimet/krijo" class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Regjistro Shpenzim</span>
    </a>
  </div>
</div>

<!-- 4 Kartela Përmbledhëse të Shpenzimeve -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">TOTALI I SHPENZIMEVE</span>
      <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center font-bold text-sm">€</div>
    </div>
    <div class="text-2xl font-black text-slate-100 font-mono"><%= formatCurrency(totalExpenses) %></div>
    <span class="text-[11px] text-slate-500 mt-1 block"><%= expenses.length %> transaksione të regjistruara</span>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">KËTË MUAJ</span>
      <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-sm">📅</div>
    </div>
    <div class="text-2xl font-black text-amber-400 font-mono"><%= formatCurrency(monthlyExpenses) %></div>
    <span class="text-[11px] text-slate-500 mt-1 block">Kostot e muajit aktual</span>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">TË LIKUIDUARA (PAGUAR)</span>
      <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-sm">✓</div>
    </div>
    <div class="text-2xl font-black text-emerald-400 font-mono"><%= formatCurrency(paidExpenses) %></div>
    <span class="text-[11px] text-emerald-500/80 mt-1 block">Shpenzime të shlyera</span>
  </div>

  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">NË PRITJE PËR PAGESË</span>
      <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-sm">⏳</div>
    </div>
    <div class="text-2xl font-black text-cyan-400 font-mono"><%= formatCurrency(pendingExpenses) %></div>
    <span class="text-[11px] text-slate-500 mt-1 block">Detyrime afatshkurtra</span>
  </div>
</div>

<!-- Shpërndarja Sipas Kategorive -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl mb-6">
  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3 flex items-center gap-2">
    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
    Shpërndarja e Kostove Sipas Kategorive
  </h3>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3 text-xs">
    <% categories.forEach(cat => { 
      const catVal = categoryBreakdown[cat] || 0;
      const pct = totalExpenses > 0 ? Math.round((catVal / totalExpenses) * 100) : 0;
    %>
      <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800/80">
        <span class="text-[10px] text-slate-400 block truncate font-medium"><%= cat %></span>
        <div class="font-mono font-bold text-slate-100 text-sm mt-1"><%= formatCurrency(catVal) %></div>
        <span class="text-[10px] text-amber-400/80 font-mono font-semibold"><%= pct %>%</span>
      </div>
    <% }); %>
  </div>
</div>

<!-- Filtra dhe Kërkimi -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
  <form action="/shpenzimet" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 text-xs">
    <div>
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Kërko Shpenzime</label>
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Titulli, furnitori, kuponi..." class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
    </div>

    <div>
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Kategoria</label>
      <select name="category" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha kategoritë</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Statusi</label>
      <select name="status" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjithë statuset</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label class="block text-[11px] font-semibold text-slate-400 mb-1">Projekti</label>
      <select name="projectId" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
        <option value="">Të gjitha projektet</option>
        <% projects.forEach(p => { %>
          <option value="<%= p.id %>" <%= filters.projectId == p.id ? 'selected' : '' %>><%= p.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="flex items-end gap-2">
      <button type="submit" class="flex-1 py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all">
        Filtro
      </button>
      <% if (filters.category || filters.status || filters.search || filters.projectId) { %>
        <a href="/shpenzimet" class="py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all text-center">
          Pastro
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela Kryesore e Shpenzimeve -->
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-950/70 text-slate-400 uppercase font-bold text-[10px] border-b border-slate-800">
        <tr>
          <th class="p-4">Numri</th>
          <th class="p-4">Përshkrimi / Titulli</th>
          <th class="p-4">Kategoria</th>
          <th class="p-4">Furnitori / Përfituesi</th>
          <th class="p-4">Data</th>
          <th class="p-4 font-mono">Shuma (€)</th>
          <th class="p-4">Statusi</th>
          <th class="p-4 text-right">Veprime</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-xs">
        <% if (expenses && expenses.length > 0) { %>
          <% expenses.forEach(exp => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="p-4">
                <a href="/shpenzimet/<%= exp.id %>" class="font-mono font-bold text-rose-400 hover:underline">
                  <%= exp.number %>
                </a>
                <% if (exp.referenceNumber) { %>
                  <div class="text-[10px] text-slate-500 font-mono">Ref: <%= exp.referenceNumber %></div>
                <% } %>
              </td>
              <td class="p-4">
                <div class="font-bold text-slate-200"><%= exp.title %></div>
                <% if (exp.project) { %>
                  <div class="text-[10px] text-amber-400 mt-0.5">Projekt: <%= exp.project.name %></div>
                <% } %>
              </td>
              <td class="p-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                  <%= exp.category %>
                </span>
              </td>
              <td class="p-4 text-slate-300">
                <%= exp.supplier || '-' %>
                <div class="text-[10px] text-slate-500"><%= exp.paymentMethod %></div>
              </td>
              <td class="p-4 text-slate-300 font-mono">
                <%= formatDate(exp.date) %>
              </td>
              <td class="p-4 font-mono font-black text-slate-100 text-sm">
                <%= formatCurrency(exp.amount) %>
              </td>
              <td class="p-4">
                <% if (exp.status === 'Paguar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Paguar</span>
                <% } else if (exp.status === 'Refuzuar') { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30">Refuzuar</span>
                <% } else { %>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">Në pritje</span>
                <% } %>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <a href="/shpenzimet/<%= exp.id %>" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors" title="Shiko Detajet">
                    Shiko
                  </a>
                  <a href="/shpenzimet/<%= exp.id %>/ndrysho" class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 text-xs font-semibold border border-amber-500/30 transition-colors" title="Ndrysho">
                    Ndrysho
                  </a>
                  <form action="/shpenzimet/<%= exp.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini shpenzimin <%= exp.number %>?');">
                    <button type="submit" class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-500/40 transition-colors" title="Fshi">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                  <a href="/shpenzimet/<%= exp.id %>/print" target="_blank" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-amber-400 transition-colors" title="Fletë-shpenzim A4 / PDF">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="p-8 text-center text-slate-500">Nuk u gjet asnjë shpenzim me kriteret e zgjedhura.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
