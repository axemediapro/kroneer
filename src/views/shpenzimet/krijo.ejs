<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-black text-slate-100 font-mono">REGJISTRO SHPENZIM TË RI</h1>
      <span class="font-mono text-sm font-bold text-rose-400 bg-rose-500/15 border border-rose-500/30 px-3 py-1 rounded-lg">
        <%= nextNumber %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Plotësoni të dhënat e kostos operative, furnitorit dhe projektit</p>
  </div>
  <a href="/shpenzimet" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
    Anulo
  </a>
</div>

<form action="/shpenzimet/krijo" method="POST" class="space-y-6">
  
  <!-- Detajet Kryesore të Shpenzimit -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-xs">
    <h3 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
      1. Detajet e Shpenzimit dhe Faturimit
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Përshkrimi / Titulli i Shpenzimit *</label>
        <input type="text" name="title" required placeholder="p.sh. Blerje shinash udhëzuese T75 dhe suportesh..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Kategoria e Shpenzimit *</label>
        <select name="category" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% categories.forEach(c => { %>
            <option value="<%= c %>"><%= c %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Shuma (€) *</label>
        <input type="number" name="amount" step="0.01" min="0.01" required placeholder="0.00" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono font-bold text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Data e Kryerjes *</label>
        <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Statusi i Pagesës</label>
        <select name="status" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <% statuses.forEach(st => { %>
            <option value="<%= st %>"><%= st %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Mënyra e Pagesës</label>
        <select name="paymentMethod" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="Transfertë bankare">Transfertë bankare</option>
          <option value="Para në dorë">Para në dorë (Arkë)</option>
          <option value="Kartelë">Kartelë</option>
        </select>
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Furnitori / Përfituesi</label>
        <input type="text" name="supplier" placeholder="Emri i kompanisë furnizuese ose punonjësit" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div>
        <label class="block font-semibold text-slate-300 mb-1">Numri i Faturës Hyrëse / Kuponit</label>
        <input type="text" name="referenceNumber" placeholder="p.sh. FAT-2026-904" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-slate-100 focus:outline-none focus:border-amber-400">
      </div>

      <div class="sm:col-span-2">
        <label class="block font-semibold text-slate-300 mb-1">Lidh me Projektin (Opsionale)</label>
        <select name="projectId" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400">
          <option value="">-- Asnjë projekt specifik (Kosto e përgjithshme) --</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.number %>)</option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="mt-4">
      <label class="block font-semibold text-slate-300 mb-1">Shënime Shtesë</label>
      <textarea name="notes" rows="3" placeholder="Shënime për kontabilitetin, arsyetimin e shpenzimit ose fletë-blerjen..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-100 focus:outline-none focus:border-amber-400"></textarea>
    </div>
  </div>

  <!-- Butonat -->
  <div class="flex items-center justify-end gap-3">
    <a href="/shpenzimet" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 transition-all">
      Anulo
    </a>
    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all">
      RUAJ SHPENZIMIN
    </button>
  </div>

</form>
