<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 font-mono"><%= expense.number %></h1>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase <%= expense.status === 'Paguar' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : (expense.status === 'Refuzuar' ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30') %>">
        <%= expense.status %>
      </span>
    </div>
    <p class="text-xs text-slate-400 mt-1">Kategoria: <strong class="text-slate-200"><%= expense.category %></strong> • Data: <%= formatDate(expense.date) %></p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <a href="/shpenzimet/<%= expense.id %>/ndrysho" class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <span>Ndrysho</span>
    </a>
    <a href="/shpenzimet/<%= expense.id %>/print" target="_blank" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs flex items-center gap-1.5 transition-all">
      <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Fletë-shpenzim (PDF)</span>
    </a>
    <form action="/shpenzimet/<%= expense.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('A jeni të sigurt që dëshironi ta fshini shpenzimin <%= expense.number %>?');">
      <button type="submit" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold text-xs flex items-center gap-1.5 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Fshi</span>
      </button>
    </form>
  </div>
</div>

<!-- Karta Kryesore e Shpenzimit -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  
  <div class="lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
    <div class="border-b border-slate-800 pb-3 flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">PËRSHKRIMI I SHPENZIMIT</span>
      <span class="text-xs font-mono font-bold text-rose-400"><%= expense.number %></span>
    </div>

    <h2 class="text-lg font-bold text-slate-100"><%= expense.title %></h2>

    <div class="grid grid-cols-2 gap-4 text-xs pt-2">
      <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800/80">
        <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">FURNITORI / PËRFITUESI</span>
        <div class="text-slate-200 font-semibold"><%= expense.supplier || 'Pa specifikuar' %></div>
      </div>
      <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800/80">
        <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">NUMRI REFERUES I FATURËS</span>
        <div class="text-slate-200 font-mono font-semibold"><%= expense.referenceNumber || '-' %></div>
      </div>
      <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800/80">
        <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">MËNYRA E PAGESËS</span>
        <div class="text-slate-200 font-semibold"><%= expense.paymentMethod %></div>
      </div>
      <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800/80">
        <span class="text-[10px] text-slate-400 uppercase font-bold block mb-1">PROJEKTI PËRKATËS</span>
        <div class="text-slate-200 font-semibold">
          <% if (expense.project) { %>
            <a href="/projektet/<%= expense.project.id %>" class="text-amber-400 hover:underline">
              <%= expense.project.name %> (<%= expense.project.number %>)
            </a>
          <% } else { %>
            Shpenzim i përgjithshëm
          <% } %>
        </div>
      </div>
    </div>

    <% if (expense.notes) { %>
      <div class="mt-4 p-4 rounded-xl bg-slate-950/60 border border-slate-800 text-xs text-slate-300">
        <span class="text-amber-400 font-bold block mb-1">Shënime Kontabël:</span>
        <p class="leading-relaxed"><%= expense.notes %></p>
      </div>
    <% } %>
  </div>

  <!-- Paneli Anësor Financiar -->
  <div class="space-y-4">
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl text-center">
      <span class="text-[11px] font-bold uppercase text-slate-400 tracking-wider block mb-2">SHUMA TOTALE</span>
      <div class="text-3xl font-black text-rose-400 font-mono"><%= formatCurrency(expense.amount) %></div>
      <span class="text-[11px] text-slate-500 mt-2 block">Monedha: <%= expense.currency %></span>
    </div>

    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl text-xs space-y-2 text-slate-400">
      <div class="flex justify-between border-b border-slate-800/80 pb-2">
        <span>Regjistruar më:</span>
        <span class="text-slate-200 font-mono"><%= formatDate(expense.createdAt) %></span>
      </div>
      <div class="flex justify-between border-b border-slate-800/80 pb-2">
        <span>Modifikuar më:</span>
        <span class="text-slate-200 font-mono"><%= formatDate(expense.updatedAt) %></span>
      </div>
      <% if (expense.user) { %>
        <div class="flex justify-between pt-1">
          <span>Regjistruar nga:</span>
          <span class="text-slate-200 font-bold"><%= expense.user.fullName %></span>
        </div>
      <% } %>
    </div>
  </div>

</div>
