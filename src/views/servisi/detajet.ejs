<div class="space-y-6" x-data="{ showUpdateModal: false, selectedStatus: '<%= ticket.status %>', selectedTechnician: '<%= ticket.technicianId || '' %>', selectedPriority: '<%= ticket.priority %>', notes: `<%= ticket.resolutionNotes || '' %>` }">
  
  <!-- Top Breadcrumb & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-1">
        <a href="/servisi" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Kërkesat për Servis</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-slate-200 font-mono font-medium">Tiketa: <%= ticket.number %></span>
      </div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Tiketa <%= ticket.number %>
        </h1>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= 
          ticket.priority === 'Kritik' ? 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-400 border border-rose-300 dark:border-rose-800 animate-pulse' :
          ticket.priority === 'I lartë' ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-400 border border-amber-300 dark:border-amber-800' :
          ticket.priority === 'Normal' ? 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-400 border border-blue-300 dark:border-blue-800' :
          'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300'
        %>">
          <i data-lucide="alert-triangle" class="w-3.5 h-3.5 mr-1.5"></i>
          Prioriteti: <%= ticket.priority %>
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= 
          ticket.status === 'Zgjidhur' || ticket.status === 'Mbyllur' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800' :
          ticket.status === 'Në proces' ? 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-400 border border-blue-300 dark:border-blue-800' :
          ticket.status === 'Caktuar' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-400 border border-indigo-300 dark:border-indigo-800' :
          'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-400 border border-amber-300 dark:border-amber-800'
        %>">
          <%= ticket.status %>
        </span>
      </div>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        Klienti: <a href="/klientet/<%= ticket.customerId %>" class="font-medium text-amber-600 dark:text-amber-400 hover:underline"><%= ticket.customer ? ticket.customer.companyName : '-' %></a>
        <% if (ticket.serialNumber) { %>
          • Ashensori (SN): <span class="font-mono font-bold text-slate-700 dark:text-slate-300"><%= ticket.serialNumber %></span>
        <% } %>
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-2.5">
      <button 
        type="button" 
        @click="showUpdateModal = true"
        class="inline-flex items-center px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold rounded-lg shadow-sm transition"
      >
        <i data-lucide="edit-3" class="w-4 h-4 mr-2"></i>
        Përditëso Statusin & Teknikun
      </button>

      <a 
        href="/servisi/<%= ticket.id %>/print" 
        target="_blank"
        class="inline-flex items-center px-4 py-2 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-sm font-semibold border border-slate-300 dark:border-slate-700 rounded-lg shadow-sm transition"
      >
        <i data-lucide="printer" class="w-4 h-4 mr-2 text-slate-400"></i>
        Printo Fletëdaljen
      </a>

      <% if (trackingUrl) { %>
        <a 
          href="<%= trackingUrl %>" 
          target="_blank"
          class="inline-flex items-center px-3.5 py-2 bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/60 dark:hover:bg-indigo-900/80 text-indigo-700 dark:text-indigo-300 text-sm font-semibold rounded-lg border border-indigo-200 dark:border-indigo-800 shadow-sm transition"
        >
          <i data-lucide="external-link" class="w-4 h-4 mr-1.5 text-indigo-500"></i>
          Portali Publik i Liftit
        </a>
      <% } %>

      <a href="/servisi" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition">
        Kthehu
      </a>
    </div>
  </div>

  <!-- Status Lifecycle Banner -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">Rrjedha e Ekzekutimit të Servisit</h3>
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center">
      <% const steps = ['Hapur', 'Caktuar', 'Në proces', 'Zgjidhur', 'Mbyllur']; %>
      <% const stepOrder = { 'Hapur': 1, 'Caktuar': 2, 'Në proces': 3, 'Në pritje': 3, 'Zgjidhur': 4, 'Mbyllur': 5 }; %>
      <% const currentStepVal = stepOrder[ticket.status] || 1; %>
      
      <% steps.forEach((step, idx) => { %>
        <% const isDone = stepOrder[step] <= currentStepVal; %>
        <% const isCurrent = ticket.status === step; %>
        <div class="p-3 rounded-xl border <%= isCurrent ? 'bg-amber-500/10 border-amber-500 text-amber-600 dark:text-amber-400 font-bold ring-2 ring-amber-500/20' : isDone ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-semibold' : 'bg-slate-50 dark:bg-slate-900/40 border-slate-200 dark:border-slate-700 text-slate-400' %>">
          <div class="text-xs font-mono mb-1"><%= idx + 1 %>. <%= step %></div>
          <% if (isCurrent) { %>
            <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
          <% } else if (isDone) { %>
            <i data-lucide="check" class="w-3.5 h-3.5 mx-auto text-emerald-500"></i>
          <% } else { %>
            <span class="inline-block w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600"></span>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left Column (2 Cols): Problem Description, Resolution & Diagnostics -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Breakdown Details Card -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-3">
          <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center">
            <i data-lucide="file-text" class="w-5 h-5 mr-2 text-amber-500"></i>
            Përshkrimi i Defektit & Kërkesës
          </h2>
          <span class="text-xs text-slate-500">Raportuar më <%= new Date(ticket.reportedDate).toLocaleString('sq-AL') %></span>
        </div>

        <div class="bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200 dark:border-slate-700/80">
          <p class="text-sm text-slate-800 dark:text-slate-200 whitespace-pre-line leading-relaxed font-sans">
            <%= ticket.problemDescription %>
          </p>
        </div>

        <!-- Resolution Notes -->
        <div class="pt-2">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-2 flex items-center">
            <i data-lucide="check-circle-2" class="w-4 h-4 mr-2 text-emerald-500"></i>
            Shënimet e Inxhinierit / Zgjidhja Teknike
          </h3>
          <% if (ticket.resolutionNotes) { %>
            <div class="bg-emerald-50/50 dark:bg-emerald-950/30 p-4 rounded-xl border border-emerald-200 dark:border-emerald-800/60 text-sm text-emerald-900 dark:text-emerald-200 whitespace-pre-line">
              <%= ticket.resolutionNotes %>
              <% if (ticket.resolvedDate) { %>
                <div class="mt-2 text-xs text-emerald-600 dark:text-emerald-400 font-semibold flex items-center">
                  <i data-lucide="clock" class="w-3.5 h-3.5 mr-1"></i>
                  Përmbyllur më: <%= new Date(ticket.resolvedDate).toLocaleString('sq-AL') %>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="p-4 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-xs text-slate-500">
              Nuk janë regjistruar ende shënime të zgjidhjes teknike. Përdorni butonin "Përditëso Statusin" për të shtuar raportin e intervenimit.
            </div>
          <% } %>
        </div>

        <% if (ticket.partsUsed || ticket.testResults || ticket.clientSignature) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <% if (ticket.partsUsed) { %>
              <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-3">
                <h3 class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Pjesët e përdorura</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 whitespace-pre-line"><%= ticket.partsUsed %></p>
              </div>
            <% } %>
            <% if (ticket.testResults) { %>
              <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-3">
                <h3 class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Testimi pas servisit</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 whitespace-pre-line"><%= ticket.testResults %></p>
              </div>
            <% } %>
            <% if (ticket.clientSignature) { %>
              <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-3 sm:col-span-2">
                <h3 class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Nënshkrimi i klientit</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400"><%= ticket.clientSignerName || 'Klienti' %><% if (ticket.clientSignedAt) { %> · <%= new Date(ticket.clientSignedAt).toLocaleString('sq-AL') %><% } %></p>
                <img src="<%= ticket.clientSignature %>" alt="Nënshkrimi i klientit" class="mt-2 max-h-24 bg-white border border-slate-200 rounded">
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Quick Timeline & Activity Logs -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider flex items-center">
          <i data-lucide="history" class="w-4 h-4 mr-2 text-indigo-500"></i>
          Historia & Ditari i Ndërhyrjes
        </h3>

        <% if (activityLogs && activityLogs.length > 0) { %>
          <div class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs">
            <% activityLogs.forEach(log => { %>
              <div class="py-2.5 flex items-start justify-between gap-4">
                <div>
                  <span class="font-bold text-slate-800 dark:text-slate-200"><%= log.userName || 'Sistemi' %></span>
                  <p class="text-slate-600 dark:text-slate-400 mt-0.5"><%= log.description %></p>
                </div>
                <span class="text-slate-400 shrink-0 font-mono"><%= new Date(log.createdAt).toLocaleString('sq-AL') %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-500">Tiketa u krijua më <%= new Date(ticket.createdAt).toLocaleString('sq-AL') %>.</p>
        <% } %>
      </div>

    </div>

    <!-- Right Column (1 Col): Client, Elevator & Technician Specs -->
    <div class="space-y-6">
      
      <!-- Customer Information Card -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center">
          <i data-lucide="building-2" class="w-4 h-4 mr-1.5 text-amber-500"></i>
          Informacioni i Klientit
        </h3>

        <% if (ticket.customer) { %>
          <div class="text-xs space-y-2">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase">Kompania / Klienti:</span>
              <a href="/klientet/<%= ticket.customerId %>" class="text-sm font-bold text-slate-900 dark:text-white hover:text-amber-600 hover:underline">
                <%= ticket.customer.companyName %>
              </a>
            </div>
            <% if (ticket.customer.contactPerson) { %>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase">Personi Kontaktues:</span>
                <span class="font-medium text-slate-800 dark:text-slate-200"><%= ticket.customer.contactPerson %></span>
              </div>
            <% } %>
            <% if (ticket.customer.phone) { %>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase">Telefoni:</span>
                <a href="tel:<%= ticket.customer.phone %>" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1">
                  <i data-lucide="phone" class="w-3 h-3"></i> <%= ticket.customer.phone %>
                </a>
              </div>
            <% } %>
            <% if (ticket.customer.email) { %>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase">Email:</span>
                <a href="mailto:<%= ticket.customer.email %>" class="text-slate-700 dark:text-slate-300 hover:underline flex items-center gap-1">
                  <i data-lucide="mail" class="w-3 h-3"></i> <%= ticket.customer.email %>
                </a>
              </div>
            <% } %>
            <% if (ticket.customer.city || ticket.customer.address) { %>
              <div>
                <span class="text-slate-400 block text-[10px] uppercase">Adresa / Qyteti:</span>
                <span class="text-slate-700 dark:text-slate-300"><%= [ticket.customer.address, ticket.customer.city].filter(Boolean).join(', ') %></span>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-500">Nuk ka të dhëna për klientin.</p>
        <% } %>
      </div>

      <!-- Technician & Scheduling Card -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center">
          <i data-lucide="user-check" class="w-4 h-4 mr-1.5 text-indigo-500"></i>
          Tekniku Përgjegjës
        </h3>

        <% if (ticket.technician) { %>
          <div class="flex items-center space-x-3 p-3 bg-slate-50 dark:bg-slate-900/50 rounded-lg border border-slate-200/80 dark:border-slate-700/80">
            <div class="w-9 h-9 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center shrink-0">
              <%= ticket.technician.fullName.split(' ').map(n => n[0]).join('').substring(0, 2) %>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900 dark:text-white"><%= ticket.technician.fullName %></p>
              <p class="text-[11px] text-slate-500"><%= ticket.technician.role %></p>
            </div>
          </div>
        <% } else { %>
          <div class="p-3 bg-amber-50 dark:bg-amber-950/40 rounded-lg border border-amber-200 dark:border-amber-800/60 text-xs text-amber-800 dark:text-amber-300">
            Ende nuk është caktuar asnjë teknik për këtë kërkesë.
          </div>
        <% } %>

        <% if (ticket.scheduledDate) { %>
          <div class="text-xs text-slate-600 dark:text-slate-400 pt-1">
            Data e Planifikuar e Ndërhyrjes: <strong class="text-slate-800 dark:text-slate-200"><%= new Date(ticket.scheduledDate).toLocaleDateString('sq-AL') %></strong>
          </div>
        <% } %>
      </div>

      <!-- Elevator & Maintenance Contract Card -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center">
          <i data-lucide="cpu" class="w-4 h-4 mr-1.5 text-emerald-500"></i>
          Ashensori & Mirëmbajtja
        </h3>

        <div class="text-xs space-y-2">
          <% if (ticket.serialNumber) { %>
            <div class="flex justify-between items-center">
              <span class="text-slate-500">Numri Serik:</span>
              <span class="font-mono font-bold text-amber-600 dark:text-amber-400"><%= ticket.serialNumber %></span>
            </div>
          <% } %>

          <% if (ticket.elevator) { %>
            <div class="flex justify-between items-center">
              <span class="text-slate-500">Modeli i Katalogut:</span>
              <span class="font-bold text-slate-800 dark:text-slate-200"><%= ticket.elevator.model %></span>
            </div>
          <% } %>

          <% if (installation) { %>
            <div class="pt-2 border-t border-slate-100 dark:divide-slate-700/60">
              <a href="/instalimet/<%= installation.id %>" class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-semibold flex items-center">
                <i data-lucide="layers" class="w-3.5 h-3.5 mr-1"></i> Shiko Qendrën e Instalimit
              </a>
            </div>
          <% } %>

          <% if (maintenanceContract) { %>
            <div class="p-2.5 rounded-lg bg-emerald-50/60 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-xs space-y-1 mt-2">
              <div class="flex justify-between items-center">
                <span class="font-bold text-emerald-900 dark:text-emerald-300">Kontratë Mirëmbajtjeje Aktive</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-200 text-emerald-800 font-bold"><%= maintenanceContract.status %></span>
              </div>
              <p class="text-[11px] text-emerald-700 dark:text-emerald-400">
                Paketa: <%= maintenanceContract.packageType %> • <%= maintenanceContract.visitsPerYear %> vizita/vit.
              </p>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>

  <!-- Modal: Përditëso Statusin & Teknikun -->
  <div 
    x-show="showUpdateModal" 
    x-cloak 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm"
    @keydown.escape.window="showUpdateModal = false"
  >
    <div 
      class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 max-w-lg w-full max-h-[90vh] overflow-y-auto p-6 shadow-2xl space-y-4"
      @click.away="showUpdateModal = false"
    >
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <h3 class="font-bold text-slate-900 dark:text-white text-base flex items-center">
          <i data-lucide="edit-3" class="w-4 h-4 mr-2 text-amber-500"></i>
          Përditëso Tiketën <%= ticket.number %>
        </h3>
        <button @click="showUpdateModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form action="/servisi/<%= ticket.id %>/status" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Statusi i Ri</label>
          <select name="status" x-model="selectedStatus" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500">
            <% statuses.forEach(st => { %>
              <option value="<%= st %>" <%= ticket.status === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Prioriteti</label>
          <select name="priority" x-model="selectedPriority" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500">
            <% priorities.forEach(p => { %>
              <option value="<%= p %>" <%= ticket.priority === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Cakto Teknikun Përgjegjës</label>
          <select name="technicianId" x-model="selectedTechnician" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500">
            <option value="">-- Pa teknik --</option>
            <% technicians.forEach(tech => { %>
              <option value="<%= tech.id %>" <%= ticket.technicianId === tech.id ? 'selected' : '' %>><%= tech.fullName %> (<%= tech.role %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Shënimet e Zgjidhjes Teknike / Veprimet e Ndërmarra</label>
          <textarea name="resolutionNotes" x-model="notes" rows="4" placeholder="Përshkruani veprimet teknike, pjesët e zëvendësuara dhe arsyen e avarisë..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500"></textarea>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Pjesët e përdorura dhe sasitë</label>
          <textarea name="partsUsed" rows="2" placeholder="Një pjesë për rresht, p.sh. Kontaktor 24V · 1 copë" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500"><%= ticket.partsUsed || '' %></textarea>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Rezultati i testimit</label>
          <textarea name="testResults" rows="2" placeholder="Kontrollet e sigurisë dhe funksionimi pas riparimit..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500"><%= ticket.testResults || '' %></textarea>
        </div>

        <div class="space-y-2">
          <label for="service-client-signer" class="block font-semibold text-slate-700 dark:text-slate-300">Emri i klientit që pranon shërbimin</label>
          <input id="service-client-signer" name="clientSignerName" value="<%= ticket.clientSignerName || '' %>" maxlength="120" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500">
          <canvas id="service-client-signature" width="640" height="180" class="w-full h-36 rounded-lg border border-slate-300 dark:border-slate-600 bg-white touch-none"></canvas>
          <input type="hidden" id="service-client-signature-data" name="clientSignatureData" value="<%= ticket.clientSignature || '' %>">
          <input type="hidden" id="service-signature-changed" name="signatureChanged" value="false">
          <div class="flex items-center justify-between">
            <span class="text-[11px] text-slate-500">Nënshkruani në ekran për të konfirmuar përfundimin.</span>
            <button type="button" id="service-clear-signature" class="text-xs font-semibold text-rose-600 hover:text-rose-700">Pastro nënshkrimin</button>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
          <button type="button" @click="showUpdateModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-semibold rounded-lg transition">
            Anulo
          </button>
          <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg shadow-sm transition">
            Ruaj Ndryshimet
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

<script>
  (() => {
    const canvas = document.getElementById('service-client-signature');
    if (!canvas) return;

    const context = canvas.getContext('2d');
    const signatureData = document.getElementById('service-client-signature-data');
    const signatureChanged = document.getElementById('service-signature-changed');
    const signerName = document.getElementById('service-client-signer');
    const clearButton = document.getElementById('service-clear-signature');
    let drawing = false;

    context.strokeStyle = '#111827';
    context.lineWidth = 3;
    context.lineCap = 'round';
    context.lineJoin = 'round';

    if (signatureData.value) {
      const image = new Image();
      image.onload = () => context.drawImage(image, 0, 0, canvas.width, canvas.height);
      image.src = signatureData.value;
    }

    const position = event => {
      const bounds = canvas.getBoundingClientRect();
      return {
        x: (event.clientX - bounds.left) * canvas.width / bounds.width,
        y: (event.clientY - bounds.top) * canvas.height / bounds.height
      };
    };

    canvas.addEventListener('pointerdown', event => {
      event.preventDefault();
      drawing = true;
      canvas.setPointerCapture(event.pointerId);
      const point = position(event);
      context.beginPath();
      context.moveTo(point.x, point.y);
      context.lineTo(point.x + 0.1, point.y + 0.1);
      context.stroke();
      signatureChanged.value = 'true';
      signatureData.value = canvas.toDataURL('image/png');
    });

    canvas.addEventListener('pointermove', event => {
      if (!drawing) return;
      const point = position(event);
      context.lineTo(point.x, point.y);
      context.stroke();
    });

    const stopDrawing = () => {
      if (!drawing) return;
      drawing = false;
      signatureData.value = canvas.toDataURL('image/png');
    };
    canvas.addEventListener('pointerup', stopDrawing);
    canvas.addEventListener('pointercancel', stopDrawing);

    clearButton.addEventListener('click', () => {
      context.clearRect(0, 0, canvas.width, canvas.height);
      signatureData.value = '';
      signatureChanged.value = 'true';
      signerName.value = '';
    });
  })();
</script>
