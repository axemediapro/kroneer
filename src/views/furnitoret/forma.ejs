<% const s = supplier || {}; const editing = !!supplier; %>
<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-1">
        <a href="/furnitoret" class="hover:text-amber-600 dark:hover:text-amber-400">Furnitorët</a><span>/</span>
        <span class="text-slate-900 dark:text-slate-200"><%= editing ? 'Ndrysho' : 'I Ri' %></span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight"><%= editing ? 'Ndrysho Furnitorin' : 'Regjistro Furnitor të Ri' %></h1>
    </div>
    <a href="/furnitoret" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg">Kthehu</a>
  </div>

  <form action="<%= editing ? '/furnitoret/' + s.id + '/ndrysho' : '/furnitoret/krijo' %>" method="POST" class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Emri i Furnitorit *</label>
        <input type="text" name="name" required value="<%= s.name || '' %>" placeholder="Emri i kompanisë" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Personi Kontaktues</label>
        <input type="text" name="contactPerson" value="<%= s.contactPerson || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Nr. Fiskal / NUI</label>
        <input type="text" name="taxNumber" value="<%= s.taxNumber || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Telefoni</label>
        <input type="text" name="phone" value="<%= s.phone || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Email</label>
        <input type="email" name="email" value="<%= s.email || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Shteti</label>
        <input type="text" name="country" value="<%= s.country || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Qyteti</label>
        <input type="text" name="city" value="<%= s.city || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div class="md:col-span-2"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Adresa</label>
        <input type="text" name="address" value="<%= s.address || '' %>" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"></div>
      <div class="md:col-span-2"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Shënime</label>
        <textarea name="notes" rows="3" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"><%= s.notes || '' %></textarea></div>
      <% if (editing) { %>
      <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300"><input type="checkbox" name="isActive" <%= s.isActive ? 'checked' : '' %>> Aktiv (shfaqet te zgjedhja e pjesëve)</label>
      <% } %>
    </div>
    <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-3">
      <a href="/furnitoret" class="px-5 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 rounded-lg">Anulo</a>
      <button type="submit" class="px-5 py-2.5 text-sm font-bold text-slate-950 bg-amber-500 hover:bg-amber-400 rounded-lg shadow-sm">Ruaj Furnitorin</button>
    </div>
  </form>
</div>