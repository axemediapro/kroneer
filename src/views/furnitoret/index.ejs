<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Furnitorët</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Furnitorët e pjesëve, produkteve dhe pajisjeve. Zgjidhen te regjistrimi i pjesëve të liftit.</p>
    </div>
    <a href="/furnitoret/krijo" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 text-xs font-black rounded-xl shadow-lg shadow-amber-500/20">+ Furnitor i Ri</a>
  </div>

  <form method="GET" class="flex gap-2">
    <input type="text" name="q" value="<%= search %>" placeholder="Kërko furnitor, kontakt, telefon, qytet…" class="flex-1 px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500 focus:outline-none">
    <button class="px-4 py-2.5 bg-slate-800 text-white text-sm font-bold rounded-lg">Kërko</button>
  </form>

  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-[11px] uppercase text-slate-500 text-left">
        <tr><th class="p-3">Furnitori</th><th class="p-3">Kontakti</th><th class="p-3">Telefoni / Email</th><th class="p-3">Vendndodhja</th><th class="p-3 text-center">Pjesë</th><th class="p-3"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
        <% if (!suppliers.length) { %>
          <tr><td colspan="6" class="p-6 text-center text-slate-500">Nuk ka furnitorë të regjistruar.</td></tr>
        <% } %>
        <% suppliers.forEach(s => { %>
        <tr class="<%= s.isActive ? '' : 'opacity-60' %>">
          <td class="p-3 font-bold text-slate-900 dark:text-white"><%= s.name %><% if (!s.isActive) { %> <span class="text-[10px] text-slate-500">(joaktiv)</span><% } %></td>
          <td class="p-3 text-slate-700 dark:text-slate-300"><%= s.contactPerson || '-' %></td>
          <td class="p-3 text-slate-700 dark:text-slate-300"><div><%= s.phone || '-' %></div><div class="text-xs text-slate-500"><%= s.email || '' %></div></td>
          <td class="p-3 text-slate-700 dark:text-slate-300"><%= [s.city, s.country].filter(Boolean).join(', ') || '-' %></td>
          <td class="p-3 text-center font-mono"><%= s._count.parts %></td>
          <td class="p-3 text-right whitespace-nowrap">
            <a href="/furnitoret/<%= s.id %>/ndrysho" class="text-amber-500 hover:text-amber-400 font-bold text-xs">Ndrysho</a>
            <form action="/furnitoret/<%= s.id %>/fshi" method="POST" class="inline" onsubmit="return confirm('Të fshihet furnitori?')">
              <button class="ml-3 text-rose-500 hover:text-rose-400 font-bold text-xs">Fshi</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>