<aside id="main-sidebar" class="sidebar fixed inset-y-0 left-0 z-40 w-64 bg-slate-900 border-r border-slate-800 flex flex-col transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0 overflow-y-auto">
  <%
    const uRole = (typeof currentUser !== 'undefined' && currentUser && currentUser.role) ? currentUser.role : '';
    const isAdmin = uRole === 'ADMINISTRATOR';
    const isManager = uRole === 'MENAXHER_PROJEKTI';
    const isTech = uRole === 'TEKNIK';
    const isSales = uRole === 'SHITJE';
    const isFinance = uRole === 'FINANCE';
    const navCls = (active) => active
      ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30'
      : 'text-slate-300 hover:bg-slate-800 hover:text-slate-100';
  %>

  <div class="p-4 border-b border-slate-800 flex items-center justify-between">
    <a href="/paneli" class="flex items-center gap-2.5 group min-w-0">
      <% const sidebarLogo = (company && company.logoDarkBgUrl) ? company.logoDarkBgUrl : ((company && company.logoUrl) ? company.logoUrl : '/images/kroneer-logo-white.svg'); %>
      <div class="h-8 max-w-[190px] flex items-center justify-start flex-shrink-0">
        <img src="<%= sidebarLogo %>" alt="<%= company ? company.companyName : 'KRONEER' %>" class="max-h-8 w-auto max-w-full object-contain filter drop-shadow group-hover:scale-105 transition-transform">
      </div>
    </a>
  </div>

  <nav class="flex-1 px-3 py-4 space-y-6">
    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Paneli</p>
      <div class="space-y-1">
        <a href="/paneli" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath === '/paneli' || currentPath === '/menaxheri') %>">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          <span>Paneli Kryesor</span>
        </a>
      </div>
    </div>

    <% if (isAdmin || isSales || isFinance || isManager) { %>
    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">1. Furnizimi</p>
      <div class="space-y-1">
        <a href="/lifts/katalogu" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath === '/lifts' || currentPath === '/lifts/katalogu' || currentPath.startsWith('/lifts/konfiguruesi')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span>Katalogu i Lifteve</span>
        </a>
        <a href="/klientet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/klientet')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span>Klientët & Kontaktet</span>
        </a>
        <a href="/ofertat" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/ofertat')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>Ofertat</span>
        </a>
        <a href="/kontratat" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/kontratat')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          <span>Kontratat</span>
        </a>
        <% if (isAdmin || isFinance) { %>
        <a href="/faturat" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/faturat')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Faturat</span>
        </a>
        <a href="/pagesat" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/pagesat')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          <span>Pagesat</span>
        </a>
        <a href="/shpenzimet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/shpenzimet')) %>">
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span>Shpenzimet</span>
        </a>
        <% } %>
        <% if (isAdmin) { %>
        <a href="/pjeset-rezerve" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/pjeset-rezerve')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span>Produktet/Shërbimet</span>
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (isAdmin || isManager || isTech) { %>
    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">2. Instalimi</p>
      <div class="space-y-1">
        <a href="/instalimet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/instalimet') || (currentPath.startsWith('/projektet') && !currentPath.includes('Modernizim')) || currentPath.startsWith('/dorezimi')) %>">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <span>Qendra e Instalimeve</span>
        </a>
        <a href="/intervenimet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= currentPath.startsWith('/intervenimet') ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30' : 'text-slate-300 hover:bg-slate-800 hover:text-slate-100' %>">
          <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
          <span>Intervenimet në Terren</span>
        </a>
      </div>
    </div>
    <% } %>

    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">3. Servisi / Mirëmbajtja</p>
      <div class="space-y-1">
        <a href="/servisi-mirembajtja" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/servisi-mirembajtja')) %>">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span class="font-semibold text-emerald-300">Qendra e Servisit</span>
        </a>
        <a href="/servisi" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/servisi') && !currentPath.startsWith('/servisi-mirembajtja')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Kërkesat për Servis</span>
        </a>
        <a href="/mirembajtja" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/mirembajtja')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Kontratat e Mirëmbajtjes</span>
        </a>

      </div>
    </div>

    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">4. Modernizimi</p>
      <div class="space-y-1">
        <a href="/modernizimi" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/modernizimi')) %>">
          <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Projektet e Modernizimit</span>
        </a>
        <% if (!isTech) { %>
        <a href="/projektet/krijo?line=Modernizim" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/projektet/krijo')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Hap Modernizim të Ri</span>
        </a>
        <% } %>
      </div>
    </div>

    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
        <%= isManager ? 'Ekipi & Prezenca' : 'Puntorët & Prezenca' %>
      </p>
      <div class="space-y-1">
        <a href="/prezenca" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/prezenca')) %>">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Orari & Prezenca (Live)</span>
        </a>
        <% if (isAdmin || isManager || isFinance) { %>
        <a href="/puntoret" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath === '/puntoret' || (currentPath.startsWith('/puntoret/') && !currentPath.includes('kesh-bonuse'))) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span><%= isManager ? 'Ekipi Im & Puntorët' : 'Puntorët & Stafi' %></span>
        </a>
        <a href="/puntoret/financat/kesh-bonuse" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.includes('kesh-bonuse')) %>">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= isManager ? 'Kesh & Bonuset e Ekipit' : 'Kesh & Bonuset e Stafit' %></span>
        </a>
        <% } %>
        <a href="/dokumentet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/dokumentet')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20"/></svg>
          <span>Dokumentet</span>
        </a>
      </div>
    </div>

    <% if (isManager || isTech) { %>
    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Llogaria</p>
      <div class="space-y-1">
        <a href="/cilesimet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/cilesimet')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Cilësimet e mia</span>
        </a>
      </div>
    </div>
    <% } %>

    <% if (isAdmin || isFinance || isSales) { %>
    <div>
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Administrimi</p>
      <div class="space-y-1">
        <a href="/raportet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/raportet')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <span>Raportet Analitike</span>
        </a>
        <% if (isAdmin) { %>
        <a href="/cilesimet" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors <%= navCls(currentPath.startsWith('/cilesimet')) %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Cilësimet & Përdoruesit</span>
        </a>
        <% } %>
      </div>
    </div>
    <% } %>

  </nav>

  <div class="p-3 border-t border-slate-800 bg-slate-900/60">
    <div class="flex items-center justify-between p-2 rounded-lg bg-slate-800/60">
      <div class="flex items-center gap-2.5 overflow-hidden">
        <div class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-300 font-bold flex items-center justify-center text-xs flex-shrink-0">
          <%= currentUser ? currentUser.fullName.charAt(0) : 'A' %>
        </div>
        <div class="truncate">
          <p class="text-xs font-semibold text-slate-200 truncate"><%= currentUser ? currentUser.fullName : 'Admin' %></p>
          <span class="text-[10px] text-amber-400 font-mono font-medium tracking-wide"><%= currentUser ? currentUser.role : 'ADMIN' %></span>
        </div>
      </div>
      <a href="/dil" title="Çkyçu" class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-700 rounded-md transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</aside>
