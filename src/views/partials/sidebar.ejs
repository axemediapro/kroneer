<aside id="main-sidebar" class="drawer fixed inset-y-0 left-0 z-50 w-[19rem] max-w-[86vw] flex flex-col -translate-x-full lg:hidden overflow-y-auto transition-transform duration-200 ease-out">
  <div class="p-4 flex items-center justify-between border-b border-white/5">
    <% const drawerLogo = (company && company.logoDarkBgUrl) ? company.logoDarkBgUrl : ((company && company.logoUrl) ? company.logoUrl : '/images/kroneer-logo-white.svg'); %>
    <img src="<%= drawerLogo %>" alt="KRONEER" class="h-7 w-auto max-w-[150px] object-contain">
    <span class="text-[11px] text-amber-400 tracking-wide"><%= currentUser ? currentUser.role : '' %></span>
  </div>
  <nav class="flex-1 p-3 space-y-5">
    <a href="/paneli" class="menu-item <%= (currentPath === '/paneli' || currentPath === '/menaxheri') ? 'is-active' : '' %>"><i data-lucide="layout-dashboard" class="w-4 h-4"></i><span>Paneli Kryesor</span></a>
    <% navGroups.forEach(g => { %>
    <div>
      <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-[.14em] text-slate-500"><%= g.title %></p>
      <% g.items.forEach(i => { const on = i.match.some(m => currentPath === m || currentPath.startsWith(m.endsWith('/') ? m : m + '/')); %>
      <a href="<%= i.href %>" class="menu-item <%= on ? 'is-active' : '' %>"><i data-lucide="<%= i.icon %>" class="w-4 h-4"></i><span><%= i.label %></span></a>
      <% }); %>
    </div>
    <% }); %>
  </nav>
  <div class="p-3 border-t border-white/5">
    <div class="flex items-center justify-between rounded-xl bg-white/[.04] p-2.5">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="avatar-btn !w-8 !h-8 !text-xs"><%= currentUser && currentUser.fullName ? currentUser.fullName.charAt(0).toUpperCase() : 'A' %></div>
        <p class="text-xs font-semibold text-slate-200 truncate"><%= currentUser ? currentUser.fullName : 'Admin' %></p>
      </div>
      <a href="/dil" class="icon-btn" title="Çkyçu"><i data-lucide="log-out" class="w-4 h-4"></i></a>
    </div>
  </div>
</aside>