<!-- MODAL: Shto Klient të Ri (i shpejtë) - Individ ose Biznes Privat -->
<div x-show="isOpen" x-cloak class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div @click.outside="closeModal()" class="w-full max-w-lg max-h-[90vh] overflow-y-auto bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 rounded-2xl shadow-2xl my-8">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 sticky top-0 bg-white dark:bg-slate-900 z-10">
      <h3 class="text-sm font-bold text-amber-500 dark:text-amber-400 uppercase tracking-wider">Shto Klient të Ri</h3>
      <button type="button" @click="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm">✕</button>
    </div>

    <div class="p-6 space-y-4 text-xs">
      <p x-show="error" x-text="error" x-cloak class="px-3 py-2 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-500 dark:text-rose-300 font-semibold"></p>

      <!-- Zgjedhja: Individ ose Biznes Privat -->
      <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 dark:bg-slate-950 rounded-xl border border-slate-200 dark:border-slate-800">
        <button type="button" @click="form.kind = 'individ'" :class="form.kind === 'individ' ? 'bg-amber-500 text-slate-950 shadow-md' : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200'" class="py-2 rounded-lg font-bold text-xs transition-all">
          Individ
        </button>
        <button type="button" @click="form.kind = 'biznes'" :class="form.kind === 'biznes' ? 'bg-amber-500 text-slate-950 shadow-md' : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200'" class="py-2 rounded-lg font-bold text-xs transition-all">
          Biznes Privat
        </button>
      </div>

      <!-- Fushat për Individ -->
      <template x-if="form.kind === 'individ'">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Emri *</label>
            <input type="text" x-model="form.firstName" placeholder="Emri" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Mbiemri *</label>
            <input type="text" x-model="form.lastName" placeholder="Mbiemri" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
          <div class="col-span-2">
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Numri Personal / ID</label>
            <input type="text" x-model="form.taxNumber" placeholder="p.sh. 1023456789" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
        </div>
      </template>

      <!-- Fushat për Biznes Privat -->
      <template x-if="form.kind === 'biznes'">
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Emri i Kompanisë / Subjektit *</label>
            <input type="text" x-model="form.companyName" placeholder="p.sh. Albi Group Sh.p.k." class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Personi Kontaktues</label>
            <input type="text" x-model="form.contactPerson" placeholder="p.sh. Filan Fisteku" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Numri Fiskal (NUI)</label>
            <input type="text" x-model="form.taxNumber" placeholder="p.sh. 330198234" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
          <div class="col-span-2">
            <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Numri i Biznesit</label>
            <input type="text" x-model="form.businessNumber" placeholder="p.sh. 81029384" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          </div>
        </div>
      </template>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Telefoni<span x-show="form.kind === 'individ'"> *</span></label>
          <input type="text" x-model="form.phone" placeholder="+383 44 123 456" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
        </div>
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Email</label>
          <input type="email" x-model="form.email" placeholder="info@kompania.com" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block font-semibold text-slate-600 dark:text-slate-300">Adresa</label>
          <button type="button" @click="locate()" :disabled="locating" class="text-[11px] font-bold text-amber-500 hover:text-amber-400 disabled:opacity-60">
            <span x-text="locating ? 'Duke gjetur vendndodhjen...' : '📍 Përdor vendndodhjen time'"></span>
          </button>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <input type="text" x-model="form.address" placeholder="Rruga, Numri" class="col-span-2 w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
          <select x-model="form.country" @change="onCountryChange()" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
            <template x-for="c in countries()" :key="c"><option :value="c" x-text="c"></option></template>
          </select>
          <select x-model="form.city" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
            <option value="">-- Qyteti --</option>
            <template x-for="c in cities()" :key="c"><option :value="c" x-text="c" :selected="c === form.city"></option></template>
          </select>
        </div>
        <p x-show="geoError" x-cloak x-text="geoError" class="mt-1 text-[11px] text-rose-500"></p>
      </div>

      <!-- Grupi i Zbritjes -->
      <div>
        <label class="block font-semibold text-slate-600 dark:text-slate-300 mb-1">Grupi i Zbritjes</label>
        <div class="grid grid-cols-2 gap-4">
          <select x-model="form.discountGroup" @change="applyDiscountGroup()" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
            <template x-for="g in discountGroups" :key="g.name">
              <option :value="g.name" x-text="g.name + ' (' + g.percent + '%)'"></option>
            </template>
          </select>
          <div class="relative">
            <input type="number" x-model.number="form.discountPercent" min="0" max="100" step="0.5" class="w-full px-3.5 py-2.5 pr-8 bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 focus:outline-none focus:border-amber-400">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold">%</span>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-200 dark:border-slate-800 sticky bottom-0 bg-white dark:bg-slate-900">
      <button type="button" @click="closeModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition-all">
        Anulo
      </button>
      <button type="button" @click="saveCustomer()" :disabled="saving" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all disabled:opacity-60">
        <span x-show="!saving">Ruaj Klientin</span>
        <span x-show="saving" x-cloak>Duke ruajtur...</span>
      </button>
    </div>
  </div>
</div>


