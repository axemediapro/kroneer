<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Qendra e Dokumenteve</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Arkiva qendrore e kontratave, certifikatave CE, vizatimeve teknike dhe raporteve</p>
    </div>
    <% if (typeof canManage !== 'undefined' && canManage) { %>
    <a href="/dokumentet/krijo" class="inline-flex items-center px-4 py-2.5 bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 text-white text-sm font-semibold rounded-lg shadow-sm transition">
      <i data-lucide="upload-cloud" class="w-4 h-4 mr-2"></i>
      Ngarko / Regjistro Dokument
    </a>
    <% } else { %>
    <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-800 text-slate-300 border border-slate-700">Vetëm lexim — pa ndryshime</span>
    <% } %>
  </div>

  <!-- Filters -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
    <form action="/dokumentet" method="GET" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Lloji i Dokumentit</label>
        <select name="type" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-white focus:outline-none">
          <option value="">Të gjithë llojet</option>
          <% types.forEach(t => { %>
            <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Kërko Dokument</label>
        <div class="relative">
          <input type="text" name="search" value="<%= filters.search %>" placeholder="Titulli, klienti, projekti..." class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-sm text-slate-900 dark:text-white focus:outline-none">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
        </div>
      </div>

      <div class="flex items-end space-x-2">
        <button type="submit" class="w-full py-2 px-4 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white text-sm font-semibold rounded-lg transition">
          Filtro
        </button>
        <% if (filters.type || filters.search) { %>
          <a href="/dokumentet" class="py-2 px-3 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold rounded-lg hover:bg-slate-300 transition">
            Pastro
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Documents Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (documents.length === 0) { %>
      <div class="col-span-full bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-12 text-center">
        <i data-lucide="folder-x" class="w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Nuk u gjet asnjë dokument</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Nuk ka dokumente që përputhen me filtrat e zgjedhur.</p>
      </div>
    <% } else { %>
      <% documents.forEach(doc => { %>
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm hover:border-amber-400 transition flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-2 mb-3">
              <span class="px-2.5 py-1 text-xs font-semibold rounded bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50">
                <%= doc.documentType %>
              </span>
              <span class="text-xs font-mono text-slate-400">
                <%= doc.fileSize || 'PDF' %>
              </span>
            </div>

            <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
              <%= doc.title %>
            </h3>

            <div class="mt-3 space-y-1 text-xs text-slate-500">
              <% if (doc.customer) { %>
                <div class="flex items-center">
                  <i data-lucide="user" class="w-3.5 h-3.5 mr-1.5 text-slate-400"></i>
                  Klienti: <a href="/klientet/<%= doc.customerId %>" class="ml-1 text-slate-700 dark:text-slate-300 hover:text-amber-600"><%= doc.customer.companyName %></a>
                </div>
              <% } %>
              <% if (doc.project) { %>
                <div class="flex items-center">
                  <i data-lucide="folder" class="w-3.5 h-3.5 mr-1.5 text-slate-400"></i>
                  Projekti: <a href="/projektet/<%= doc.projectId %>" class="ml-1 text-slate-700 dark:text-slate-300 hover:text-amber-600"><%= doc.project.name %></a>
                </div>
              <% } %>
              <div class="flex items-center">
                <i data-lucide="calendar" class="w-3.5 h-3.5 mr-1.5 text-slate-400"></i>
                Data: <%= new Date(doc.createdAt).toLocaleDateString('sq-AL') %>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-400"><%= doc.fileType || 'PDF' %></span>
            <a href="<%= doc.fileUrl || '#' %>" target="_blank" class="px-3 py-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 hover:bg-amber-100 rounded-lg transition flex items-center">
              <i data-lucide="download" class="w-3.5 h-3.5 mr-1.5"></i> Shkarko / Shiko
            </a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>
