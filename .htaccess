# ==============================================================================
# KRONEER ENTERPRISE SECURITY & PROXY CONFIGURATION (.htaccess)
# ==============================================================================

# 1. Blloko shfletimin e direktoriumeve (Prevent Directory Indexing)
Options -Indexes -MultiViews
ServerSignature Off

# 2. Mbrojtje e rreptë për skedarët sensitivë dhe të sistemit
<FilesMatch "(^\.env|\.git|\.gitignore|schema\.prisma|\.db|\.sqlite|\.log|package(-lock)?\.json|tsconfig\.json|\.md|\.sh|\.sql|\.ps1|\.bak|\.backup|\.safety-backup|nginx\.conf|^ecosystem\.config\.js|^server\.js|^db\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blloko qasjen direkte në dosjet e burimit (Source Code Directories)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blloko qasjen direkte në src/, prisma/, node_modules/, config/
    RewriteRule ^(src|prisma|node_modules|config|logs)/ - [F,L,NC]

    # Blloko skedarët e konfigurimit në rrënjë
    RewriteRule ^(server\.js|db\.js|ecosystem\.config\.js|nginx\.conf|dev-local\.ps1|package(-lock)?\.json)$ - [F,L,NC]

    # Blloko skedarët e fshehur (.dotfiles)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Blloko metodat HTTP të rrezikshme
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG) [NC]
    RewriteRule .* - [F,L]

    # Blloko skedarët e ekzekutueshëm në uploads
    RewriteRule ^uploads/.*\.(php\d?|phtml|pl|py|cgi|sh|exe|js|html?|htaccess)$ - [F,L,NC]

    # Blloko sulmet e zakonshme (Path Traversal, Null Byte Injection, XSS)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%00|<script|eval\(|base64_) [NC]
    RewriteRule .* - [F,L]

    # 4. HTTPS Enforcing (nëse serveri ka certifikatë SSL)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 5. Reverse Proxy për Node.js / Express Server (Port 3000)
    <IfModule mod_proxy.c>
        # Mos kalo asetet statike te Node nëse menaxhohen direkt nga Apache
        RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
        RewriteCond %{REQUEST_URI} !^/css/ [NC]
        RewriteCond %{REQUEST_URI} !^/js/ [NC]
        RewriteCond %{REQUEST_URI} !^/images/ [NC]
        RewriteCond %{REQUEST_URI} !^/favicon.ico$ [NC]
        RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
        ProxyPassReverse / http://127.0.0.1:3000/
    </IfModule>
</IfModule>

# 6. HTTP Security Headers
<IfModule mod_headers.c>
    # Mbrojtje nga Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Mbrojtje nga MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Aktivizo filtrin XSS të shfletuesit
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy e sigurt
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (Fik sensorët e panevojshëm)
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    
    # Detyro HTTPS (HSTS) për 1 vit
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Izolim nga dritaret/burimet e tjera cross-origin
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # Fshih nënshkrimin e serverit
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# 7. Kompresim GZIP / Brotli për performancë maksimale
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
