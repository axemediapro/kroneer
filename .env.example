PORT=3000
NODE_ENV=development
SESSION_SECRET=kroneer_super_secret_session_key_2026_lifts

# Supabase Database (PostgreSQL)
# DATABASE_URL: Pooler connection string (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection string for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API keys (Automatically provided by Hostinger / Supabase dashboard)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_API_KEY="your-anon-or-service-role-key"
SEED_ADMIN_PASSWORD=
