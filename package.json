{
  "name": "kroneer-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate && npm run build:css",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "seed": "node prisma/seed.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "hono": "^4.6.14",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17"
  }
}
